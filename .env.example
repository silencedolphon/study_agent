# ============================================================================
#  study_agent 环境变量样例（卡 C-0059）
# ----------------------------------------------------------------------------
#  用法：复制成 `.env` 放在项目根目录，再把下面的占位符换成你自己的值。
#        `.env` 已被 .gitignore 忽略，**不会**被提交到 GitHub。
#
#  ⚠ 这里**一个真实密钥都不要写**——本文件是要提交进仓库的。
#
#  两种配置方式，任选其一（也可以混用）：
#    A. 直接编辑这个 `.env`（改完要重启看板才生效）；
#    B. 打开看板 → 右上角「⚙ 设置」→ 在弹出的窗口里填。这条路的改动会写进
#       `config.local.json`（同样被 .gitignore 忽略），而且**保存即生效、不用重启**。
#       两者同时存在时，**设置窗口（config.local.json）优先于 .env**。
#
#  最省事的起步：只填一个 DEEPSEEK_API_KEY，其余全部留空用默认值。
# ============================================================================

# ---------------------------------------------------------------------------
# 1) 大模型密钥 / 端点（四条管线共用一把也可以，各配各的也行）
# ---------------------------------------------------------------------------
# 【必填】DeepSeek API 密钥。没有它，问答 / 整理 / 识图 三条管线都跑不起来。
# 也可以不写在这里，而是放进 ~/.dsh/.credentials.yaml（见 README「首次配置」）。
DEEPSEEK_API_KEY=sk-REPLACE_ME

# 端点根地址（兼容 OpenAI 协议，不带 /chat/completions）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 每条管线各自的密钥/端点（**不填就跟随上面的 DEEPSEEK_API_KEY / BASE_URL**；
# 需要各配各的时，把下面几行的注释去掉再填值）：
#   CHAT_API_KEY / CHAT_BASE_URL            AI 问答
#   KP_BUILD_API_KEY / KP_BUILD_BASE_URL    AI 知识点总结
#   DECK_CHAT_API_KEY / DECK_CHAT_BASE_URL  每份课件的 AI 答疑（真·独立的一把）
#   入库识图与结构分析直接用 DEEPSEEK_API_KEY / DEEPSEEK_BASE_URL
# CHAT_API_KEY=
# CHAT_BASE_URL=
# KP_BUILD_API_KEY=
# KP_BUILD_BASE_URL=
# DECK_CHAT_API_KEY=
# DECK_CHAT_BASE_URL=

# ---------------------------------------------------------------------------
# 2) 模型名（默认都用 deepseek-flash；只有它支持视觉/识图）
# ---------------------------------------------------------------------------
CHAT_MODEL=deepseek-flash
KP_BUILD_MODEL=deepseek-flash
INGEST_MODEL=deepseek-flash
DEEPSEEK_VISION_MODEL=deepseek-flash
DECK_CHAT_MODEL=deepseek-flash

# ---------------------------------------------------------------------------
# 3) 开关与推理强度（1 开 / 0 关；强度取 none / low / high / max）
# ---------------------------------------------------------------------------
FIGURE_DESC=1                 # 入库是否整页识图（关掉最省钱：不渲染、不调视觉模型）
FIGURE_THINKING=1             # 识图是否开推理
FIGURE_REASONING_EFFORT=high  # 识图推理强度
OUTLINE_ANALYSIS=1            # 入库是否让模型看完整份课件、画出结构
OUTLINE_THINKING=1            # 结构分析是否开推理
CHAT_THINKING=0               # 问答是否开推理（默认关：问答要的是快与有据）
CHAT_REASONING_EFFORT=high
CHAT_FIGURES=1                # 问答是否把「识图（图注）」当作证据
KP_BUILD_THINKING=1
KP_BUILD_REASONING_EFFORT=max
DECK_CHAT_THINKING=1
DECK_CHAT_REASONING_EFFORT=max
DECK_CHAT_FIGURES=1           # 课件答疑是否把页图描述送进上下文

# ---------------------------------------------------------------------------
# 4) 路径（一般不用改）
# ---------------------------------------------------------------------------
# KB_RAW=raw
# KB_NOTES=notes
# KB_INDEX=index
# KB_DB=index/study.db
# KB_LOG=logs
# EMBED_MODEL_DIR=models/bge-small-zh-v1.5

# 本地嵌入模型从哪儿下载（首次会自动下载约 100MB）
MODELSCOPE_ENDPOINT=https://www.modelscope.cn
EMBED_MODEL_REPO=Xenova/bge-small-zh-v1.5
