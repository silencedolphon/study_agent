def estimate_v2(doc_id: int, *, prompt_path=None, struct_prompt_path=None,
                db_path=None) -> dict:
    """dry-run（v3）：只读库里的**文本**，给出结构调用次数、知识点条数区间与**上界**成本。

    口径（**上界**，不是承诺；看板不许把它当报价）：
      - **结构调用** = 段数 + (1 if 段数 > 1 else 0)。段数按"每段 ≤STRUCT_SEG_PAGES 页
        且 ≤STRUCT_SEG_CHARS 字符"双阈值切出来，与大课件的页数无关地有上界；
        只有一段时本地合成根节点，**不再调模型**。
      - **知识点条数**（卡 C-0052 改口径）：一条 = 一个结构叶节点，**页数不限**。
        所以下界 = `ceil(全份材料字符 / KP_MATERIAL_CHARS_MAX)`（最省的情况：整份塞进
        尽可能少的叶节点），上界 = `N`（一页一条，最碎的情况）。真实条数由结构树决定。
      - **成本**按**上界**（一页一条）算，并且**含思考 token**：思维链 token ≈ 该次
        输入 token 的 `REASON_RATIO` 倍（实测 1.19，上界取 1.5），再加正文输出。

    返回的键与 v1 `estimate_v1()` 保持同名（看板的预估面板直接复用），
    语义按 v2/v3 口径解释并在 `est_rule` 里写明；`outline_ignored=True` 表示
    这次预估**没有读** `logs/outline/<doc_id>.json`。
    """
    kp_prompt = load_kp_prompts_v2(prompt_path)
    st_prompt = load_struct_prompts(struct_prompt_path)
    ch = read_text_pages(doc_id, db_path)
    if not ch["pages_all"]:
        return {"doc_id": int(doc_id), "ok": False,
                "error": "这份课件在库里没有任何块（chunks 为空），没有文本可整理"}
    pages_all = ch["pages_all"]
    segs = plan_structure_segments(ch)
    struct_calls = len(segs) + (1 if len(segs) > 1 else 0)

    per_page = []
    for p in pages_all:
        bs = ch["blocks"].get(p) or []
        per_page.append({"page": p, "role": "leaf",
                         "chars": sum(b["chars"] for b in bs),
                         "n_body": sum(1 for b in bs if b["kind"] != "图片理解"),
                         "n_fig": sum(1 for b in bs if b["kind"] == "图片理解")})
    mat_chars = sum(x["chars"] for x in per_page)
    n = len(pages_all)
    kp_min = max(1, (mat_chars + KP_MATERIAL_CHARS_MAX - 1) // KP_MATERIAL_CHARS_MAX)
    kp_max = n
    # 上界成本：结构（段材料按每页截断后的字符算）+ 知识点（每页一条、每条一页材料）
    # 思考模式下思维链也算 completion token，所以 est_out 不是"正文 350"那么小。
    seg_chars = sum(s["chars"] for s in segs)
    seg_in_tok = int((st_prompt["chars"] * len(segs) + seg_chars) / CHARS_PER_TOKEN)
    merge_in_tok = int((st_prompt["chars"] + 2500) / CHARS_PER_TOKEN)
    kp_in_tok = int((kp_prompt["chars"] * kp_max + mat_chars) / CHARS_PER_TOKEN)
    est_in = seg_in_tok + merge_in_tok + kp_in_tok
    est_out = (int(seg_in_tok * REASON_RATIO) + 1200 * len(segs)
               + int(merge_in_tok * REASON_RATIO) + 1500
               + int(kp_in_tok * REASON_RATIO) + 450 * kp_max)
    est_cost = round(est_in / 1e6 * PRICE_IN * FX + est_out / 1e6 * PRICE_OUT * FX, 6)

    out = out_file(doc_id)
    prev = _load_prev(out)
    prev_meta = prev.get("meta") if isinstance(prev.get("meta"), dict) else {}
    prev_prompts = prev_meta.get("prompts") if isinstance(prev_meta.get("prompts"), dict) else {}
    prev_struct = prev.get("structure") if isinstance(prev.get("structure"), dict) else {}
    is_v2 = str(prev_meta.get("pipeline_version") or "") == PIPELINE_VERSION
    # 「计划条数」的口径（这个数字要能被 `core/kp_batch.py::done_state` 用来判"已完成"，
    # 所以必须与产物 `meta.kp_total` 同口径）：
