                       max_tokens=mt2, retry=0, log=log,
                       note="筛选 %d 个候选名词（max_tokens 加倍到 %d）"
                            % (len(terms), mt2), run_no=run_no)
    if not res["ok"]:
        return {"terms": terms, "filter": "fallback",
                "kept": [t["term"] for t in terms], "dropped": [],
                "note": "筛选调用失败（%s），保留全部候选名词" % res["error"]}
    keep_raw = res["parsed"].get("keep")
    if keep_raw is None:
