    三步（每一步都留痕，绝不静默）：
      1. **叶节点先到先得**占页；一页被两个叶节点声明 → 后来的记 `conflicts`；
      2. 谁都没声明的页（含空页）→ 归给**声明了它之前最近页的那个叶节点**，
         逐页记 `filled`（附原因）；
      3. 一个叶节点都没有（模型输出跑偏）→ 退化成"整份一个节点"，记 `fallback`。

    返回 {root, nodes, page_owner, node_pages, conflicts, filled, fallback,
          n_nodes, n_leaves, max_level}。
    """
    clean = _clean_section(root) if root else None
    fallback = None
    if clean is None or (not clean.get("children") and not clean.get("pages")):
        fallback = {"reason": "结构模型没有给出可用的树（没有节点 / 没有叶节点页码），"
                              "退化为单节点结构：整份课件一个节点",
                    "node_name": deck or "整份课件"}
        clean = {"name": (deck or "整份课件")[:24], "children": [], "pages": list(pages_all)}
    # 根节点若有 children 却没有叶节点页码（模型把 pages 全给了父节点）→ 也退化
    leaves_tmp = [n for n in _flat_nodes(clean) if not n["children_ids"]]
    if not any(n["pages"] for n in leaves_tmp):
        fallback = {"reason": "结构模型给的叶节点一个页码都没写，退化为单节点结构："
                              "整份课件一个节点",
                    "node_name": (deck or "整份课件")[:24]}
        clean = {"name": (deck or "整份课件")[:24], "children": [], "pages": list(pages_all)}

    nodes = _flat_nodes(clean)
    leaves = [n for n in nodes if not n["children_ids"]]
    known = set(int(x) for x in pages_all)

    owner: dict = {}
    conflicts: list = []
    for nd in leaves:
        for p in nd["pages"]:
            if p not in known:
                conflicts.append({"page": p, "kept": "", "dropped": nd["id"],
                                  "reason": "页码越出 1~%d，已丢弃" % (max(known) if known else 0)})
                continue
            if p in owner:
                conflicts.append({"page": p, "kept": owner[p], "dropped": nd["id"],
                                  "reason": "同一页被多个叶节点声明，保留先声明的那个"})
                continue
            owner[p] = nd["id"]
    filled: list = []
    for p in sorted(known):
        if p in owner:
            continue
        prev_pages = [q for q in owner if q < p]
        nxt_pages = [q for q in owner if q > p]
        if prev_pages:
            nid = owner[max(prev_pages)]
            why = "结构模型没把这一页放进任何叶节点；归给它前面最近的已归属页 p.%d 所在的节点" % max(prev_pages)
        elif nxt_pages:
            nid = owner[min(nxt_pages)]
            why = "结构模型没把这一页放进任何叶节点；归给它后面最近的已归属页 p.%d 所在的节点" % min(nxt_pages)
        else:
            nid = leaves[0]["id"]
            why = "整份结构里没有任何叶节点页码；归给第一个叶节点"
        owner[p] = nid
        filled.append({"page": p, "node_id": nid, "reason": why})

    node_pages: dict = {}
