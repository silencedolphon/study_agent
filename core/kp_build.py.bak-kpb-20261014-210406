def _coverage_block(est: dict, recs: list) -> dict:
    """覆盖审计（卡 C-0045）：全部页 → **唯一**知识点 id，重复收录必须为 0。

    为什么单列一节：下放之后"某一页被谁收录"不再自明（父节点页归子条目），
    光看 `pages_covered` 看不出有没有一页被两条各写了一遍。`overlap_pages`
    是这个改法的机器判据，也是"避免重复计数"这条要求的落地。
    """
    owner_est = {int(k): int(v) for k, v in (est.get("page_owner") or {}).items()}
    seen: dict = {}
    overlap: list = []
    for r in recs:
        rid = r.get("id")
        for p in (r.get("pages") or []):
            try:
                n = int(p)
            except (TypeError, ValueError):
                continue
            if n in seen and seen[n] != rid:
                overlap.append(n)
            seen[n] = rid
    pages_all = sorted(owner_est) or sorted(seen)
    unclaimed = est.get("window_unclaimed") or []
    return {
        # C-0045：父节点页下放的**覆盖审计**与**父节点概括索引**
        "coverage": _coverage_block(est, recs),
        # C-0048：丢页留痕的顶层快捷入口（看板/人不必翻进 coverage 才看得到）。
        # **旧产物没有这两个字段**，读的一律按"空数组"处理，渲染不受影响。
        "unclaimed_pages": est.get("window_unclaimed") or [],
        "excluded_unplaced_pages": est.get("handoff_unplaced") or [],
        "parent_nodes": _parent_nodes(est, recs),
        # 合并决策汇总（哪些页合并了、哪些没合并）——明细在顶层 merge_decisions
        "merge_summary": {
            "max_merge_pages": MAX_MERGE,
            "n_kps": len(recs),
            "n_merged_kps": len(merged),
