def _split_runs(ps: list) -> list:
    """把升序页号切成若干**连续段**：`[1,2,3,7,8]` → `[[1,2,3],[7,8]]`。"""
    runs, cur = [], []
    for p in ps:
        if cur and p != cur[-1] + 1:
            runs.append(cur)
            cur = []
        cur.append(p)
    if cur:
        runs.append(cur)
    return runs


