def default_prompt_file() -> Path:
    own = config.LOG_DIR / "knowledge" / _PROMPT_NAME
    if own.exists():
        return own
    root = config.ROOT / "logs" / "knowledge" / _PROMPT_NAME
    if root.exists():
        return root
    # 卡 C-0073（exe 路线）：打包后随包分发的真源在**解包目录**里
    # （`sys._MEIPASS`，一目录形态是 `<exe目录>\_internal`），这一级是保底——
