        if root:
            merged_by, note = "model", "归并调用成功（%d 段 → 一棵树）" % len(drafts)
        else:
            kids = [s for d in drafts for s in d["sections"]]
            root = {"name": deck[:24],
                    "children": kids or [{"name": "内容", "children": [],
                                          "pages": list(pages_all)}]}
            merged_by = "fallback"
            note = ("归并调用未给出可用树（%s），退化为：课件名 + 各段章节并列"
