def estimate_terms(doc_id: int, *, prompt_path=None, out_path=None,
                   db_path=None) -> dict:
    """dry-run：只读库里的文本，给出段数、调用次数与**上界**成本（不调模型、不写文件）。"""
    prompt = load_terms_prompts(prompt_path)
    ch = read_text_pages(doc_id, db_path)
    if not ch["pages_all"]:
        return {"doc_id": int(doc_id), "ok": False,
                "error": "这份课件在库里没有任何块（chunks 为空），没有文本可提炼"}
    segs = plan_terms_segments(ch)
    seg_chars = sum(s["chars"] for s in segs)
    n_pages = len(ch["pages_all"])
    # 上界：提炼 = 段数次；筛选 = 1 次（输入是去重后的清单，按每段 8 个名词估）
    est_in = int((prompt["chars"] * len(segs) + seg_chars) / CHARS_PER_TOKEN)
    est_out = int(est_in * REASON_RATIO) + 500 * len(segs)
    filt_in = int((len(prompt["terms_sys"]) + len(prompt["terms_user"])
                   + 80 * 8 * len(segs)) / CHARS_PER_TOKEN)
    filt_out = int(filt_in * REASON_RATIO) + 400
    est_in += filt_in
    est_out += filt_out
    est_cost = round(est_in / 1e6 * PRICE_IN * FX + est_out / 1e6 * PRICE_OUT * FX, 6)
    out = terms_out_file(doc_id, out_path)
    prev = _load_prev(out)
    prev_meta = prev.get("meta") if isinstance(prev.get("meta"), dict) else {}
    return {
        "doc_id": int(doc_id), "ok": True, "pipeline_version": TERMS_VERSION,
        "title": doc_title_v2(doc_id, db_path), "deck": doc_title_v2(doc_id, db_path),
        "n_pages": n_pages, "pages_all": list(ch["pages_all"]),
        "max_page": ch["max_page"], "n_blocks": ch["n_blocks"],
        "material_chars_total": sum(len(_terms_page_text(p, ch)) for p in ch["pages_all"]),
        "segments": [{"index": s["index"], "a": s["a"], "b": s["b"],
                      "n_pages": len(s["pages"]), "chars": s["chars"]} for s in segs],
        "n_segments": len(segs), "seg_pages": TERMS_SEG_PAGES,
        "seg_chars": TERMS_SEG_CHARS, "page_chars": TERMS_PAGE_CHARS,
        "thinking": THINKING_V2, "reasoning_effort": REASONING_EFFORT,
        "max_tokens": TERMS_MAX_TOKENS,
        "est_calls": len(segs) + 1,
        "est_calls_breakdown": {"extract": len(segs), "filter": 1},
        输入 token 的 `REASON_RATIO` 倍（实测 1.19，上界取 1.5），再加正文输出。

    返回的键与 v1 `estimate_v1()` 保持同名（看板的预估面板直接复用），
    语义按 v2/v3 口径解释并在 `est_rule` 里写明；`outline_ignored=True` 表示
    这次预估**没有读** `logs/outline/<doc_id>.json`。
    """
    kp_prompt = load_kp_prompts_v2(prompt_path)
        "exists": out.exists(),
        "prev": {"pipeline_version": str(prev_meta.get("pipeline_version") or ""),
                 "n_terms": len([t for t in (prev.get("terms") or [])
                                 if isinstance(t, dict)]),
                 "generated_at": str(prev_meta.get("generated_at") or ""),
                 "cost_cny": float(prev_meta.get("cost_cny") or 0.0)},
        "outline_ignored": True,
    }


