// 「清除」（卡 C-0050，人拍板）：把选中课件的整理产物（思维导图结构 + 理解 +
// 要点）与备份删掉，让它们回到"未整理"——**必须重新整理才能重建**。
// 两道闸门：这里的 window.confirm + 后端的 confirm=true。不可逆的操作只靠前端
// 一个对话框把关是不够的（接口能被直接调用）。
// 只删 logs/knowledge/<doc_id>-末级知识点总结.json 与它的 .bak-*：
// logs/outline/ 与数据库任何一张表都不动（后端 `api_kp_clear` 里逐条校验）。
async function kpbClear(){
  const sel = kpbSelDocs();
  if (!sel.length){ toast('请先勾选至少一份课件'); return; }
  const ids = sel.map(x => x.doc_id);
  const lines = sel.slice(0, 8).map(x => '· ' + x.title).join('\n');
  const more = sel.length > 8 ? `\n… 另有 ${sel.length - 8} 份` : '';
  const ok = window.confirm(
    `将清除这 ${sel.length} 份课件的整理产物（思维导图结构 + 理解 + 要点）及其备份：\n` +
    lines + more + '\n\n' +
    '⚠ 此操作不可逆：清除后页签回到"未整理"，必须重新整理才能重建。\n' +
    '不会动 logs/outline/（入库结构），也不会写数据库任何一张表。\n\n确定清除？');
  if (!ok) return;                       // 二次确认：点"取消"就什么都不做
  const btn = $('#kpb-clear');
  if (btn){ btn.disabled = true; btn.textContent = '清除中…'; }
  try {
    const r = await api('/api/kp-build/clear', {method:'POST',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify({doc_ids: ids, confirm: true})});
    const nf = (r.not_found || []).length;
    const errs = (r.errors || []).length;
    toast(`已清除 ${r.n_deleted} 个文件（${(r.deleted||[]).length} 份课件）` +
          `${nf ? ` · ${nf} 份本来就没有产物` : ''}${errs ? ` · ${errs} 项失败` : ''}`);
    // 清单里的"已完成/旧格式"状态变了：重取一次，并清空选中集合
    KPB.sel = new Set();
    try {
      const d = await api('/api/kp-build/batch/options');
      KPB.docs = (d.documents || []).filter(x => x.n_leaf_pages);
    } catch(e){}
    kpbPaintList(); kpbPaintSum();
    // 页签那边当场刷新：人要看的就是"清完这几份变成未整理了"。
    // 用 `mountMindmap()`（重取清单 + 重绘下拉 + 重画树）而不是只刷树——
    // 清除会改掉"页数 / 节点数"，下拉项里那份摘要也得跟着变。
    if (typeof mountMindmap === 'function' && $('#mm-tree')) mountMindmap();
  } catch(e){
    toast('清除失败：' + e.message);
  } finally {
    if (btn){ btn.disabled = false; btn.textContent = '清除选中课件的整理产物'; }
  }
}

// 「真删选中课件」（卡 C-0084）：这一栏的清单来自**整理产物**，里面可能有
// 「已不在库」的幽灵条目，所以这里先如实报一句"其中几份只剩产物"，再**复用
// 资料页那一套确认面板**（openDocDelByIds → /api/docs/delete）——同一个动作
// 在页面里只有一套预览、一套文案、两道闸门，不会长出两个行为不一致的实现。
async function kpbPurge(){
  const sel = kpbSelDocs();
  if (!sel.length){ toast('请先勾选至少一份课件'); return; }
  const ids = sel.map(x => x.doc_id);
  const ghosts = sel.filter(x => x.in_library === false);
  if (ghosts.length){
    toast(`注意：选中的 ${sel.length} 份里有 ${ghosts.length} 份已不在库（只剩产物），`
        + '它们只会被清掉产物文件');
  }
  if (typeof closeModal === 'function') closeModal();
  // 与资料页同一套：先 dry_run 预览 → 弹窗选原文件留不留 → 再 confirm=true 真删
  return openDocDelByIds(ids);
}

async function kpbSubmit(docIds, opt){
  opt = opt || {};
  if (!docIds || !docIds.length){ toast('请先勾选至少一份课件'); return; }
  const skipDone = opt.skipDone !== false;      // 重试失败项时默认沿用"跳过已完成"
  const force = !!opt.force;
  const workers = opt.workers || 2;
  const maxCost = opt.maxCost || 0.8;
  // 花钱前的**二次确认**：口径与后端一致（只算真要跑的那几份，跳过的不计）
  const willRun = KPB.docs.filter(x => docIds.indexOf(x.doc_id) >= 0
    && !(skipDone && x.already_done && !force));
  const est = willRun.reduce((a,x) => a + (x.est_cost_cny||0), 0);
  if (est > KPB.thr){
    const ok = window.confirm(
      `预估花费合计 CNY${est.toFixed(4)}（上界），超过 CNY${KPB.thr.toFixed(2)} 阈值。\n` +
      `将整理 ${willRun.length} 份课件，实际花费通常低于上界（合并后调用更少）。\n\n确定开始？`);
    if (!ok) return;
  }
  const btn = $('#kpb-go');
  if (btn){ btn.disabled = true; btn.textContent = '启动中…'; }
  try {
    const r = await api('/api/kp-build/batch', {method:'POST',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify({doc_ids: docIds, max_workers: workers, max_cost: maxCost,
                            skip_done: skipDone, force: force, confirm: est > KPB.thr})});
    closeModal();
    go('kps');
    toast(`已开始批量整理：${r.n_run} 份 · 并发 ${r.max_workers}` +
          `${r.n_skip ? `（跳过已完成 ${r.n_skip} 份）` : ''}`);
    watchKpBatch();
  } catch(e){
    toast('启动失败：' + e.message);
    if (btn){ btn.disabled = false; btn.textContent = '开始批量整理'; }
  }
}

// ---------------- 单份整理：进度（卡 C-0035，保留兼容） ----------------
function renderKpProgress(p){
  renderProgress(p, '#kp-build-progress');
}

async function pollKpProgress(){
  try {
    const p = await api('/api/kp-build/progress');
    renderKpProgress(p);
    if (p.active) return true;
    const box = $('#kp-build-progress');
    if (p.status === 'done') {
      toast(`整理完成：${p.kp_done || 0} 条 · 花费 CNY${(p.cost_cny || 0).toFixed(4)}｜` +
            '去「资料」页 → 课件思维导图 → 点节点看总结');
      if (box) setTimeout(() => { box.innerHTML = ''; }, 6000);
    } else if (p.status === 'failed') {
      toast('整理失败：' + (p.error || '未知原因'));
    }
    return false;
  } catch(e){ return false; }
}

function watchKpProgress(){
  if (KPB.timer) return;
  const tick = async () => {
    const still = await pollKpProgress();
    if (!still) { clearInterval(KPB.timer); KPB.timer = null; }
  };
  tick();
  KPB.timer = setInterval(tick, 1500);
}

// ---------------- ★ 卡 C-0053：名词解释栏（在「课件思维导图」栏**上面**） ----------------
// 人拍板（2026-09-27）：「新增一个"名词解释"栏，专门收集知识点整理的 AI 提炼出的
// 名词解释。这一栏应该在思维导图栏上面，有一个选择课件的部分，选好之后展开就能
// 展示该课件的名词解释。点击名词还能跳出该名词解释第一次出现的知识点。」
//
// 数据全部来自只读接口 `/api/terms`（卡 C-0058 起取值顺序：**独立名词解释产物优先**，
// 读不到再回落读知识点产物的顶层 `terms`；**不调模型**、不写库）：
// 名词 `term` / 英文 `en` / 中文解释 `def` /
// **首次出现的知识点** `first_kp_id`+`first_kp_name` / 首次出现的页 `first_page`。
// 点名词 → `mmOpenKp(first_kp_id, …, this, false, TERMS.docId)`：**复用现有知识点
// 弹窗**（K5 那套，一行没改）。`docId` **必须显式传**——这一栏的下拉与思维导图栏
// 的下拉各自独立，用缺省值会去思维导图栏选的那份课件里找知识点。
//
// ⚠ 卡 C-0058：名词解释**已从知识点产物摘出**（人拍板 2026-09-29「取消知识点总结管线与
//   名词解释功能的偶联」）——它现在是独立功能（`tools/terms_build.py --doc <id>`），
//   产物是 `logs/knowledge/<doc_id>-名词解释.json`。后端 `/api/terms` 的取值顺序是
//   **独立产物优先 → 旧产物顶层 `terms` 回落**，两种情况都归一成同一个 `terms` 数组，
//   所以这一栏的渲染逻辑**一行没改**；新增的 `terms_source` / `terms_pipeline_version`
//   只用来把"这份名词是哪来的"说清楚。
// ⚠ 旧产物兼容（硬要求）：C-0051 之前的产物（`C-0049-v2`）**没有 terms**，
//   后端给 `terms_state` + 一句人话（`message`），这里原样显示成空态——
//   **不是报错、不是空白**（18 份 v2 产物逐份试过，见验证脚本）。
// ⚠ 课件清单与思维导图栏**同源**（后端两个接口都走 `_artifact_doc_list`）。
const TERMS = {docId: 0, open: true, n: 0, data: null};

function termsCard(){
  return `<div class="card" style="margin-top:14px">
    <h2>名词解释
      <span class="small muted">卡 C-0058 起是<b>独立功能</b> ·
        点名词跳到它<b>第一次出现</b>的那条知识点</span></h2>
    <div class="small muted" style="margin-bottom:10px">
      这一栏专收名词解释（名词 / 英文 / 中文解释）：选一份课件 → 展开，
      就能看到这份课件的全部名词；
      <b>点名词</b>会跳出它<b>第一次出现</b>的那条知识点（与导图里点节点看到的是同一个窗口）。<br>
      数据后端按顺序取两处，取到就用：<code>&lt;doc_id&gt;-名词解释.json</code>
      （卡 C-0058 起的<b>独立</b>名词解释产物）→
      <code>&lt;doc_id&gt;-末级知识点总结.json</code> 的 <code>terms</code>
      （卡 C-0052 那代随知识点提炼的旧写法）。两处都没有时这里写明"暂无名词解释"
      （<b>不报错</b>）。
    </div>
    <div class="row" style="margin-bottom:10px">
      <select id="term-doc" style="flex:1;min-width:260px"></select>
      <button class="ghost" id="term-unfold">展开</button>
    </div>
    <div id="term-box"><div class="small muted">加载中…</div></div>
  </div>`;
}

// 列表正文。三种状态各自说得清：有名词（展开/收起）、空态（后端给的 `message`）、
// 加载中/读取失败（由调用方直接写 #term-box）。
function termsBodyHtml(d){
  const ts = (d && d.terms) || [];
  if (!d || d.terms_state !== 'ok' || !ts.length){
    return `<div class="empty">${esc((d && d.message)
      || '该课件暂无名词解释。')}</div>`;
  }
  if (!TERMS.open){
    return `<div class="small muted">共 <b>${ts.length}</b> 个名词解释（已收起）——
      点上面的【展开】查看。</div>`;
  }
  const rows = ts.map(t => {
    const kp = t.first_kp_id || '';
    const name = t.first_kp_name || t.term || kp;
    return `<li style="margin:0 0 10px;padding:10px 12px;
        border:1px solid var(--line);border-radius:var(--radius)">
      <div>
        <a href="#" class="termname" data-kp="${esc(kp)}" data-kpname="${esc(name)}"
          title="点开「${esc(name)}」（${esc(kp || '—')}）——这个名词第一次出现的知识点"
          style="font-weight:600;text-decoration:none">${esc(t.term)}</a>${
        t.en ? `<span class="termen" style="margin-left:10px;color:var(--accent);
            opacity:.9">${esc(t.en)}</span>`
          : `<span class="small muted" style="margin-left:10px">（这份材料没给英文）</span>`}
      </div>
      <div class="termdef" style="margin-top:6px;line-height:1.65">${
        esc(t.def || '（这条没有解释）')}</div>
      <div class="small muted" style="margin-top:6px">
        首次出现 p.${t.first_page || '?'} · 知识点 <code>${esc(kp || '—')}</code>${
        t.first_kp_name ? ' ' + esc(t.first_kp_name) : ''}${
        (t.kp_ids || []).length > 1
          ? ` · 共出现在 ${t.kp_ids.length} 条知识点里` : ''}
      </div>
    </li>`;
  }).join('');
  return `<div class="small muted" style="margin-bottom:8px">
      共 <b>${ts.length}</b> 个名词解释${
      (d.terms_pipeline_version || d.pipeline_version)
        ? ` · 名词产物 ${esc(d.terms_pipeline_version || d.pipeline_version)}` : ''}${
      d.terms_source === 'own_file' ? '（独立功能生成）'
        : (d.terms_source === 'kp_artifact' ? '（随知识点提炼的旧写法）' : '')}${
      d.title ? ` · ${esc(d.title)}` : ''}（点名词跳到它第一次出现的知识点）</div>
    <ul style="list-style:none;padding:0;margin:0">${rows}</ul>`;
}

function renderTerms(){
  const box = $('#term-box'); if (!box) return;
  const d = TERMS.data || {};
  box.innerHTML = termsBodyHtml(d);
  const n = (d.terms_state === 'ok') ? ((d.terms || []).length) : 0;
  const btn = $('#term-unfold');
  if (btn){
    btn.textContent = n ? (TERMS.open ? '收起' : `展开（${n} 个名词）`) : '展开';
    btn.disabled = !n;
    btn.title = n ? '' : (d.message || '该课件暂无名词解释');
  }
  // 点名词 → 现有知识点弹窗（mmKp*）：把这条名词的**首次出现知识点 id** 传进去。
  // 用 dataset + 逐个绑定（节点名里可能有引号，不塞内联 onclick——与导图同一思路）。
  box.querySelectorAll('.termname').forEach(el => {
    el.onclick = (ev) => {
      ev.preventDefault();
      mmOpenKp(el.dataset.kp, el.dataset.kpname, el, false, TERMS.docId);
    };
  });
}

async function loadTerms(){
  const box = $('#term-box'); if (!box) return;
  box.innerHTML = '<div class="small muted">加载中…</div>';
  let d;
  try { d = await api('/api/terms?doc_id=' + TERMS.docId); }
  catch(e){
    box.innerHTML = `<div class="empty">名词解释读取失败：${esc(e.message)}</div>`;
    return;
  }
  TERMS.data = d;
  TERMS.n = (d.terms || []).length;
  renderTerms();
}

async function mountTerms(){
  const box = $('#term-box'); if (!box) return;
  const btn = $('#term-unfold');
  if (btn) btn.onclick = () => { TERMS.open = !TERMS.open; renderTerms(); };
  let docs = [];
  try { docs = (await api('/api/terms')).documents || []; }
  catch(e){
    box.innerHTML = `<div class="empty">名词解释清单读取失败：${esc(e.message)}</div>`;
    return;
  }
  if (!docs.length){
    box.innerHTML = `<div class="empty">知识库里还没有课件。<br>
      <span class="small">先去「资料」页入库课件并整理知识点，再回来这里看名词解释。</span></div>`;
    if (btn) btn.disabled = true;
    return;
  }
  // 默认选中：**优先挑一份真有名词的**（人进这一栏就是想看名词解释）；
  // 已经选过且还在清单里就保持不变（换了页签回来不该跳走）。
  if (!docs.some(d => d.doc_id === TERMS.docId)){
    TERMS.docId = (docs.find(d => (d.n_terms || 0) > 0) || docs[0]).doc_id;
  }
  const sel = $('#term-doc');
  if (sel){
    sel.innerHTML = docs.map(d => {
      const n = d.n_terms || 0;
      const tail = n > 0 ? ` · ${n} 个名词`
        : (d.terms_state === 'stale' ? ' · 未整理'
          : (d.terms_state === 'legacy' ? ' · 旧格式产物' : ' · 暂无名词解释'));
      return `<option value="${d.doc_id}" ${
        d.doc_id === TERMS.docId ? 'selected' : ''}>${esc(d.title)}${tail}${
        d.in_library ? '' : '（已不在库）'}</option>`;
    }).join('');
    sel.onchange = e => {
      TERMS.docId = parseInt(e.target.value) || 0;
      loadTerms();          // 换课件**不重置展开状态**：人刚点开，别给他收回去
    };
  }
  await loadTerms();
}

// ---------------- 课件思维导图 ----------------
// 数据来自入库时 AI 全局结构分析的留存（`pages[页码] = 该页的完整路径`），
// 后端 /api/mindmap 把各页路径按前缀合并成层级树，并给节点内联**末级知识点
// 标记**（lkp_id / lkp_ready / lkp_role）——新方案（卡 C-0032）：每个末级节点
// 一个知识点，内容是"该节点覆盖页的正文 + 图片理解"经模型提炼的**总结**。
// 折叠用原生 <details>，点节点名**就地弹小窗看总结**（复用 evPop 那套），
// 不引入任何外部 CDN / 第三方图表库（本项目离线优先，见 README.md）。
//
// 展开状态与选中的文档存在 MINDMAP 里：点节点看知识点后关掉小窗，
// 树不该被重置成"全折叠 + 回到第一份文档"。
// nodes 是"下标路径 → 节点对象"的映射，点名字时按 data-k 回查：
// 节点名里可能有引号/尖括号，不适合塞进 DOM 属性或内联 onclick。
// downshift：本份产物是不是卡 C-0045 的"父节点页下放"口径（由 /api/mindmap 给），
// 只影响父节点页的提示话术——旧产物为 false，说法与改动前一致。
// docs（卡 C-0061）：最近一次 `/api/mindmap` 拿到的课件清单，按钮状态按它画，
// 录入成功后也就地更新这一份，不必重新拉整张清单。
// pendingDoc（卡 C-0061）：从复习页签的月历点「打开课件」跳进来时，要优先打开
// **那一份**课件的思维导图；mountMindmap 取完就置 0（不然下次进页签又被抢一次）。
const MINDMAP = {docId: 0, open: {}, nodes: {}, downshift: false,
                 docs: [], pendingDoc: 0};

function mindmapCard(){
  return `<div class="card" style="margin-top:14px">
    <h2>课件思维导图</h2>
    <div class="small muted" style="margin-bottom:10px">
      <b>这一屏的一切都来自「整理产物」</b>
      （<code>logs/knowledge/&lt;doc_id&gt;-末级知识点总结.json</code>）：
      思维导图结构、理解、要点都在那份产物里，<b>不读</b>入库导图
      <code>logs/outline/</code>。
      <b>点任一节点名可查看该节点的知识点总结</b>
      （末级节点一个知识点：把该节点覆盖的页（连续 ≤3 页）提炼成一段理解 +
      3~6 条要点，不贴原文；带 <span style="color:var(--accent)">◆</span>
      的是已有总结的末级节点，
      <span style="color:var(--warn)">◇</span> 的是待生成）。
      还没整理过的课件会在这里写明"未整理"并告诉你从哪儿开始；
      旧格式的产物<b>保留文件、但页签不显示</b>，在下面重新整理一份即可。
    </div>
    <div id="mm-box"><div class="small muted">加载中…</div></div>
    <!-- 卡 C-0052：右下角「AI答疑」按钮。刻意放在 #mm-box **外面**——
         mountMindmap 每次进页签都会重写 #mm-box 的内容，放里面会被连根换掉。
         卡 C-0061：「录入遗忘曲线」同理，放在「AI答疑」**左边**（同一行、同款 .act）。 -->
    <div class="row" style="margin-top:12px;justify-content:flex-end">
      <span class="small muted" id="mm-enroll-hint">按 1/3/7/16/35 天标注 5 次复习</span>
      <button class="act" id="mm-enroll">录入遗忘曲线</button>
      <span class="small muted" id="mm-ai-hint">就这一份课件提问或让它总结 ·
        独立管线（不检索、不用提示词、思考最强）· 产出可记入「笔记」</span>
      <button class="act" id="mm-ai">AI答疑</button>
    </div>
  </div>`;
}

async function mountMindmap(){
  const box = $('#mm-box'); if (!box) return;
  // 卡 C-0052：「AI答疑」按钮的接线放在**早退之前**——没课件时点它也要给一句
  // 明白话（"先选一份课件"），而不是点了没反应。onclick 是赋值，重复进页签不会叠加。
  const aiBtn = $('#mm-ai');
  if (aiBtn) aiBtn.onclick = openDeckChat;
  // 卡 C-0061：「录入遗忘曲线」的接线同样放在早退之前，理由与上面一句相同。
  const enBtn = $('#mm-enroll');
  if (enBtn) enBtn.onclick = deckEnrollClick;
  let docs = [];
  try { docs = (await api('/api/mindmap')).documents || []; }
  catch(e){ box.innerHTML = `<div class="empty">课件清单读取失败：${esc(e.message)}</div>`; return; }
  if (!docs.length){
    box.innerHTML = `<div class="empty">知识库里还没有课件。<br>
      <span class="small">先去「资料」页入库课件，再回来整理知识点
      （整理只读库里的文本，不需要入库导图）。</span></div>`;
    return;
  }
  MINDMAP.docs = docs;          // 卡 C-0061：按钮状态的数据源（就地更新，不重拉）
  // 卡 C-0061：从复习页签的月历点「打开课件」跳进来 → 优先打开**那一份**（取完清 0）；
  // 其次才是老逻辑"当前选中不在清单里就取第一份"。
  const pend = MINDMAP.pendingDoc;
  MINDMAP.pendingDoc = 0;
  if (pend && docs.some(d => d.doc_id === pend)) MINDMAP.docId = pend;
  else if (!docs.some(d => d.doc_id === MINDMAP.docId)) MINDMAP.docId = docs[0].doc_id;
  mmEnrollPaint(docs.find(d => d.doc_id === MINDMAP.docId));
  // 下拉项里那份摘要按**产物状态**说：有 v2 产物才谈页数/节点数，
  // 否则写"未整理 / 旧格式，需重新整理"——显示"0 页 / 0 节点"会让人以为课件空了。
  const mmOpt = d => {
    const tail = d.artifact_state === 'v2'
      ? ` · ${d.n_pages} 页 / ${d.n_nodes} 节点`
      : (d.artifact_state === 'legacy' ? ' · 旧格式，需重新整理' : ' · 未整理');
    return `<option value="${d.doc_id}" ${
      d.doc_id===MINDMAP.docId?'selected':''}>${esc(d.title)}${tail}${
      d.in_library?'':'（已不在库）'}</option>`;
  };
  box.innerHTML = `
    <div class="row" style="margin-bottom:10px">
      <select id="mm-doc" style="flex:1;min-width:260px">
        ${docs.map(mmOpt).join('')}
      </select>
      <button class="ghost" id="mm-ren-deck"
        title="改这份课件在看板上的标题（documents.title；不动文件、不动产物）">改课件标题</button>
      <button class="ghost" id="mm-ren-art"
        title="改整理产物里的课件名（页签上思维导图的根名，四处同步；不重跑、不花钱）">改产物标题</button>
      <button class="ghost" id="mm-expand">展开全部</button>
      <button class="ghost" id="mm-collapse">折叠全部</button>
    </div>
    <div id="mm-tree"><div class="small muted">加载中…</div></div>`;
  // 卡 C-0085：两个改名按钮都作用于**当前选中的这份课件**（MINDMAP.docId）——
  // 与下拉框、展开/折叠同一屏，不需要先跳到资料页。
  const rd = $('#mm-ren-deck');
  if (rd) rd.onclick = () => {
    const it = (MINDMAP.docs || []).find(x => x.doc_id === MINDMAP.docId);
    if (!MINDMAP.docId) return toast('先在上面选一份课件');
    renameDocTitle(MINDMAP.docId, (it && it.title) || '');
  };
  const ra = $('#mm-ren-art');
  if (ra) ra.onclick = () => {
    if (!MINDMAP.docId) return toast('先在上面选一份课件');
    renameArtifactTitle(MINDMAP.docId, '');
  };
  $('#mm-doc').onchange = e => {
    MINDMAP.docId = parseInt(e.target.value) || 0;
    MINDMAP.open = {};   // 换了文档，旧的展开状态没有意义
    mmEnrollPaint(docs.find(d => d.doc_id === MINDMAP.docId));   // 卡 C-0061
    loadMindmapTree();
  };
  $('#mm-expand').onclick = () => mmToggleAll(true);
  $('#mm-collapse').onclick = () => mmToggleAll(false);
  await loadMindmapTree();
}

// 卡 C-0061：把「录入遗忘曲线」按钮画成**当前选中课件**的状态。
// 数据来自 `/api/mindmap` 清单里每份课件的 4 个 `deck_*` 字段（后端一次批量查完）。
// `item` 为空（清单里找不到）时按"未录入"画——宁可让人再点一次（幂等），
// 也不能因为拿不到状态就把按钮画成禁用。
function mmEnrollPaint(item){
  const btn = $('#mm-enroll'), hint = $('#mm-enroll-hint');
  if (!btn || !hint) return;
  const planId = item ? (item.deck_plan_id || 0) : 0;
  const done = item ? (item.deck_rounds_done || 0) : 0;
  const total = item ? (item.deck_rounds_total || 0) : 0;
  if (!planId){
    btn.className = 'act';
    btn.textContent = '录入遗忘曲线';
    hint.textContent = '按 1/3/7/16/35 天标注 5 次复习';
  } else if (total && done >= total){
    btn.className = 'ghost';
    btn.textContent = `已完成 ${done}/${total} 轮`;
    hint.textContent = '5 轮全部完成 · 在「复习」页签的月历上可查';
  } else {
    btn.className = 'ghost';
    btn.textContent = `已录入 · 下次 ${(item.deck_next_due || '').slice(5) || '—'}`;
    hint.textContent = `已完成 ${done}/${total} 轮 · 在「复习」页签的月历上可查`;
  }
}

// 点击「录入遗忘曲线」：POST /api/deck-enroll（**幂等**，见 core/study.py::enroll_deck）。
// 已录入的课件再点一次不会重建计划、不会清掉已完成的轮次，只会回一句"已录入 + 下次日期"。
async function deckEnrollClick(){
  const docId = MINDMAP.docId;
  if (!docId){ toast('先在上面选一份课件'); return; }
  try {
    const r = await api('/api/deck-enroll', {method:'POST',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify({doc_id: docId})});
    if (r.ok === false) throw new Error(r.error || '录入失败');
    if (r.already){
      toast(`${r.title}：已录入（重复点击不会重复排课）· ` +
        `已完成 ${r.rounds_done}/${r.n_rounds} 轮 · 下次 ${r.next_due || '—'}`);
    } else {
      const days = (r.days || []).map(d => d.due_day.slice(5)).join(' / ');
      toast(`${r.title}：已录入 5 轮复习 → ${days}（去「复习」页签看月历）`);
    }
    // 就地更新清单缓存 + 按钮状态：不重拉 `/api/mindmap`（那会顺带重扫产物目录）
    const item = (MINDMAP.docs || []).find(d => d.doc_id === docId);
    if (item){
      item.deck_plan_id = r.plan_id;
      item.deck_next_due = r.next_due || '';
      item.deck_rounds_done = r.rounds_done || 0;
      item.deck_rounds_total = r.n_rounds || 5;
      mmEnrollPaint(item);
    }
  } catch(e){ toast('录入失败：' + e.message); }
}

async function loadMindmapTree(){
  const t = $('#mm-tree'); if (!t) return;
  t.innerHTML = '<div class="small muted">加载中…</div>';
  let d;
  try { d = await api('/api/mindmap?doc_id=' + MINDMAP.docId); }
  catch(e){ t.innerHTML = `<div class="empty">读取失败：${esc(e.message)}</div>`; return; }
  if (!d.has_structure){
    // 卡 C-0050：页签只有**整理产物**一个数据源。"没有"分三种，后端
    // `artifact_message` 已经把每种"下一步做什么"写好了，这里只补一个徽标与
    // 入口位置——照旧**不是报错**，人看到的是状态说明，不是"出错"。
    const ast = d.artifact_state || 'none';
    const astTag = ast === 'legacy' ? '旧格式，需重新整理'
      : (ast === 'incomplete' ? '产物不完整，需重新整理' : '未整理');
    t.innerHTML = `<div class="empty">
      <span class="badge warn">${esc(astTag)}</span>
      <div style="margin-top:8px">${esc(d.artifact_message ||
        '该课件还没有整理过知识点，点【整理知识点】生成。')}</div>
      ${d.lkp_total ? `<div class="small muted" style="margin-top:8px">
        这份课件已有 ${d.lkp_total} 条知识点记录，但读不到结构树。</div>` : ''}
      <div class="small muted" style="margin-top:8px">
        整理入口：本页下面的「批量整理知识点」卡片 → 选择课件批量整理。
        产物写在 <code>logs/knowledge/&lt;doc_id&gt;-末级知识点总结.json</code>，
        页签上的思维导图、理解、要点全部来自它。</div></div>`;
    return;
  }
  MINDMAP.nodes = {};   // 重新渲染前清空：下标路径只在本次渲染里有效
  // 卡 C-0045 起的口径：父节点页**下放**（不单独成条，内容并入后继末级页）。
  // 旧产物没有这个键 → false → 节点提示走"暂不建"的老说法，页面显示不变。
  MINDMAP.downshift = !!d.lkp_downshift;
  // ⚠ 卡 C-0046：`lkp_total` 是**知识点条数**，`lkp_ready` 是**挂上总结的末级节点数**。
  // C-0045「一条覆盖多页」之后两者必然不同（doc#5：12 条 vs 23 个节点，
  // LN-06 一条覆盖 p.4–p.8 就挂 5 个节点），所以旧文案
  // `已就绪 ${lkp_ready} / ${lkp_total} 个` 会写出"23 / 12"——分子大于分母。
  // 修法与 `_lkp_seq()` 同思路：两个数各说各的口径，不并成一个分数。
  const lkpLine = d.lkp_available
    ? `知识点 <b>${d.lkp_total || 0} 条</b> · 已挂到 ${d.lkp_ready || 0} 个末级节点${
        d.lkp_pending ? `（<span style="color:var(--warn)">待生成 ${
          d.lkp_pending} 个</span>）` : ''}${
        d.lkp_source ? ` · 数据源 ${esc(d.lkp_source)}` : ''}${
        d.lkp_source_card ? ` · 产出卡 ${esc(d.lkp_source_card)}` : ''}`
    : '末级知识点总结：<span class="badge warn">待生成</span>（还没读到总结数据文件）';
  // 卡 C-0045 的核心成果得看得见：覆盖了全篇多少页 · 有没有一页被两条重复计数 ·
  // 多少页是下放过来的。**向后兼容**：17 份旧产物没有 `meta.coverage`，
  // 后端就不给 `lkp_coverage`，这一行整行不渲染——绝不显示 0/0。
  const cov = d.lkp_coverage;
  const covLine = cov ? `覆盖 ${cov.n_covered || 0}/${cov.pages_all || 0} 页${
      (cov.overlap_pages && cov.overlap_pages.length)
        ? ` · <span style="color:var(--warn)">⚠ ${cov.overlap_pages.length} 页被多条知识点重复计数</span>`
        : ' · 无跨条重复计数'}${
      d.lkp_parent_nodes ? ` · 下放 ${d.lkp_parent_nodes} 页（内容并入后继知识点）` : ''}`
    : '';
  // 父节点页那句：**新口径优先用产物自带的 `meta.excluded_reason`**
  // （它把哪几页、并到哪儿都写清了）；旧产物没有这句话，保持改动前的说法。
  let exclLine = '';
  if (d.lkp_excluded_pages && d.lkp_excluded_pages.length){
    exclLine = (d.lkp_downshift && d.lkp_excluded_reason)
      ? esc(String(d.lkp_excluded_reason).replace(/\*\*/g, ''))
      : `其中 ${d.lkp_excluded_pages.map(p => 'p.' + p).join('、')}
         这些页的节点在导图里还有下级，<b>按当前口径不建知识点</b>`;
  }
  t.innerHTML = `
    <div class="small muted" style="margin-bottom:8px">
      ${d.n_pages} 页 → ${d.n_nodes} 个节点 · 结构来自<b>整理产物</b>（模型生成）·
      模型 ${esc(d.model||'—')}${d.created_at ? ' · ' + fmtTime(d.created_at) : ''} ·
      整理花费 CNY${(d.cost_cny||0).toFixed(4)}${
      d.in_library?'':' · ⚠ 该文档已不在库'}<br>
      ${lkpLine}${covLine ? '<br>' + covLine : ''}${
        exclLine ? '<br>' + exclLine : ''}
    </div>
    <div class="mmtree">${mmNodes(d.tree, '')}</div>`;
  bindMindmapTree();
}

function mmNodes(list, pkey){
  if (!list || !list.length) return '';
  return '<ul>' + list.map((n, i) => {
    // key 用"下标路径"：同一份数据每次渲染都一样，才能记住展开状态；
    // 点名字时也靠它回查节点对象（见 MINDMAP.nodes）
    const key = pkey ? pkey + '.' + i : String(i);
    MINDMAP.nodes[key] = n;
    // 视觉上区分：有总结（◆ 实线）/ 末级待生成（◇ 黄虚线）/
    // 父节点页与其余节点（灰）。都用纯 CSS，不引图标库。
    const cls = n.lkp_ready ? ' has-kp'
      : (n.lkp_role === 'leaf' ? ' lkp-pending'
        : (n.lkp_role === 'parent_page' ? ' parent-page' : ' nonkp'));
    // 卡 C-0050：v2 的结构节点自带 kp_ids，一条知识点覆盖相邻 ≤3 页；一个叶节点
    // 覆盖超过 3 页时会挂**多条**知识点（lkp_multi），点开先列出这几条让人选。
    const tip = n.lkp_ready
      ? `末级知识点 ${n.lkp_id}${n.lkp_pages_label ? ' · ' + n.lkp_pages_label : ''}${
          n.lkp_multi ? ` · 这个节点下有 ${(n.lkp_ids||[]).length} 条知识点，点开选一条`
            : (n.lkp_merged ? ' · 这条覆盖相邻多页' : '')} · 点开看总结`
      : (n.lkp_role === 'leaf'
          ? '末级节点：该建知识点，但总结待生成'
          : (n.lkp_role === 'parent_page'
              ? (MINDMAP.downshift
                  ? '父节点页：本页不单独成条，内容已下放给紧随其后的末级页知识点'
                  : '该页路径还有下级节点，按当前口径不建知识点')
              : '非末级节点：本身不含知识点，展开看下面的末级节点'));
    const name = `<span class="mmname${cls}" data-k="${key}"
      data-name="${esc(n.name)}" title="${esc(tip)}">${esc(n.name)}</span>`;
    const meta = `<span class="small muted"> ${n.n_pages} 页${
      n.page ? ' · p.' + n.page : ''}</span>`;
    if (n.children && n.children.length){
      return `<li><details class="mmd" data-k="${key}"${
        MINDMAP.open[key] ? ' open' : ''}><summary>${name}${meta}</summary>${
        mmNodes(n.children, key)}</details></li>`;
    }
    return `<li><div class="mmleaf">${name}${meta}</div></li>`;
  }).join('') + '</ul>';
}

function bindMindmapTree(){
  const t = $('#mm-tree'); if (!t) return;
  // 点名字 = **就地看该节点的知识点总结**（不再跳检索页）；点前面的箭头 = 折叠/展开
  // （<summary> 自带行为）。名字走 data-k 而不是内联 onclick：
  // 节点名里可能有引号/尖括号；preventDefault 是为了别把 <details> 一起折叠了。
  t.querySelectorAll('.mmname').forEach(el => {
    el.onclick = e => {
      e.preventDefault(); e.stopPropagation();
      mmOpenNode(el.dataset.k, el);
    };
  });
  t.querySelectorAll('details.mmd').forEach(d => {
    d.addEventListener('toggle', () => { MINDMAP.open[d.dataset.k] = d.open; });
  });
}

function mmToggleAll(open){
  document.querySelectorAll('#mm-tree details.mmd').forEach(d => { d.open = open; });
}

// ---------------- 从笔记跳回知识点窗口（卡 C-0052） ----------------
// 人拍板：「点进条目后不光可以看到笔记原文，还可以按按钮跳转出绑定了该笔记的
// 知识点窗口。」笔记里存的是 kp_id + doc_id，这里负责把页签切过去、把课件选对、
// 把树上那一支展开、再调 mmOpenKp 打开**导图上那个真窗口**——不新造一个
// "只有笔记的弹窗"，否则同一条知识点会出现两种长相的窗口。
async function mmWaitFor(fn, ms){
  const t0 = Date.now();
  while (Date.now() - t0 < (ms || 8000)){
    let v = null;
    try { v = fn(); } catch(e){ v = null; }
    if (v) return v;
    await new Promise(r => setTimeout(r, 120));
  }
  return null;
}

async function mmJumpToKp(docId, kpId, label){
  closeModal();
  if (CURRENT !== 'kps') await go('kps');
  if (!await mmWaitFor(() => $('#mm-doc'))){
    toast('知识点页签还没挂上，稍后再试');
    return;
  }
  const sel = $('#mm-doc');
  if (!sel.querySelector('option[value="' + docId + '"]')){
    // 该课件已不在库 / 不在当前学科：如实说，不假装跳过去了
    toast('这份课件（doc#' + docId + '）不在当前学科的课件清单里，跳不过去');
    return;
  }
  if (MINDMAP.docId !== parseInt(docId)){
    MINDMAP.docId = parseInt(docId) || 0;
    MINDMAP.open = {};
    sel.value = String(docId);
    await loadMindmapTree();
  }
  // mountMindmap 是**不 await** 的（见 viewKps），所以"树已经有内容"得等出来：
  // 非空态等到节点，空态等到 .empty（两种都算"加载完了"）
  await mmWaitFor(() => {
    const t = $('#mm-tree');
    return t && (t.querySelector('.mmname') || t.querySelector('.empty'));
  });
  let key = '', node = null;
  Object.keys(MINDMAP.nodes || {}).forEach(k => {
    if (key) return;
    const n = MINDMAP.nodes[k];
    const ids = (n.lkp_ids || []).map(String);
    if (n.lkp_id) ids.push(String(n.lkp_id));
    if (ids.indexOf(String(kpId)) >= 0){ key = k; node = n; }
  });
  evPopEl().dataset.kpPop = '1';    // 与点节点一致：居中显示（见 evPopPlace）
  if (key){
    mmToggleAll(true);              // 祖先 <details> 全展开，否则它的 rect 全是 0
    const el = await mmWaitFor(() =>
      document.querySelector('.mmname[data-k="' + key + '"]'));
    if (el){
      try { el.scrollIntoView({block:'center'}); } catch(e){}
      // ★ 滚动会**异步**派发 window scroll，而 evPop 的既有规矩是"一滚就收窗"
      //   （见 evPopScroll）。若立刻开窗，那次迟到的 scroll 会把刚打开的知识点
      //   弹窗就地收掉（dataset.kp 被清空 → 总结响应回来直接作废），
      //   表现是弹窗永远停在"加载中"。所以先让这一拍过去，再开窗。
      await new Promise(r => setTimeout(r, 350));
      return mmOpenKp(kpId, (node && node.name) || label || kpId, el, false);
    }
  }
  // 树上找不到这条知识点（课件被重新整理过、或这条已不在产物里）：
  // 不报错——直接把这条知识点的窗口居中打开，能读到什么就显示什么
  toast('导图上没找到这条知识点（课件可能已重新整理），直接打开它的总结');
  return mmOpenKp(kpId, label || kpId, null, false);
}

// ---------------- 课件级 AI 答疑（卡 C-0052 起 · C-0057 改独立管线） ----------------
// 人最初拍板（C-0052）：「在课件思维导图那一栏右下角新增一个『AI答疑』按钮，
// 点击后可以跳出一个小对话窗口……这个窗口是用来对整个课件提问和总结的，
// 提问和总结得到的产出也要记入笔记页签。」
//
// 人后一次拍板（C-0057，2026-09-29 原话）：「每份课件的AI答疑不要和整个知识库的
// AI问答混用，开一条新的管线用于每份课件的答疑。这条管线不用提示词，思考强度
// 开到最高。」——所以这个窗口现在走的**不是**知识库问答那条路：
//
//   1. 后端是**独立管线**（/api/deck-chat/stream → core/chat.py 的 deck_* 区段）：
//      **不检索**（不查库里的相似片段）、**不用提示词**（messages 里没有 system，
//      也不读 logs/knowledge/ 下的提示词文件）、**思考强度最高**
//      （thinking=True + reasoning_effort=max）。整份课件按页序直接进上下文，
//      装不下才保序等距抽样，并把实况报在范围行上（见下）；
//   2. 「跟这份课件有关」不再是"检索限定在它"——这条路上压根不检索，
//      上下文里只有这一份课件的内容，**不会有别的资料的片段混进来**；
//   3. 产出记入笔记＝POST /api/note/deck（origin=deck_chat + doc_id），
//      笔记页签据此显示来源与记录时间。
//
// 窗口用 modal 而**不是** evpop 小窗：对话要能选中/复制文本，而 evpop 是
// "点外面就关"，且全页只有一个小窗（点节点看知识点会把对话顶掉）。
// 对话按课件保存：换一份课件就重开一段——两份课件的内容不该混进一个上下文。
const DKCHAT = {docId: 0, title: '', msgs: [], busy: false};

function deckChatDoc(){
  const sel = $('#mm-doc');
  const docId = MINDMAP.docId || 0;
  let title = '';
  if (sel && sel.selectedOptions && sel.selectedOptions[0])
    title = String(sel.selectedOptions[0].textContent || '').trim();
  // 下拉项的文案尾巴带着**产物状态摘要**（" · 34 页 / 36 节点"、" · 未整理"…），
  // 那是给下拉看的状态，不是课件名：它会写进对话窗口标题、笔记标题与文件名里，
  // 变成一串噪声（实测："… · 34 页 / 36 节点 · AI答疑：…"）。这里剥掉。
  title = title.replace(
    /\s*·\s*(?:\d+\s*页\s*\/\s*\d+\s*节点|旧格式，需重新整理|产物不完整，需重新整理|未整理)\s*(（已不在库）)?$/,
    '').trim();
  return {docId, title: title || ('doc#' + docId)};
}

// 千分位：范围行里要写 60,000 这种数，人眼扫得快（只服务本区段）
const dkNum = n => String(Number(n) || 0).replace(/\B(?=(\d{3})+(?!\d))/g, ',');

function deckChatHtml(){
  return `<h2>AI 答疑 · ${esc(DKCHAT.title)}</h2>
    <div class="small muted">独立管线（与「问答」页的知识库问答不是一条路）：
      <b>不检索</b> · <b>不用提示词</b> · 思考强度 <b>最高</b> ·
      整份课件（doc#${DKCHAT.docId}）直接进上下文 ·
      提问与总结的产出可一键记入「笔记」页签</div>
    <div class="row" style="margin-top:10px">
      <button class="ghost" id="dk-sum">总结这份课件</button>
      <button class="ghost" id="dk-clear">清空对话</button>
      <span class="small muted" id="dk-scope">首次提问后这里显示本次实际送出的参数</span>
    </div>
    <div id="dk-thread" style="margin-top:12px;display:flex;flex-direction:column;
      gap:14px;max-height:46vh;overflow:auto;padding-right:6px"></div>
    <div class="row" style="margin-top:12px;align-items:flex-end">
      <textarea id="dk-q" style="flex:1;min-width:220px;min-height:44px;
        max-height:140px;resize:vertical"
        placeholder="就这份课件提问，例如：这份课件的重点是什么（Enter 发送，Shift+Enter 换行）"></textarea>
      <button class="act" id="dk-send">发送</button>
    </div>
    <div class="row" style="margin-top:10px">
      <button class="ghost" onclick="closeModal()">关闭</button>
    </div>`;
}

// 这次回答**到底依据了多少内容、用了什么参数**：写进回答下方一小行（不打扰），
// 完整字段挂在 title 上（hover 可见，机器也抠得到）。C-0052 那版这里显示的是
// "检索到的片段出处"——C-0057 起不检索了，硬列几个出处就是骗人，所以改成
// 如实报上下文：送出/共几块、约多少 token、有没有截断。
function dkCtxLine(m){
  const c = m.ctx; if (!c) return '';
  return `依据：本课件全文 ${c.chunks_used}/${c.chunks_total} 块` +
    (c.figures_total ? ` + 页图识别 ${c.figures_used}/${c.figures_total} 页` : '') +
    ` · 约 ${dkNum(c.tokens_est)} token` +
    (c.truncated ? ' · 已截断（保序等距抽样）' : ' · 未截断') +
    ` · ${c.model} · 思考 ${c.reasoning_effort}`;
}

function renderDeckChat(){
  const th = $('#dk-thread'); if (!th) return;
  th.innerHTML = DKCHAT.msgs.length ? DKCHAT.msgs.map((m, i) => {
    if (m.role === 'user')
      return `<div class="msg user"><div class="who">我</div><div class="body">
        <div class="bubble">${esc(m.content).replace(/\n/g,'<br>')}</div></div></div>`;
    return `<div class="msg ai"><div class="who">AI</div><div class="body">
      <div class="bubble">${mdToHtml(m.content)}</div>
      ${m.ctx ? `<div class="small muted" style="margin-top:6px"
        data-dkctx="${i}" title="${esc(JSON.stringify(m.ctx))}">${
        esc(dkCtxLine(m))}</div>` : ''}
      <div class="row" style="margin-top:6px">
        <button class="ghost" data-dknote="${i}">记入笔记</button>
        <span class="small muted" data-dkmsg="${i}">${
          m.saved ? '已记入 ' + esc(m.saved) : ''}</span>
      </div>
      ${m.elapsed ? `<div class="small muted" style="margin-top:4px">用时 ${
        Number(m.elapsed).toFixed(1)}s · 输入 ${
        (m.usage && m.usage.prompt_tokens) || 0} / 输出 ${
        (m.usage && m.usage.completion_tokens) || 0} tokens</div>` : ''}
    </div></div>`;
  }).join('') : `<div class="small muted">还没有对话。点「总结这份课件」，
    或直接在下面提问——回答只依据这份课件里的内容（整份直接给模型，不检索）。</div>`;
  th.querySelectorAll('button[data-dknote]').forEach(b => {
    b.onclick = () => deckChatSaveNote(parseInt(b.dataset.dknote));
  });
  th.scrollTop = th.scrollHeight;
}

function openDeckChat(){
  const d = deckChatDoc();
  if (!d.docId){ toast('先在「课件思维导图」里选一份课件'); return; }
  if (DKCHAT.docId !== d.docId){ DKCHAT.docId = d.docId; DKCHAT.msgs = []; }
  DKCHAT.title = d.title;
  modal(deckChatHtml());
  const sum = $('#dk-sum');
  if (sum) sum.onclick = () => deckChatSend(
    '请总结这份课件的整体内容与重点（分条列出，每条后面标注出处编号）。');
  const clr = $('#dk-clear');
  if (clr) clr.onclick = () => { DKCHAT.msgs = []; renderDeckChat(); };
  const send = $('#dk-send');
  const ta = $('#dk-q');
  const fire = () => { const q = ta ? ta.value.trim() : ''; if (q) deckChatSend(q); };
  if (send) send.onclick = fire;
  if (ta){
    ta.addEventListener('keydown', e => {
      if (e.key === 'Enter' && !e.shiftKey){ e.preventDefault(); fire(); }
    });
    ta.focus();
  }
  renderDeckChat();
}

async function deckChatSend(q){
  if (DKCHAT.busy || !q) return;
  const ta = $('#dk-q'); if (ta) ta.value = '';
  DKCHAT.busy = true;
  const ai = {role:'assistant', content:'', ev:[], ctx:null};
  DKCHAT.msgs.push({role:'user', content:q});
  DKCHAT.msgs.push(ai);
  renderDeckChat();
  const send = $('#dk-send');
  if (send){ send.disabled = true; send.textContent = '思考中…'; }
  // 历史只带本轮之前的最近 8 条（与问答页同口径），别把上下文撑爆
  const history = DKCHAT.msgs.slice(0, -2).slice(-8)
    .map(m => ({role:m.role, content:m.content}));
  const lastBubble = () => {
    const t = $('#dk-thread'); if (!t) return null;
    const els = t.querySelectorAll('.msg.ai .bubble');
    return els.length ? els[els.length - 1] : null;
  };
  let err = '';
  try {
    const resp = await fetch('/api/deck-chat/stream', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({doc_id: DKCHAT.docId, query: q, history}),
    });
    if (!resp.ok) throw new Error('HTTP ' + resp.status);
    const reader = resp.body.getReader();
    const dec = new TextDecoder('utf-8');
    let buf = '';
    while (true){
      const {done, value} = await reader.read();
      if (done) break;
      buf += dec.decode(value, {stream:true});
      let i;
      while ((i = buf.indexOf('\n\n')) >= 0){
        const chunk = buf.slice(0, i); buf = buf.slice(i + 2);
        if (!chunk.startsWith('data: ')) continue;
        let obj; try { obj = JSON.parse(chunk.slice(6)); } catch(e){ continue; }
        if (obj.type === 'scope'){
          // 后端在开答**之前**把这次实际送出去的参数报过来（模型 / 思考强度 /
          // 送出多少 token / 预算 / 有没有截断）。写进范围行供人核对，
          // 完整字段挂 title（hover 可见、验证脚本也抠得到）。
          // ⚠ C-0057 起这条路上**不检索**，所以这里不再有"命中几条证据"。
          ai.ctx = obj;
          const sc = $('#dk-scope');
          if (sc){
            sc.textContent = `${obj.model} · 思考 ${obj.reasoning_effort}`
              + ` · 上下文 ${dkNum(obj.tokens_est)}/${dkNum(obj.tokens_budget)} token`
              + (obj.truncated ? ' · 已截断' : ' · 未截断');
            sc.title = '独立管线：不检索 / 不用提示词 / 思考强度最高 · '
              + `课件《${obj.doc_title}》doc#${obj.doc_id} · `
              + `正文 ${obj.chunks_used}/${obj.chunks_total} 块 · `
              + `页图识别 ${obj.figures_used}/${obj.figures_total} 页 · `
              + obj.strategy;
          }
        } else if (obj.type === 'sources'){
          // 老事件：C-0057 的独立管线不发它。留着是为了万一跑的是旧后端
          // （人没重启看板）时前端不炸——那种情况下也照常显示回答。
          ai.ev = obj.evidence || [];
        } else if (obj.type === 'delta'){
          ai.content += obj.text;
          const b = lastBubble();
          if (b) b.innerHTML = mdToHtml(ai.content) + '<span class="typing"></span>';
          const t = $('#dk-thread'); if (t) t.scrollTop = t.scrollHeight;
        } else if (obj.type === 'done'){
          ai.usage = obj.usage || {}; ai.elapsed = obj.elapsed || 0;
        } else if (obj.type === 'error'){
          err = obj.message || '未知错误';
        }
      }
    }
  } catch(e){ err = e.message; }
  if (err) ai.content += (ai.content ? '\n\n' : '') + '**出错**：' + err;
  DKCHAT.busy = false;
  if (send){ send.disabled = false; send.textContent = '发送'; }
  renderDeckChat();
  if (ta) ta.focus();
}

// 把这一轮问答记入「笔记」页签：正文含问与答，来源类型 origin=deck_chat +
// doc_id=该课件（无 kp_id——这是对整份课件的问答）。
// `## 出处` 段（后端按 payload.refs 渲染）在 C-0057 起写的是**这次回答的依据与
// 参数**：独立管线不检索，没有"第几页的哪个片段"可写，硬编几个页码就是骗人；
// 而"依据的是这份课件的全文、送了多少、用的什么模型与思考强度"才是下次读的
// 人真正需要核对的（他看这条笔记时，上下文早就不在了）。
async function deckChatSaveNote(i){
  const m = DKCHAT.msgs[i];
  if (!m || m.role !== 'assistant' || !m.content) return;
  const prev = DKCHAT.msgs[i - 1];
  const q = (prev && prev.role === 'user') ? prev.content : '';
  const refs = (m.ev && m.ev.length)
    ? m.ev.map(e => `[${e.idx}] ${e.label || e.doc_title || ''}（doc#${e.doc_id}）`)
    : (m.ctx ? [
        `依据：本课件《${m.ctx.doc_title}》（doc#${m.ctx.doc_id}）全文 — `
        + `送出 ${m.ctx.chunks_used}/${m.ctx.chunks_total} 块正文`
        + `（页图识别 ${m.ctx.figures_used}/${m.ctx.figures_total} 页），`
        + `约 ${m.ctx.tokens_est} token，`
        + (m.ctx.truncated ? '已截断（保序等距抽样）' : '未截断'),
        `管线：独立课件答疑（不检索 / 不用提示词）· 模型 ${m.ctx.model}`
        + ` · 思考强度 ${m.ctx.reasoning_effort}`
        + ` · 上下文预算 ${m.ctx.tokens_budget} token`] : []);
  const tip = document.querySelector('[data-dkmsg="' + i + '"]');
  try {
    const r = await api('/api/note/deck', {method:'POST',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify({doc_id: DKCHAT.docId, doc_title: DKCHAT.title,
        question: q, answer: m.content, refs})});
    if (r.error) throw new Error(r.error);
    m.saved = r.file;
    if (tip) tip.textContent = '已记入 ' + r.file;
    toast('已记入「笔记」页签：' + r.file);
  } catch(e){
    if (tip) tip.textContent = '记入失败：' + e.message;
  }
}

// 节点类型的中文名：徽标文案与"没有知识点"的说法都靠它，别散在各处写死。
// `downshift` 只改父节点页那一档的说法（卡 C-0045 起是"下放"）；
// **默认取旧说法**——这个函数被 `tools/check_mindmap_kp.py` 单独抠去 node 里跑，
// 那时没有 MINDMAP 可读，不能让它依赖全局状态。
function mmKindLabel(kind, downshift){
  return {leaf: '末级节点 · 知识点总结', pending: '末级节点 · 待生成',
          parent_page: downshift ? '父节点页 · 内容已下放' : '父节点页 · 本页不建知识点',
          e1: '非教学页',
          category: '分类节点', root: '根节点', none: '节点',
          r1: '三级节点 · R1 知识点', r2: '浅层节点 · R2 兜底知识点',
          lv4: '四级节点'}[kind] || '节点';
}

// ---------------- 导图节点 → 末级知识点总结小窗 ----------------
// 复用上面 evPop 那一套（同一个 .evpop 小窗、同一套 Esc/点外/滚动关闭），
// **不另造弹窗组件**：同一时刻只有一个小窗，连点不同节点就是就地换内容。
//
// 内容分两段取：树接口只内联标记（lkp_id / lkp_ready），点开时才去
// /api/summary-kp 拿总结正文——68 条总结正文不进树接口，免得拖慢首屏。
// 弹窗展示的是**提炼后的总结**（要点 + 正文 + 出处），不展示原文块：
// 人已拍板"知识点给总结，不贴原文"；要看原文就点出处里的 chunk_id 跳上下文。
//
// 小窗当前挂着哪个知识点，标记写在小窗自己身上（EVPOP.dataset.kp）：
// 这样"用户关掉小窗""改点无知识点的节点""出处弹窗顶掉它"三种情况下，
// 迟到的 /api/summary-kp 响应都能就地作废——否则点开节点后立刻 Esc，
// 慢一点的响应回来会把小窗重新弹出来；先点 A 再点 B，A 的响应也会盖掉 B。
//
// 卡 C-0036 的交互（人点名要的四件事）：
//   1. 正文区自己带滚动条：靠 CSS 的 .evpop .pbody{flex:1;min-height:0}，
//      而 evPopScroll 早判过"target 在弹窗里就不关窗"（见那里的注释）；
//   2. 默认**只显示要点**；总结正文 / 出处明细 / 生成链条收进 <details>，
//      点「▸ 展开：…」才出来，可再收起。**换知识点就重置回折叠**——
//      那屏是"上一条的详情"，留着展开会让人以为下一条也长这样；
//      而课件展开是"对照模式"，反而要跨知识点延续（见下）；
//   3. 左下「下一知识点」：顺序 = 导图树的先序（与 mmNodes 渲染的上下顺序一致），
//      **由后端给**（/api/summary-kp 的 next_id / order_index / order_total），
//      前端只负责跳，绝不自己排。首/末条策略：prev/next 是空串就**置灰**，
//      不做循环——从末条绕回第一条会让人以为"还有下一条"，比点不动更坏；
//   4. 右下「展开当页课件」：取 logs/figure_desc/<deck>/slide_<页号>.png
//      （走看板自己的 /img/slide 路由，只放行这一个目录、这一种文件名）。
//      已展开时点「下一知识点」，课件**跟着切到新知识点那一页**：
//      状态记在 EVPOP.dataset.deck 上，新内容渲染完自动重新展开。
//      多页知识点：给一排页号（p.15 / p.16 …），默认落在第一个**有图**的页，
//      点页号换页；没有图的页号标灰并写明"没有课件图缓存"（不静默给错页）。
//
// 就地读写、不抽成小函数：`tools/check_mindmap_kp.py` 是按函数名抠源码去
// node 里跑的，多一个函数就多一处要在那份清单里登记。
// （C-0036 新增的 mmNextKp / mmShowSlide / mmToggleDeck 是弹窗交互自己的
//  控制流，由 `cards/C-0036/verify_c0036_kp_popup.py` 一并抠出来跑。）
const MMPOP = {kp: null, anchor: null, page: 0, docId: 0};

// 有总结的节点：先占位，再去取总结。
// `keepDeck`：这次打开要不要**延续课件展开状态**——只有「下一知识点」
// 切过来才为 true（见 mmNextKp）。用户从导图点节点永远是 false：
// 换一条知识点就从"只看要点"重新开始。
// `docId`（卡 C-0055）：这次要读**哪份课件**的产物。缺省（不传/0）照旧用页签
// 当前选中的那份（`MINDMAP.docId`）——原有调用方一个字节都不用改；从问答页的
// **出处小窗**跳过来时必须显式给，因为出处那份资料未必是页签里选中的那份。
async function mmOpenKp(kpId, name, el, keepDeck, docId){
  if (!kpId) return;
  const did = docId || MINDMAP.docId;
  const pop = evPopEl();
  pop.dataset.kp = kpId;
  if (!keepDeck) pop.dataset.deck = '';
  MMPOP.anchor = el;
  MMPOP.docId = did;
  evPopMount(el, `<div class="ph"><div class="src">
      <div class="loc">${esc(name || kpId)}</div>
      <div class="hdg">正在读取知识点总结…</div>
    </div><button class="pclose" onclick="evPopClose()" title="关闭（Esc）">✕</button></div>
    <div class="pbody"><div class="small muted">加载中…</div></div>`);
  // 卡 C-0056：这一屏（"正在读取知识点总结…"）也是弹窗，人等接口时照样会滚它——
  // 防线先挂上，别让"加载中"那一段成为唯一还能把滚动漏给外层的窗口期。
  mmKpScrollGuard(pop);
  let d;
  try {
    d = await api('/api/summary-kp?doc_id=' + encodeURIComponent(did) +
                  '&kp_id=' + encodeURIComponent(kpId));
  } catch(e){
    // 期间用户又点了别的节点（或关掉了小窗）：这次结果作废，别盖掉新内容
    if ((evPopEl().dataset.kp || '') !== kpId) return;
    evPopMount(el, `<div class="ph"><div class="src">
        <div class="loc">知识点 ${esc(kpId)} 读取失败</div>
        <div class="hdg">${esc(e.message)}</div>
      </div><button class="pclose" onclick="evPopClose()" title="关闭（Esc）">✕</button></div>`);
    return;
  }
  if ((evPopEl().dataset.kp || '') !== kpId) return;
  mmRenderKp(d, el, !!keepDeck);
}

// 出处：页 + chunk_id（可点，跳"看上下文"）。跨页块的页码是区间字符串，
// 照原样显示——写死成"当前页"会指错页（见 提示词-知识点总结.md §3#17）。
function mmLkpSrcHtml(srcs){
  const list = (srcs || []).filter(s => s && (s.chunk_ids || []).length);
  if (!list.length){
    return `<div class="small muted">这条没有给出处（模型没写出 sources）。</div>`;
  }
  return `<div class="lkpsrcs">` + list.map(s =>
    `<span class="lkpsrc">p.${esc(s.page)}${s.figure_desc ? ' · 含图片理解' : ''} · ${
      (s.chunk_ids || []).map(c => `<span class="cid" data-chunk="${esc(c)}"
        title="点开看这个块的上下文">chunk ${esc(c)}</span>`).join('、')}</span>`
  ).join('') + `</div>`;
}

// 弹窗正文（卡 C-0036 重排）：头部 = 名字 + kp_id + 层级 + 导图路径；
// **默认只有"出处一行 + 要点列表"**；总结正文 / 出处明细 / 生成链条收进
// <details>（默认折叠，点标题行展开、可再收起）；底部固定一行两个按钮。
// keepDeck=true 时渲染完自动把课件区展开（「下一知识点」带着课件切过来）。
function mmRenderKp(d, el, keepDeck){
  MMPOP.kp = d;
  MMPOP.anchor = el;
  MMPOP.page = 0;          // 换了知识点：课件回到"第一个有图的页"
  const pts = (d.points || []);
  const nMat = (d.material_block_ids || []).length;
  const slides = (d.slides || []);
  const nFig = slides.filter(s => s.ok).length;
  const seqTip = d.order_total
    ? `导图上第 ${d.order_index} / ${d.order_total} 条知识点` : '这条不在导图顺序里';
  // 卡 C-0056：上一 / 下一对称。邻居照旧**由后端给**（`prev_id`/`next_id`，
  // 见 /api/summary-kp 的 _lkp_seq），前端一个字都不重排：首条没有 prev_id、
  // 末条没有 next_id，两处都只是把按钮置灰（点不动 > 跳到打不开的知识点）。
  const prevBtn = d.prev_id
    ? `<button class="ghost" id="mmkp-prev" data-prev="${esc(d.prev_id)}"
         title="上一个：${esc(d.prev_name || d.prev_id)}（${esc(seqTip)}）">◀ 上一知识点</button>`
    : `<button class="ghost" id="mmkp-prev" disabled
         title="已经是第一个知识点（${esc(seqTip)}）">◀ 上一知识点</button>`;
  const nextBtn = d.next_id
    ? `<button class="ghost" id="mmkp-next" data-next="${esc(d.next_id)}"
         title="下一个：${esc(d.next_name || d.next_id)}（${esc(seqTip)}）">下一知识点 ▶</button>`
    : `<button class="ghost" id="mmkp-next" disabled
         title="已经是最后一个知识点（${esc(seqTip)}）">下一知识点 ▶</button>`;
  // 卡 C-0056：这行小字的数字来自 `/api/summary-kp` 的 `note_count`
  // （后端口径 = 这个弹窗的「查看笔记」列表），所以**不会为它多发一次请求**。
  // 0 条也照常显示：不然"没有这行字"会被读成"这窗不支持笔记"，
  // 恒显示顺带把「还没有笔记 → 点【记入笔记】写第一条」这条路指出来。
  const nNotes = Math.max(0, parseInt(d.note_count || 0, 10) || 0);
  const noteTip = `已绑定 ${nNotes} 条笔记` + (nNotes
    ? ' · 点【查看笔记】展开' : ' · 点【记入笔记】写第一条');
  const deckTitle = nFig
    ? '展开这一页的课件大图（图可点开原尺寸）'
    : '这个知识点对应的页没有课件图缓存';
  const html = `
    <div class="ph">
      <div class="src">
        <div class="loc">${esc(d.name || d.kp_id || '')}
          <span class="badge">${esc(d.kp_id || '')}</span>
          <span class="small muted">末级知识点 · 第 ${esc(d.level || '?')} 层</span></div>
        <div class="hdg">${esc((d.path || []).join(' › ') || d.node_name || '')}</div>
      </div>
      <button class="pclose" onclick="evPopClose()" title="关闭（Esc）">✕</button>
    </div>
    <div class="pbody" id="mmkp-body">
      <div class="small muted" style="margin-bottom:9px">
        出处：${esc(d.pages_label || '')} · doc#${esc(d.doc_id)}${
          nMat ? ` · 材料 ${nMat} 块（正文 ${d.n_body_blocks || 0} / 识图 ${
            d.n_fig_blocks || 0}）${d.material_chars ? ' / ' + d.material_chars + ' 字' : ''}` : ''}${
          d.insufficient ? ' · <span class="badge warn">材料不足</span>' : ''}
      </div>
      ${d.merged ? `<div class="small" style="margin-bottom:9px">
        <span class="badge">合并 ${(d.pages || []).length} 页</span>
        这一条由 ${esc(d.pages_label || '')} 合并而成：${
          esc(d.merge_reason || '（模型未给出合并理由）')}${
        d.merge_rejected_reason
          ? `<br><span style="color:var(--warn)">管线校验：${esc(d.merge_rejected_reason)}</span>`
          : ''}
      </div>` : ''}
      <div class="lkpsub" style="margin-top:0;border-top:none;padding-top:0">要点${
        pts.length ? ' ' + pts.length + ' 条' : ''}</div>
      ${pts.length
        ? `<ul class="lkppts">${pts.map(x => `<li>${esc(x)}</li>`).join('')}</ul>`
        : `<div class="small muted">${d.insufficient
             ? '模型判定本页材料不足以概括（' + esc(d.insufficient_reason || '') +
               '），按提示词口径不给要点。'
             : '这条没有要点。'}</div>`}
      <details class="kpmore" id="mmkp-more">
        <summary>总结正文 · 出处明细 · 生成链条</summary>
        <div class="lkpsum${d.summary ? '' : ' none'}">${
          esc(d.summary || '（这条没有总结正文）')}</div>
        <div class="lkpsub">出处（页 / chunk_id，点 chunk 看上下文）</div>
        ${mmLkpSrcHtml(d.sources)}
        <div class="lkpsub">这条总结是怎么来的</div>
        <div class="lkpchain">材料 = 该节点覆盖页的正文块 + 识图块（图片理解）${
          (d.figure_pages || []).length
            ? '，其中含图片理解的页：' + d.figure_pages.map(p => 'p.' + p).join('、') : ''}；
          由 ${esc(d.model || 'deepseek-flash')} 提炼${
          d.source_card ? `（产出卡 ${esc(d.source_card)}` +
            (d.prompt_source ? ` · 提示词 ${esc(d.prompt_source)}` : '') + '）' : ''}，
          本条成本 CNY${(d.cost_cny || 0).toFixed(6)}${
          d.generated_at ? ' · ' + esc(d.generated_at) : ''}。</div>
      </details>
      <div class="kpslide" id="mmkp-slide" hidden>
        <div class="small muted">课件页图 · ${
          esc(d.slide_deck || '该课件在 figure_desc 下没有目录')}${
          slides.length ? ` · 本知识点覆盖 ${slides.length} 页，其中 ${nFig} 页有图` : ''}</div>
        <div class="kppages" id="mmkp-pages">${slides.map(s =>
          `<span class="kppage${s.ok ? '' : ' off'}" data-page="${esc(s.page)}"
            title="${s.ok ? '看 p.' + esc(s.page) + ' 的课件图'
                         : 'p.' + esc(s.page) + '：没有课件图缓存'}">p.${esc(s.page)}</span>`
        ).join('')}</div>
        <div id="mmkp-figbox"></div>
      </div>
      <!-- 卡 C-0052：笔记区（默认收起）。渲染阶段不取数——点按钮才请求，
           省掉一次"打开弹窗先等网络"；两个容器互斥展开（见 mmNoteEdit/mmNoteList）。 -->
      <div id="mmkp-noteedit" hidden style="margin-top:10px"></div>
      <div id="mmkp-notelist" hidden style="margin-top:10px"></div>
    </div>
    <div class="pf">
      ${prevBtn}
      ${nextBtn}
      <span class="pmeta">${esc(seqTip)}</span>
      <span class="pmeta" id="mmkp-notecount"
        title="这条知识点绑定的笔记条数（与「查看笔记」列出来的一致）">${
        esc(noteTip)}</span>
      <span style="flex:1"></span>
      <button class="ghost" id="mmkp-note"
        title="给这条知识点写一条笔记（绑定 ${esc(d.kp_id || '')}）">记入笔记</button>
      <button class="ghost" id="mmkp-notes"
        title="看与这条知识点绑定的笔记">查看笔记</button>
      <button class="ghost" id="mmkp-search">在资料库中检索此主题</button>
      <button class="ghost" id="mmkp-deck" title="${esc(deckTitle)}">展开当页课件</button>
    </div>`;
  evPopMount(el, html);
  // ★ 卡 C-0042：点「▸ 展开：总结正文 · 出处明细 · 生成链条」也会让内容变高
  //   （同一类"尺寸变了位置没跟着变"的越界），所以折叠体一开一合也重新兜一次。
  const more = $('#mmkp-more');
  if (more) more.addEventListener('toggle', () => evPopPlace(MMPOP.anchor || evPopEl()));
  // 「上一知识点」/「下一知识点」：跳后端给的 prev_id / next_id
  // （首/末条在 HTML 里就是 disabled，这里也不给它挂 onclick）
  const pb = $('#mmkp-prev');
  if (pb && d.prev_id) pb.onclick = () => mmPrevKp();
  const nb = $('#mmkp-next');
  if (nb && d.next_id) nb.onclick = () => mmNextKp();
  // 右下「展开当页课件」：展开/收起课件图区
  const db = $('#mmkp-deck');
  if (db) db.onclick = () => mmToggleDeck();
  // 页号：有图的才可点（没图的页号灰着，点了也不会换错页）
  document.querySelectorAll('#mmkp-pages .kppage').forEach(chip => {
    if (chip.className.indexOf('off') >= 0) return;
    chip.onclick = () => mmShowSlide(MMPOP.kp, parseInt(chip.dataset.page));
  });
  // 原检索能力不丢：只是不再"默认跳走"，要点这个按钮才去检索
  $('#mmkp-search').onclick = () => { const nm = d.name; evPopClose(); doSearch(nm); };
  document.querySelectorAll('.lkpsrc .cid').forEach(b => {
    b.onclick = () => { const c = parseInt(b.dataset.chunk); evPopClose(); openChunk(c); };
  });
  // 卡 C-0052：知识点窗口的笔记。两个按钮都在这一屏里就地展开（不新开浮层：
  // 全页只有一个小窗，见 evPop 的说明），写入的是 notes/ 下的 markdown。
  const nAdd = $('#mmkp-note');
  if (nAdd) nAdd.onclick = () => mmNoteEdit(d);
  const nSee = $('#mmkp-notes');
  if (nSee) nSee.onclick = () => mmNoteList(d);
  // 联动：上一条开着课件，这一条接着开（人对着 PPT 连看是最常见的用法）
  if (keepDeck) mmToggleDeck();
  // 卡 C-0056：挂上"弹窗内怎么滚都不出窗"的两道防线（幂等，见 mmKpScrollGuard）
  mmKpScrollGuard(evPopEl());
}

// ---------------- 知识点窗口的笔记（卡 C-0052） ----------------
// 人拍板：「在点击思维导图的知识点跳出的知识点窗口增加一个『记入笔记』的按钮……
// 该笔记与知识点窗口绑定。同时增加一个『查看笔记』的按钮……笔记页签也会出现
// 相应的笔记条目。」
//
// 存储**复用既有的笔记机制**（notes/ 下的 markdown，见 core/study.py::save_note）：
// 绑定写在 front-matter 的 kp_id/doc_id 里，不新建库表——正文与来源分开存必然
// 不同步，而「笔记」页签与 MCP 的 kb_note_* 读的正是这批文件。
// 这里只做三件事：展开输入框、写一条、按 kp_id 反查列出。
//
// 尺寸变化必须重新定位：弹窗是 position:fixed，展开/收起笔记区会改变高度
// （同「展开当页课件」的道理，见 evPopPlace）。
function mmNotePlace(){
  evPopPlace(MMPOP.anchor || evPopEl());
}

// 「记入笔记」：再点一次＝收起（按钮是开关，不是"又开一个框"）
function mmNoteEdit(d){
  const box = $('#mmkp-noteedit'); if (!box) return;
  const list = $('#mmkp-notelist');
  if (list){ list.hidden = true; list.innerHTML = ''; }
  if (!box.hidden){ box.hidden = true; box.innerHTML = ''; mmNotePlace(); return; }
  box.hidden = false;
  box.innerHTML = `
    <div class="lkpsub" style="margin-top:0">记入笔记 · 绑定知识点 ${
      esc(d.kp_id || '')}${d.name ? '（' + esc(d.name) + '）' : ''}</div>
    <textarea id="mmkp-notebody" style="width:100%;min-height:84px;resize:vertical"
      placeholder="写这条知识点的笔记…保存后落在 notes/ 下，并出现在「笔记」页签（条目里会写明它绑定的是这条知识点）"></textarea>
    <div class="row" style="margin-top:8px">
      <button class="act" id="mmkp-notesave">保存笔记</button>
      <button class="ghost" id="mmkp-notecancel">取消</button>
      <span class="small muted" id="mmkp-notemsg"></span>
    </div>`;
  const ta = $('#mmkp-notebody');
  if (ta) ta.focus();
  const cancel = $('#mmkp-notecancel');
  if (cancel) cancel.onclick = () => { box.hidden = true; box.innerHTML = ''; mmNotePlace(); };
  const save = $('#mmkp-notesave');
  if (save) save.onclick = () => mmNoteSave(d);
  mmNotePlace();
}

async function mmNoteSave(d){
  const ta = $('#mmkp-notebody');
  const msg = $('#mmkp-notemsg');
  const btn = $('#mmkp-notesave');
  const body = ta ? ta.value.trim() : '';
  if (!body){ if (msg) msg.textContent = '先写点什么再保存。'; return; }
  if (btn){ btn.disabled = true; btn.textContent = '保存中…'; }
  try {
    const r = await api('/api/note/kp', {method:'POST',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify({kp_id: d.kp_id, kp_name: d.name || d.kp_id,
        doc_id: d.doc_id, body,
        refs: [((d.pages_label || '') + ' · doc#' + d.doc_id).replace(/^ · /, '')]})});
    if (r.error) throw new Error(r.error);
    if (msg) msg.textContent = '已记入：' + r.file;
    if (ta) ta.value = '';
    toast('笔记已绑定知识点 ' + (d.kp_id || '') + '：' + r.file);
    // 卡 C-0056：刚写下的这条一定绑定当前知识点 → 底部「已绑定 N 条笔记」就地 +1，
    // 不用为一个数字再跑一趟接口（重新打开弹窗时以后端计数为准，两处同源，
    // 见 api_summary_kp 的 note_count）。
    const nc = $('#mmkp-notecount');
    const mn = nc ? /已绑定 (\d+) 条笔记/.exec(nc.textContent || '') : null;
    if (nc && mn) {
      nc.textContent = `已绑定 ${parseInt(mn[1], 10) + 1} 条笔记 · 点【查看笔记】展开`;
    }
  } catch(e){
    if (msg) msg.textContent = '保存失败：' + e.message;
  } finally {
    if (btn){ btn.disabled = false; btn.textContent = '保存笔记'; }
  }
}

// 「查看笔记」：列出**绑定这条知识点**的笔记（正文一并带回——小窗里点开一条
// 笔记不该再跳一次网络；超长的按 MAX_NOTE_INLINE 截断，全文去「笔记」页签看）
async function mmNoteList(d){
  const box = $('#mmkp-notelist'); if (!box) return;
  const edit = $('#mmkp-noteedit');
  if (edit){ edit.hidden = true; edit.innerHTML = ''; }
  if (!box.hidden){ box.hidden = true; box.innerHTML = ''; mmNotePlace(); return; }
  box.hidden = false;
  box.innerHTML = '<div class="small muted">读取笔记…</div>';
  mmNotePlace();
  let r;
  try {
    r = await api('/api/notes/by_kp?kp_id=' + encodeURIComponent(d.kp_id || '') +
                  '&doc_id=' + (d.doc_id || 0));
  } catch(e){
    box.innerHTML = `<div class="small muted">读取失败：${esc(e.message)}</div>`;
    mmNotePlace(); return;
  }
  const notes = (r && r.notes) || [];
  if (!notes.length){
    box.innerHTML = `<div class="lkpsub" style="margin-top:0">这条知识点的笔记</div>
      <div class="small muted">还没有笔记。点【记入笔记】写第一条——它会绑定到 ${
        esc(d.kp_id || '')}，并出现在「笔记」页签。</div>`;
    mmNotePlace(); return;
  }
  box.innerHTML = `<div class="lkpsub" style="margin-top:0">这条知识点的笔记 · ${
      notes.length} 条</div>` + notes.map((n, i) => `
    <div class="hit" style="margin-bottom:8px">
      <div class="cite">${esc(n.title || n.file)}</div>
      <div class="why">${fmtTime(n.created || n.mtime)} · ${esc(n.file)}${
        (n.body_truncated ?? n.truncated)
          ? ' · 正文较长，这里只显示开头，全文去「笔记」页签看' : ''}</div>
      <pre style="max-height:30vh;overflow:auto">${esc(n.body ?? n.content ?? '')}</pre>
      <div class="row" style="margin-top:6px">
        <button class="ghost" data-mmkpedit="${i}"
          title="改这篇笔记的正文（front-matter 与「## 出处」段原样保留）">编辑正文</button>
      </div>
    </div>`).join('');
  // 卡 C-0082：「编辑正文」进编辑态。绑定用**下标**而不是文件名——
  // 文件名里可能有引号/中文，塞进 HTML 属性里反而容易出错。
  box.querySelectorAll('button[data-mmkpedit]').forEach(b => {
    b.onclick = () => mmNoteEditOpen(d, notes[parseInt(b.dataset.mmkpedit, 10)]);
  });
  mmNotePlace();
}

// 卡 C-0082：在知识点窗口里**直接改**一条笔记的正文。
// ⚠ 进编辑态前必须再取一次全文（`GET /api/note`）：上面列表里的 `body` 是按
// `MAX_NOTE_INLINE` 截断过的，拿截断的文本回写会把正文尾部**永久砍掉**。
async function mmNoteEditOpen(d, n){
  const box = $('#mmkp-noteedit'); if (!box || !n) return;
  const list = $('#mmkp-notelist');
  // 两个容器互斥（同 mmNoteEdit / mmNoteList）：开编辑就收起列表，
  // 否则两块内容叠在一起、弹窗高度也算不准。
  if (list){ list.hidden = true; list.innerHTML = ''; }
  box.hidden = false;
  box.innerHTML = '<div class="small muted">读取笔记全文…</div>';
  mmNotePlace();
  let r;
  try {
    r = await api('/api/note?name=' + encodeURIComponent(n.file || ''));
  } catch(e){
    box.innerHTML = `<div class="small muted">读取失败：${esc(e.message)}</div>`;
    mmNotePlace(); return;
  }
  if (r.error){
    box.innerHTML = `<div class="small muted">读取失败：${esc(r.error)}</div>`;
    mmNotePlace(); return;
  }
  // 优先用 body（剥过壳）；后端万一没给就回落 content（宁可多显示几行机器壳，
  // 也不能让人在"看不到内容"的框里把正文覆盖成空）
  const full = (r.body ?? r.content ?? '');
  const mt = ((r.note || {}).mtime ?? n.mtime ?? 0);
  box.innerHTML = `
    <div class="lkpsub" style="margin-top:0">修改笔记正文 · ${esc(n.file || '')}</div>
    <div class="small muted" style="margin-bottom:6px">只改正文：front-matter
      （绑定知识点 / 出处 / 记录时间）与末尾的「## 出处」段原样保留，改完仍能从
      这里跳回知识点。</div>
    <textarea id="mmkp-notebody" style="width:100%;min-height:160px;resize:vertical"
      placeholder="改这篇笔记的正文…">${esc(full)}</textarea>
    <div class="row" style="margin-top:8px">
      <button class="act" id="mmkp-notesave">保存修改</button>
      <button class="ghost" id="mmkp-notecancel">取消</button>
      <span class="small muted" id="mmkp-notemsg"></span>
    </div>`;
  const ta = $('#mmkp-notebody');
  if (ta) ta.focus();
  const cancel = $('#mmkp-notecancel');
  if (cancel) cancel.onclick = () => {
    box.hidden = true; box.innerHTML = ''; mmNotePlace();
  };
  const save = $('#mmkp-notesave');
  if (save) save.onclick = () => mmNoteUpdate(d, n, mt);
  mmNotePlace();
}

async function mmNoteUpdate(d, n, mtime){
  const box = $('#mmkp-noteedit');
  const ta = $('#mmkp-notebody');
  const msg = $('#mmkp-notemsg');
  const btn = $('#mmkp-notesave');
  const body = ta ? ta.value : '';
  if (!body.trim()){ if (msg) msg.textContent = '正文不能是空的。'; return; }
  if (btn){ btn.disabled = true; btn.textContent = '保存中…'; }
  try {
    const r = await api('/api/note/update', {method:'POST',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify({file: n.file, body, mtime})});
    if (r.error) throw new Error(r.error);
    if (box){ box.hidden = true; box.innerHTML = ''; }
    toast('笔记已更新：' + (r.file || n.file));
    // 卡 C-0056 的写法：底部「已绑定 N 条笔记」就地同上限同步（编辑不改条数，
    // 但文案要跟着重算一遍，别让两处口径分家）
    const nc = $('#mmkp-notecount');
    const mn = nc ? /已绑定 (\d+) 条笔记/.exec(nc.textContent || '') : null;
    if (nc && mn) {
      nc.textContent = `已绑定 ${parseInt(mn[1], 10)} 条笔记 · 点【查看笔记】展开`;
    }
    await mmNoteReload(d);
  } catch(e){
    // 409（文件在别处被改过）也走到这里：原话就是后端写的那句"刚在别处被改过"，
    // 不吞掉、不换个说法
    if (msg) msg.textContent = '保存失败：' + e.message;
  } finally {
    if (btn){ btn.disabled = false; btn.textContent = '保存修改'; }
  }
}

// 保存后回到列表态并把刚改的内容读回来。`mmNoteList` 是"再点一次收起"的开关，
// 直接再调一次会把列表关掉，所以先归位成"收起"再让它展开（顺带清掉编辑态）。
async function mmNoteReload(d){
  const box = $('#mmkp-notelist');
  if (box){ box.hidden = true; box.innerHTML = ''; }
  await mmNoteList(d);
}

// 「下一知识点」（卡 C-0036）：跳导图先序里的下一个。
// next_id 是**后端算好**的（/api/summary-kp），前端一个字都不重排。
// 已展开课件时把展开状态带过去：换个知识点就让人再点一次「展开当页课件」，
// 等于把"连看几张"这件事打断。
async function mmNextKp(){
  const d = MMPOP.kp;
  if (!d || !d.next_id) return;
  const keep = (evPopEl().dataset.deck || '') === '1';
  // 卡 C-0055：这一链是**同一份课件**内的顺序，docId 跟着当前弹窗走
  // （从问答页的出处小窗跳过来的那一条也一样，见 mmOpenKp 的 docId）。
  await mmOpenKp(d.next_id, d.next_name || '', MMPOP.anchor, keep, MMPOP.docId);
}

// 「上一知识点」（卡 C-0056）：与 mmNextKp **完全对称**——同一条先序链上的
// prev，顺序同样由后端算好（`/api/summary-kp` 的 `prev_id`/`prev_name`，
// 见 `_lkp_seq`），前端一个字都不重排。已展开课件时照样把展开状态带过去：
// 人是在"对着 PPT 连着看几张"，往返一次就把这个动作打断了。
async function mmPrevKp(){
  const d = MMPOP.kp;
  if (!d || !d.prev_id) return;
  const keep = (evPopEl().dataset.deck || '') === '1';
  await mmOpenKp(d.prev_id, d.prev_name || '', MMPOP.anchor, keep, MMPOP.docId);
}

// ---------------- 弹窗内怎么滚都不出窗（卡 C-0056） ----------------
// 人报（2026-09-29 原话）：「知识点窗口的最右侧滑动条滑动到最顶部后，如果继续
// 滑动，知识点窗口会消失，并且整个网页最右边的滑动条会滑动。这个问题需要解决。
// 我希望打开知识点窗口后在知识点窗口内不论怎么滑动，知识点窗口都不会消失。」
//
// 病根是**滚动链**（scroll chaining），两个症状是同一个病根的先后两步：
//   ① `.pbody` 滚到边界后，浏览器把这次滚动剩下的量交给祖先 → 外层文档跟着滚
//      （人看到的"整个网页最右边的滑动条会滑动"）；
//   ② 外层这一滚，window 上那个**捕获阶段**的 scroll 监听（evPopScroll）就收到一个
//      target 不在弹窗里的事件，于是按"滚动即关窗"的老规矩把小窗关掉
//      （人看到的"知识点窗口会消失"）。
// 所以治法是"到边界就别再往上滚"，不是"别关窗"——关窗机制本身是各处共用的。
//
// 两道防线，都只挂在知识点弹窗这一侧（不碰 EVPOP 的关闭/定位机制）：
//   ① `overscroll-behavior:contain` 加在正文滚动区上：从根上断掉滚动链，
//      连触摸惯性一并管住，而且**不动原生滚动的手感**（惯性、平滑都在）。
//      它管的是 JS 判断不到的那一类：一次滚轮量跨过边界的"半程事件"
//      （离底还有 30px 时滚 100px，剩下 70px 原本会链给外层）。
//   ② 显式拦 wheel / touchmove：**只在当前方向上已经滚到头**时 preventDefault，
//      这是"到顶/到底后继续滚"的正对治法。还有余量时一个字都不拦——
//      弹窗里的正文、课件图、笔记照常滚。
//      ⚠ 监听器必须显式 `{passive:false}`：passive 的监听器里 preventDefault
//      会被浏览器直接忽略，那样这道防线看着在、其实一点用没有。
//
// 只对**知识点弹窗**生效（`dataset.kp` 非空，见 mmOpenKp）：问答页的出处小窗
// （卡 C-0055）保持原样"滚到外面就关"，行为一个字节都没改。
function mmKpScrollHost(node, pop, dy){
  // 从事件目标往上找最近的、**在这个方向上还有余量**的滚动容器；没有就返回 null
  for (let el = node; el && el !== pop; el = el.parentElement){
    if (el.nodeType !== 1) break;
    const oy = String(window.getComputedStyle(el).overflowY || '');
    if ((oy === 'auto' || oy === 'scroll' || oy === 'overlay') &&
        el.scrollHeight > el.clientHeight + 1){
      const max = el.scrollHeight - el.clientHeight;
      // 1px 容差：缩放 / 高分屏下 scrollTop 是小数，"到底没到底"要判得稳
      if (dy < 0 ? el.scrollTop > 1 : el.scrollTop < max - 1) return el;
    }
  }
  return null;
}

function mmKpWheel(e){
  const pop = evPopEl();
  if (!pop.dataset.kp || !pop.contains(e.target)) return;  // 不是知识点弹窗：不插手
  const dy = e.deltaY || 0;
  if (!dy) return;                       // 横向或无位移：原样放行
  if (mmKpScrollHost(e.target, pop, dy)) return;   // 还没到头：交给浏览器原生滚
  if (e.cancelable) e.preventDefault();            // 已经到头：拦住，别往祖先滚
}

function mmKpTouchStart(e){
  // 手指位置要自己记：touchmove 只给当前位置，方向得跟起点比
  MMPOP.touchY = (e.touches && e.touches[0]) ? e.touches[0].clientY : 0;
}

function mmKpTouchMove(e){
  const pop = evPopEl();
  if (!pop.dataset.kp || !pop.contains(e.target)) return;
  const t = e.touches && e.touches[0];
  if (!t) return;
  const dy = (MMPOP.touchY || 0) - t.clientY;   // 手指上滑 = 内容往上走
  MMPOP.touchY = t.clientY;
  if (!dy) return;
  if (mmKpScrollHost(e.target, pop, dy)) return;   // 还有余量：让它原生滚
  if (e.cancelable) e.preventDefault();            // 到头了：拦住
}

// 幂等：弹窗元素是全页复用的一个单例（见 evPopEl），挂一次就够。
// 正文区每次开窗都会重建，所以 overscroll-behavior 每次都要重设。
function mmKpScrollGuard(pop){
  const body = pop.querySelector('.pbody');
  if (body) body.style.overscrollBehavior = 'contain';
  if (pop.dataset.mmKpGuard === '1') return;
  pop.dataset.mmKpGuard = '1';
  pop.addEventListener('wheel', mmKpWheel, {passive: false});
  pop.addEventListener('touchstart', mmKpTouchStart, {passive: true});
  pop.addEventListener('touchmove', mmKpTouchMove, {passive: false});
}

// 课件图区：选页 + 放图。找不到图就**明说**（哪一页、哪个目录没有缓存），
// 绝不给别的页的图充数——张冠李戴比没图更坏。
function mmShowSlide(d, page){
  const box = $('#mmkp-figbox'); if (!box || !d) return;
  const has = (d.slides || []).filter(s => s.ok);
  if (!has.length){
    box.innerHTML = `<div class="small muted">该页没有课件图缓存${
      d.slide_deck
        ? `（logs/figure_desc/${esc(d.slide_deck)}/ 下没有对应的 slide_&lt;页号&gt;.png）`
        : '（这份课件在 logs/figure_desc/ 下没有目录）'}。其他内容照常可看。</div>`;
    return;
  }
  const pick = has.some(s => s.page === page) ? page : has[0].page;
  MMPOP.page = pick;
  const url = '/img/slide?doc_id=' + encodeURIComponent(d.doc_id) + '&page=' + pick;
  box.innerHTML = `<img class="kpslideimg" src="${url}" alt="p.${esc(pick)} 课件页图"
      title="点图在新窗口打开原尺寸"><div class="small muted" style="margin-top:6px">
      p.${esc(pick)} · 点图可看原尺寸</div>`;
  const img = box.querySelector('.kpslideimg');
  if (img){
    img.onclick = () => window.open(url, '_blank');
    // ★ 卡 C-0042：图是异步加载的——写进 HTML 的这一刻它还没有内在尺寸，
    //   弹窗高度要等图解码完才涨到 `.kpslideimg{width:100%;max-height:52vh}`
    //   那么大。涨高之后必须**重新定位**（居中 + 兜边界），否则底部那一行
    //   会被顶出视口，「下一知识点」就点不到了——人报的"展开原图时有几率
    //   整个窗口有部分跑到屏幕外"就发生在这一步之间。
    const reflow = () => evPopPlace(MMPOP.anchor || evPopEl());
    img.onload = reflow;
    img.onerror = reflow;
    // 已经在缓存里时 load 不会再触发，补量一次（complete 对有 src 的 img 可靠）
    if (img.complete) reflow();
  }
  document.querySelectorAll('#mmkp-pages .kppage').forEach(b => {
    b.classList.toggle('on', parseInt(b.dataset.page) === pick);
  });
}

// 右下「展开当页课件」：展开/收起课件图区。
// 展开时给弹窗加 .deck-open（更宽更高）并**重新算一次位置**——弹窗是
// position:fixed，尺寸一变就得重新兜回视口内（见 evPopPlace）。
function mmToggleDeck(){
  const box = $('#mmkp-slide'); if (!box) return;
  const pop = evPopEl();
  const open = !!box.hidden;            // 现在藏着 → 这次是"展开"
  box.hidden = !open;
  pop.dataset.deck = open ? '1' : '';
  pop.classList.toggle('deck-open', open);
  const btn = $('#mmkp-deck');
  if (btn) btn.textContent = open ? '收起课件图' : '展开当页课件';
  if (open) mmShowSlide(MMPOP.kp, MMPOP.page || 0);
  evPopPlace(MMPOP.anchor || pop);
}

// 末级节点但总结还没到位（数据文件缺失、正在生成、或接口降级）。
// 这一屏必须与"本页按当前口径不建知识点"区分开：这个节点**是该有知识点的**，
// 缺的只是那份总结——所以说"待生成"，并告诉他数据文件在哪。
function mmOpenPending(n, el){
  evPopMount(el, `
    <div class="ph">
      <div class="src">
        <div class="loc">末级节点「${esc(n.name || '')}」
          <span class="badge warn">待生成</span></div>
        <div class="hdg">这是末级节点（该建知识点），但总结数据还没读到。</div>
      </div>
      <button class="pclose" onclick="evPopClose()" title="关闭（Esc）">✕</button>
    </div>
    <div class="pbody">
      <div class="small muted">导图照常出图，只是这条知识点还没有总结：
        数据文件 <code>logs/knowledge/&lt;doc_id&gt;-末级知识点总结.json</code>
        不存在或尚未生成。生成后刷新本页即可点开查看。</div>
      ${n.page ? `<div class="small muted" style="margin-top:6px">该节点对应 p.${
        n.page}</div>` : ''}
    </div>
    <div class="pf">
      <button class="ghost" id="mmkp-search">在资料库中检索此主题</button>
    </div>`);
  $('#mmkp-search').onclick = () => { const nm = n.name; evPopClose(); doSearch(nm); };
}

// 非末级节点：全覆盖，按类型给不同说法（纯本地渲染，不用请求）。
// 这里的每一档都**不含知识点**，但原因不同，不能一句话打发：
// 父节点页是"内容下放给后继末级页了"（卡 C-0045 起；旧产物是"人拍板暂不建"），
// 分类/根节点是"内容在子节点里"。
function mmNoKpHtml(n){
  const kind = n.lkp_role === 'parent_page' ? 'parent_page'
    : (n.kp_node_kind === 'root' ? 'root'
      : (n.children && n.children.length ? 'category'
        : (n.kp_node_kind === 'e1' && n.children && n.children.length ? 'e1' : 'none')));
  const nm = esc(n.name || '');
  let loc = `节点「${nm}」`, hdg = '', note = '';
  if (kind === 'parent_page'){
    loc = `父节点页「${nm}」`;
    hdg = `该节点对应 p.${n.page || '?'}，但它在导图里还有下级节点，本身不是末级节点。`;
    note = MINDMAP.downshift
      ? `按卡 C-0045 的口径，这一页是<b>下放</b>的：自己不单独成条，内容并入紧随其后的末级页那条知识点，并计入它的覆盖页——要看内容请展开子节点。`
      : `本页按当前口径不建知识点（人已拍板：这一页连同同类的其余 9 页暂不建，也不并入子节点）——要看内容请展开子节点。`;
  } else if (kind === 'e1'){
    loc = `非教学页「${nm}」`;
    hdg = '这一页是封皮/学习目标/目录/致谢一类的非教学页，按当前口径不建知识点。';
    note = '它不含可考的药理学内容，所以没有对应的知识点。';
  } else if (kind === 'category'){
    loc = `分类节点「${nm}」`;
    hdg = '这是分类节点，本页按当前口径不建知识点——展开子节点看它下面的知识点。';
    note = '末级节点才建知识点：内容是那一页正文与图片理解提炼出的总结。';
  } else if (kind === 'root'){
    loc = `根节点「${nm}」`;
    hdg = '这是整份课件的根节点，本页按当前口径不建知识点——展开子节点看下面的知识点。';
  } else {
    hdg = '该节点不是末级节点，按当前口径不建知识点。';
    note = '它可能只是层级里的过渡节点，展开看下面的末级节点。';
  }
  const expandBtn = (kind === 'category' || kind === 'root')
    ? '<button class="ghost" id="mmkp-expand">展开子节点</button>' : '';
  return `
    <div class="ph">
      <div class="src">
        <div class="loc">${loc} <span class="badge">${esc(mmKindLabel(kind, MINDMAP.downshift))}</span></div>
        <div class="hdg">${hdg}</div>
      </div>
      <button class="pclose" onclick="evPopClose()" title="关闭（Esc）">✕</button>
    </div>
    <div class="pbody">${note ? `<div class="small muted">${note}</div>` : ''}${
      n.page ? `<div class="small muted" style="margin-top:6px">该节点对应 p.${
        n.page}</div>` : ''}</div>
    <div class="pf">
      ${expandBtn}
      <button class="ghost" id="mmkp-search">在资料库中检索此主题</button>
    </div>`;
}

function mmOpenNode(key, el){
  const n = (MINDMAP.nodes || {})[key];
  if (!n) return;
  // 卡 C-0042：知识点页签里点任何节点弹出的小窗都**居中显示**（人点名要的）。
  // 标记挂在弹窗自己身上，evPopPlace 每次定位（含展开课件/图加载完的重定位）
  // 都读它；evPopClose / evPopShow 负责清掉（见那两处），不会串到出处小窗。
  evPopEl().dataset.kpPop = '1';
  if (n.lkp_ready){
    // 卡 C-0050：一个结构叶节点覆盖超过 3 页 → 产物把它切成多条知识点
    // （卡 C-0049 §5）。这种节点点开先**列出这几条**让人选，不替人挑一条。
    if ((n.lkp_ids || []).length > 1) return mmOpenKpList(n, el);
    return mmOpenKp(n.lkp_id, n.lkp_name || n.name, el);
  }
  evPopEl().dataset.kp = '';   // 这一屏不是总结：作废在途的总结请求
  if (n.lkp_role === 'leaf'){
    // 末级节点但还没读到总结：说"待生成"，别说成"这页不建知识点"
    return mmOpenPending(n, el);
  }
  evPopMount(el, mmNoKpHtml(n));
  const ex = $('#mmkp-expand');
  if (ex) ex.onclick = () => {
    const det = el.closest('details');
    if (det) det.open = true;
    evPopClose();
  };
  $('#mmkp-search').onclick = () => { const nm = n.name; evPopClose(); doSearch(nm); };
}

// 一个结构节点挂**多条**知识点时的选择列表（卡 C-0050）。
// 什么时候会出现：结构叶节点覆盖的页超过一条知识点的页数上限（连续 3 页，
// 见卡 C-0049 §5），管线按"连续 ≤3 页"把它切成多条——它们同属一个结构节点。
// 这里只做一件事：把这几条列出来，点哪条看哪条；**不替人挑**、也不把几条合并
// 成一段（那会让人以为产物里就是这么写的）。
function mmOpenKpList(n, el){
  const ids = n.lkp_ids || [];
  const names = n.lkp_names || [];
  evPopEl().dataset.kp = '';    // 这一屏不是某条总结：作废在途的总结请求
  evPopMount(el, `
    <div class="ph">
      <div class="src">
        <div class="loc">节点「${esc(n.name || '')}」
          <span class="badge">${ids.length} 条知识点</span></div>
        <div class="hdg">这个结构节点覆盖的页超过了一条知识点 3 页的上限，
          产物把它拆成了 ${ids.length} 条。</div>
      </div>
      <button class="pclose" onclick="evPopClose()" title="关闭（Esc）">✕</button>
    </div>
    <div class="pbody">
      <div class="small muted" style="margin-bottom:8px">${
        (n.pages || []).length
          ? '覆盖 ' + n.pages.map(p => 'p.' + p).join('、') + ' · ' : ''}点一条看它的理解与要点。</div>
      <ul class="lkppts">${ids.map((id, i) => `<li>
        <a href="#" class="mmkp-one" data-kp="${esc(id)}"
           data-name="${esc(names[i] || id)}">${esc(names[i] || id)}</a>
        <span class="small muted">${esc(id)}</span></li>`).join('')}</ul>
    </div>`);
  document.querySelectorAll('.mmkp-one').forEach(a => {
    a.onclick = e => {
      e.preventDefault();
      mmOpenKp(a.dataset.kp, a.dataset.name, el, false);
    };
  });
}

