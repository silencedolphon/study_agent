  font-family:ui-monospace,monospace}
.cite{display:inline-block;min-width:17px;text-align:center;
  background:#233047;color:var(--accent);border:1px solid #2d4166;
  border-radius:5px;padding:0 5px;margin:0 2px;font-size:11.5px;
  cursor:pointer;font-weight:600;vertical-align:1px}
.cite:hover{background:var(--accent);color:#08111f}
.cite.on{background:var(--accent);color:#08111f;border-color:var(--accent)}
/* 点角标弹出的出处小窗。
   用 position:fixed + 每次现算坐标：它是 #thread 里那些消息的"浮层"，
   但 DOM 上挂在 body 下——若留在消息里，会被 .bubble 的 overflow/层级裁剪。
   坐标必须在**显示之后**测量：display:none 的元素量出来是 0，
   早先的写法就是这个坑（弹窗永远落在左上角）。 */
.evpop{position:fixed;z-index:40;width:min(560px,calc(100vw - 24px));
  max-height:min(62vh,540px);display:flex;flex-direction:column;
  background:var(--panel);border:1px solid var(--accent);border-radius:11px;
  box-shadow:0 18px 44px rgba(0,0,0,.55);overflow:hidden;
  animation:evin .12s ease-out;text-align:left}
@keyframes evin{from{opacity:0;transform:translateY(-5px)}to{opacity:1;transform:none}}
.evpop .ph{display:flex;align-items:flex-start;gap:8px;padding:9px 11px;
  border-bottom:1px solid var(--line);background:var(--panel2)}
.evpop .src{flex:1;min-width:0}
.evpop .src .loc{color:var(--accent);font-size:13.5px;font-weight:600}
.evpop .src .hdg{color:var(--dim);font-size:12px;margin-top:3px;
  word-break:break-word;line-height:1.5}
.evpop .pclose{flex:0 0 auto;background:none;border:none;color:var(--dim);
  font-size:17px;line-height:1;cursor:pointer;padding:2px 6px}
.evpop .pclose:hover{color:var(--fg)}
/* 卡 C-0036：正文区必须能**自己滚**。flex 子项默认 min-height:auto，内容一长
   就顶破 .evpop 的 overflow:hidden —— 滚动条根本不出现，长内容被直接裁掉
   （"弹窗滚不动"就是这个原因，不是 overflow 写错了）。显式 flex:1 + min-height:0
   之后滚动才真的发生在 .pbody 里；而 evPopScroll 判过 EVPOP.contains(target)，
   滚弹窗内部不会把窗关掉。 */
.evpop .pbody{overflow:auto;padding:11px;flex:1 1 auto;min-height:0;
  scrollbar-width:thin;scrollbar-color:var(--line) transparent}
.evpop .pbody pre{white-space:pre-wrap;word-break:break-word;margin:0;
  font:inherit;font-size:12.5px;line-height:1.72;color:#c8d0dc;
  background:var(--panel2);border:1px solid var(--line);
  border-radius:7px;padding:9px 11px}
.evpop .pf{padding:8px 11px;border-top:1px solid var(--line);
  display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.evpop .pmeta{color:var(--dim);font-size:12px}
/* 卡 C-0055：出处小窗里的"这一页"——课件图 + 该页知识点。
   人拍板（2026-09-27）：「AI问答版块点击右下标签时最好可以跳出那一页的课件图片。
   并且可以看到那一页课件对应的知识点，形成一个网状知识体系。」
   放在块原文**之前**：点角标的第一眼就是"这一页长什么样、讲的是哪条知识点"，
   原文跟在下面（长的时候本来就要滚，见 .pbody 的滚动说明）。
   图的交互与知识点弹窗**保持一致**（点图开原尺寸、图加载完重算小窗位置），
   只是容器与类名各用一套：全页只有一个小窗（见 evPopEl 的说明），
   出处与知识点是两种内容，DOM id 不能共用（否则后开的那个会把前一个的容器抢走）。 */
.evpop .evx{margin:0 0 11px;padding-bottom:11px;border-bottom:1px solid var(--line)}
.evpop .evxttl{color:var(--dim);font-size:12px;margin:0 0 6px}
.evpop .evslideimg{display:block;width:100%;max-height:26vh;object-fit:contain;
  background:#0d1420;border:1px solid var(--line);border-radius:7px;cursor:zoom-in}
.evpop .evslideimg:hover{border-color:var(--accent)}
.evpop .evkps{display:flex;flex-wrap:wrap;gap:6px;margin:2px 0 0}
.evpop .evkp{cursor:pointer;font-size:12px;color:var(--fg);background:var(--panel2);
  border:1px solid var(--line);border-radius:14px;padding:3px 10px;line-height:1.6}
.evpop .evkp:hover{border-color:var(--accent);color:var(--accent)}
.evpop .evkp b{color:var(--accent);font-size:11px;font-weight:600}
.evpop .evkp .pg{color:var(--dim);font-size:11px}
.ghost.on{border-color:var(--accent);color:var(--accent)}
#chatbar{display:flex;gap:9px;align-items:flex-end;margin-top:14px}
#chatq{flex:1;min-height:44px;max-height:160px;resize:vertical;line-height:1.6}
#chatwrap .hint{color:var(--dim);font-size:12px}
.typing::after{content:'▋';color:var(--accent);animation:bl 1s steps(2) infinite}
@keyframes bl{50%{opacity:0}}
.qchip{background:var(--panel2);border:1px solid var(--line);border-radius:20px;
  padding:5px 12px;font-size:12.5px;cursor:pointer;color:var(--dim)}
.qchip:hover{border-color:var(--accent);color:var(--fg)}

/* ---------- 课件思维导图（入库时留存的结构数据） ---------- */
/* 折叠用原生 <details>，层级靠左边虚线，零第三方库——保持离线优先。 */
.mmtree{font-size:13px;max-height:58vh;overflow:auto;background:var(--panel2);
  border:1px solid var(--line);border-radius:8px;padding:10px 12px}
.mmtree ul{list-style:none;margin:0;padding-left:15px;
  border-left:1px dashed var(--line)}
.mmtree>ul{padding-left:2px;border-left:none}
.mmtree li{margin:1px 0}
.mmtree summary{cursor:pointer;padding:2px 0;list-style:none;outline:none}
.mmtree summary::-webkit-details-marker{display:none}
.mmtree summary::before{content:'▸';color:var(--dim);display:inline-block;
  width:14px;font-size:11px}
.mmtree details[open]>summary::before{content:'▾'}
.mmtree .mmleaf{padding:2px 0 2px 16px}
.mmname{cursor:pointer;border-bottom:1px dotted var(--line)}
.mmname:hover{color:var(--accent);border-bottom-color:var(--accent)}
/* 有知识点的节点：实线下划线 + 前面一个 ◆；无知识点的保持灰虚线。
   纯 CSS 标记，不引入任何图标库/CDN（离线优先）。 */
.mmname.has-kp{border-bottom:1px solid var(--accent);color:var(--fg)}
.mmname.has-kp::before{content:'◆';color:var(--accent);font-size:9px;
  margin-right:4px;vertical-align:1px}
.mmname.lkp-pending{border-bottom:1px dashed var(--warn);color:var(--fg)}
.mmname.lkp-pending::before{content:'◇';color:var(--warn);font-size:10px;
  margin-right:4px;vertical-align:1px}
/* 父节点页（路径停在这一页、但导图里还有下级节点）：卡 C-0045 起是「下放」——
   自己不单独成条，内容并入紧随其后的末级页知识点；旧产物下显示"暂不建"。 */
.mmname.parent-page{border-bottom-style:dotted;color:var(--dim)}
.mmname.lv4{border-bottom-style:dotted;color:var(--dim)}
.mmname.nonkp{color:var(--dim)}

/* 末级知识点总结弹窗（新方案，卡 C-0032：展示总结正文 + 要点 + 出处，
   不再贴原文块）。形状照 .pbody 里的阅读宽度来：一段正文 + 一个要点列表。 */
.lkpsum{font-size:13.5px;line-height:1.85;color:var(--fg);
  background:var(--panel2);border:1px solid var(--line);border-radius:7px;
  padding:10px 12px;white-space:pre-wrap;word-break:break-word}
.lkpsum.none{color:var(--warn)}
.lkpsub{margin:12px 0 6px;font-size:11.5px;color:var(--dim);
  border-top:1px solid var(--line);padding-top:9px}
.lkppts{margin:0;padding-left:20px;font-size:13px;line-height:1.78}
.lkppts li{margin:4px 0}
.lkpsrcs{display:flex;flex-wrap:wrap;gap:6px;margin-top:2px}
.lkpsrc{display:inline-flex;align-items:center;gap:6px;font-size:11.5px;
  color:var(--dim);background:var(--panel2);border:1px solid var(--line);
  border-radius:6px;padding:2px 7px}
.lkpsrc .cid{font-family:ui-monospace,monospace;color:var(--accent);
  cursor:pointer}
.lkpsrc .cid:hover{text-decoration:underline}
.lkpchain{font-size:11.5px;color:var(--dim);line-height:1.6}
/* 卡 C-0036：知识点弹窗的交互形状 ----------------------------------------
   默认只给「要点」；总结正文 / 出处明细 / 生成链条收进 <details>（点标题行展开）。
   底部固定一行：左下「下一知识点」、右下「展开当页课件」。
   课件图区在正文区里；展开课件时整个弹窗加宽（.deck-open），图可点开原尺寸。
   展开/收起的状态字用 CSS 的 ::before 写在 summary 上，省一次 JS 改文案。 */
.kpmore{margin-top:12px;border-top:1px solid var(--line);padding-top:10px}
.kpmore>summary{cursor:pointer;display:inline-block;list-style:none;outline:none;
  font-size:11.5px;color:var(--dim);background:var(--panel2);
  border:1px solid var(--line);border-radius:6px;padding:4px 10px}
.kpmore>summary::-webkit-details-marker{display:none}
.kpmore>summary::before{content:'▸ 展开：'}
.kpmore[open]>summary::before{content:'▾ 收起：'}
.kpmore>summary:hover{border-color:var(--accent);color:var(--fg)}
.kpslide{margin-top:12px;border-top:1px solid var(--line);padding-top:10px}
.kppages{display:flex;flex-wrap:wrap;gap:5px;margin:7px 0}
.kppage{cursor:pointer;font-size:11.5px;color:var(--dim);background:var(--panel2);
  border:1px solid var(--line);border-radius:6px;padding:1px 8px}
.kppage:hover{border-color:var(--accent);color:var(--fg)}
.kppage.on{border-color:var(--accent);color:var(--accent);font-weight:600}
.kppage.off{opacity:.4;cursor:default}
.kpslideimg{display:block;width:100%;max-height:52vh;object-fit:contain;
  background:#0b1220;border:1px solid var(--line);border-radius:7px;
  cursor:zoom-in}
.kpslideimg:hover{border-color:var(--accent)}
.evpop.deck-open{width:min(1000px,calc(100vw - 24px));max-height:min(88vh,860px)}

/* ---- 学科切换器（卡 C-0039）：顶栏**最右侧**，在搜索框右边 ---- */
/* 搜索框让位：宽度改成可伸缩的 flex，窄屏时先缩它，切换器始终留得住 */
header #q{width:190px;min-width:88px;flex:0 1 190px}
.subj{position:relative;flex:0 0 auto}
.subj>button{display:flex;align-items:center;gap:6px;max-width:230px}
.subj>button .scaret{font-size:10px;color:var(--dim)}
.subj>button .sname{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;
  max-width:150px;font-weight:600}
.subjmenu{position:absolute;right:0;top:calc(100% + 8px);min-width:236px;
  max-width:min(330px,88vw);background:var(--panel);border:1px solid var(--line);
  border-radius:10px;padding:6px;box-shadow:0 14px 34px rgba(0,0,0,.5);
  z-index:40;display:none}
.subjmenu.on{display:block}
.subjmenu .shead{font-size:11.5px;color:var(--dim);padding:5px 9px 6px}
.subjmenu .sitem{display:flex;align-items:center;gap:8px;width:100%;text-align:left;
  background:transparent;border:1px solid transparent;color:var(--fg);
  padding:7px 9px;border-radius:7px;cursor:pointer;font:inherit;font-size:13px}
.subjmenu .sitem:hover{background:var(--panel2);border-color:var(--line)}
.subjmenu .sitem.on{border-color:var(--accent);color:var(--accent);font-weight:600}
.subjmenu .sitem .snm{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.subjmenu .sitem .smeta{margin-left:auto;font-size:11px;color:var(--dim);
  font-weight:400;white-space:nowrap}
.subjmenu .ssep{height:1px;background:var(--line);margin:6px 4px}
.subjmenu .snew{color:var(--accent);font-weight:600}
.subjmenu .sfoot{margin-top:6px;border-top:1px dashed var(--line);padding:7px 9px 3px;
  font-size:11px;color:var(--dim);line-height:1.55;word-break:break-all}
@media (max-width:820px){
  header{gap:12px;padding:14px 16px}
  header #q{flex:1 1 110px;width:auto}
  .subj>button .sname{max-width:96px}
  .subjmenu{min-width:200px}
}

/* ---------- 设置中心（卡 C-0059）：右上角入口 + 四分区模态窗 ----------
   布局意图：左栏四条管线（+一行说明），右栏是这条管线的字段；
   字段一律「标签 / 控件 / 说明」三行式，说明里写清底层键名与生效时机——
   这个窗口要给不认识代码的人用，也要给想核对"到底改了哪个键"的人用。
   密钥永不回显明文，只显示"已配置 · 尾号 xxxx"。 */
#set-btn{display:flex;align-items:center;gap:7px;white-space:nowrap;
  font-weight:600}
#set-btn:hover{border-color:var(--accent);color:var(--fg)}
.set-modal{align-items:flex-start;padding:26px 16px;z-index:45}
.setbox{background:var(--panel);border:1px solid var(--line);border-radius:14px;
  width:min(1080px,100%);max-height:calc(100vh - 52px);display:flex;
  flex-direction:column;overflow:hidden;box-shadow:0 24px 64px rgba(0,0,0,.6)}
.set-head{display:flex;align-items:center;gap:12px;padding:15px 20px;
  border-bottom:1px solid var(--line);background:linear-gradient(180deg,#1c212b,#171a21)}
.set-head h2{margin:0;font-size:16px;display:flex;align-items:center;gap:8px}
.set-head .ssub{color:var(--dim);font-size:12px;margin-top:3px}
.set-x{margin-left:auto;background:transparent;border:1px solid transparent;
  color:var(--dim);font-size:17px;line-height:1;padding:6px 11px;border-radius:8px;
  cursor:pointer;font-family:inherit}
.set-x:hover{color:var(--fg);border-color:var(--line);background:var(--panel2)}
.set-secretbar{display:flex;gap:9px;align-items:flex-start;padding:9px 20px;
  background:#12251a;border-bottom:1px solid #1c3a24;color:#9ed7ae;font-size:12px;
  line-height:1.65}
.set-body{display:flex;min-height:0;flex:1}
.set-nav{flex:0 0 194px;border-right:1px solid var(--line);padding:12px 10px;
  display:flex;flex-direction:column;gap:4px;background:#141821}
.set-nav button{display:flex;align-items:center;gap:9px;width:100%;text-align:left;
  background:transparent;border:1px solid transparent;color:var(--dim);
  padding:9px 11px;border-radius:9px;cursor:pointer;font:inherit;font-size:13px}
.set-nav button:hover{background:var(--panel2);color:var(--fg)}
.set-nav button.on{background:var(--panel2);border-color:var(--accent);
  color:var(--fg);font-weight:600}
.set-nav .snav-note{margin-top:auto;border-top:1px dashed var(--line);
  padding:9px 10px 2px;color:var(--dim);font-size:11px;line-height:1.7}
.set-pane{flex:1;min-width:0;overflow:auto;padding:18px 22px 28px}
.set-pane h3{margin:0;font-size:15px;display:flex;align-items:center;gap:8px}
.set-pane .pdesc{color:var(--dim);font-size:12.5px;margin:6px 0 4px;line-height:1.75}
.set-group{margin-top:14px;border-top:1px solid var(--line);padding-top:12px}
.set-group>h4{margin:0 0 6px;font-size:11.5px;color:var(--dim);font-weight:600;
  letter-spacing:.5px}
.srow{display:grid;grid-template-columns:194px minmax(0,1fr);gap:8px 14px;
  align-items:start;padding:9px 0;border-bottom:1px dashed rgba(42,47,58,.75)}
.srow:last-child{border-bottom:none}
.srow>label{font-size:13px;padding-top:7px;color:var(--fg)}
.srow .sctl{min-width:0}
.srow input[type=text],.srow input[type=password],.srow input[type=number],
.srow select{width:100%;max-width:440px}
.srow .shint{color:var(--dim);font-size:11.5px;line-height:1.65;margin-top:5px}
.sbadge{display:inline-block;margin-left:7px;font-size:11px;padding:1px 8px;
  border-radius:20px;border:1px solid var(--line);color:var(--dim);vertical-align:1px}
.sbadge.on{color:var(--ok);border-color:#1c3a24}
.switch{display:flex;align-items:center;gap:9px;padding-top:6px;font-size:13px}
.switch input{width:auto;flex:0 0 auto}
.switch.off{opacity:.62}
.set-adv{margin-top:14px;border:1px solid var(--line);border-radius:9px;
  background:#151920}
.set-adv>summary{cursor:pointer;padding:9px 13px;font-size:12px;color:var(--dim);
  list-style:none;outline:none}
.set-adv>summary::-webkit-details-marker{display:none}
.set-adv>summary::before{content:'▸ 高级：'}
.set-adv[open]>summary::before{content:'▾ 高级：'}
.set-adv .setadvbody{padding:0 14px 10px}
.spcard{border:1px solid var(--line);border-radius:9px;background:#151920;
  padding:11px 13px;margin-bottom:9px}
.spcard .spname{font-size:13px;font-weight:600}
.spcard .spmeta{color:var(--dim);font-size:11px;margin-top:4px;
  word-break:break-all;line-height:1.6}
.spcard .spact{margin-top:9px;display:flex;gap:8px;flex-wrap:wrap}
.spcard.readonly{background:#131720;border-style:dashed}
.spedit{margin-top:11px;border-top:1px solid var(--line);padding-top:11px}
.spedit textarea{width:100%;min-height:40vh;font:12px/1.65 ui-monospace,
  Consolas,"Courier New",monospace;white-space:pre;overflow:auto}
.spmsg{font-size:12px;margin-top:8px;line-height:1.7}
.spmsg.ok{color:var(--ok)}
.spmsg.bad{color:var(--bad)}
.set-foot{display:flex;gap:10px;align-items:center;flex-wrap:wrap;
  padding:12px 20px;border-top:1px solid var(--line);background:#141821}
.set-foot .sstat{color:var(--dim);font-size:12px;margin-left:auto;text-align:right}
.set-foot .sstat.ok{color:var(--ok)}
.set-foot .sstat.bad{color:var(--bad)}
.set-foot .sstat.warn{color:var(--warn)}
@media (max-width:860px){
  .set-body{flex-direction:column}
  .set-nav{flex:0 0 auto;flex-direction:row;overflow:auto;border-right:none;
    border-bottom:1px solid var(--line)}
  .set-nav button{width:auto;white-space:nowrap}
  .set-nav .snav-note{display:none}
  .srow{grid-template-columns:1fr}
  .srow>label{padding-top:0}
}
/* ---------------- 遗忘曲线月历（卡 C-0061） ----------------
   纯手写网格（零 CDN / 零第三方库），全部用既有 CSS 变量，不引入新色。
   颜色来源：--accent（今天/选中）、#33191a + --bad（逾期，与 .badge.bad 同族）、
   #233047（待复习，与 .cite.on 的蓝底同族）、#16281b + --ok（已完成，与 .badge.ok 同族）。 */
.calhead{display:grid;grid-template-columns:repeat(7,1fr);gap:6px;margin-bottom:6px}
.calhead span{color:var(--dim);font-size:12px;text-align:center;padding:2px 0}
.calgrid{display:grid;grid-template-columns:repeat(7,1fr);gap:6px}
.day{min-height:86px;background:var(--panel2);border:1px solid var(--line);
  border-radius:8px;padding:6px 7px;cursor:pointer;display:flex;flex-direction:column;gap:4px}
.day:hover{border-color:var(--accent)}
.day.blank{background:transparent;border:1px dashed #20242d;cursor:default}
.day.blank:hover{border-color:#20242d}
.day .dnum{font-size:12px;color:var(--dim);font-variant-numeric:tabular-nums;
  display:flex;gap:5px;align-items:center;flex-wrap:wrap}
.day.today{border-color:var(--accent)}
.day.today .dnum{color:var(--accent);font-weight:700}
.day.sel{outline:2px solid var(--accent);outline-offset:-1px}
.day.overdue{border-color:#4a1f1c;background:#1d1517}
.day.overdue .dnum{color:var(--bad)}
.ev{font-size:11px;line-height:1.35;padding:1px 5px;border-radius:5px;
  background:#233047;color:#cfe0ff;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.ev.done{background:#16281b;color:#9ad6a8}
.ev.over{background:#33191a;color:#ffb3ad}
.more{font-size:11px;color:var(--dim)}
.legend{display:flex;gap:14px;flex-wrap:wrap;font-size:12px;color:var(--dim);margin-top:10px}
.legend i{display:inline-block;width:10px;height:10px;border-radius:3px;margin-right:5px;
  vertical-align:-1px;border:1px solid var(--line)}
.dc-list td{vertical-align:middle}

