def api_share_export(payload: dict) -> dict:
    """导出当前库的一份课件为分享包（「按键」→ 落成本机 zip）。

    包默认落在 `share\\`（与 `tools/share.py export` 同一默认值），
    文件名 `\\<标题>-share.zip`：同名重复导出**覆盖**，不与 CLI 抢命名规则。
    """
    doc_id = int(payload.get("doc_id") or 0)
    with_original = bool(payload.get("with_original"))
    with_pages = bool(payload.get("with_pages"))
    note = str(payload.get("note") or "")[:200]
    try:
        tgt = _share_target("")            # 导出按钮只出现在**当前库**的行上
    except subjects_mod.SubjectError as e:
        return {"error": str(e)}
    _share_prog_reset()
    t0 = time.time()
    try:
        with _SHARE_LOCK:
            res = share_mod.export_doc(
                doc_id, None, db_path=tgt["db_path"], log_dir=tgt["log_dir"],
                raw_dir=tgt["raw_dir"], root=tgt["root"],
                with_original=with_original, with_pages=with_pages,
                exported_by=str(payload.get("by") or ""), note=note,
                progress=_share_prog)
    except share_mod.ShareError as e:
        _share_prog_done(str(e))
        return {"error": str(e), "kind": "share",
                "elapsed": round(time.time() - t0, 1)}
    except Exception as e:                  # noqa: BLE001（磁盘满/权限等也要给人话）
        msg = "导出失败：%s: %s" % (type(e).__name__, e)
        _share_prog_done(msg)
        return {"error": msg, "elapsed": round(time.time() - t0, 1)}
    _share_prog_done()
    z = Path(res["zip"])
    return {
        "ok": True, "zip": res["zip"], "dir": str(z.parent), "name": z.name,
        "bytes": int(res["bytes"]), "counts": res["counts"],
        "includes": res["includes"], "embedding": res["embedding"],
        "n_pages": int(res["n_pages"]), "original_bytes": int(res["original_bytes"]),
        "pages_bytes": int(res["pages_bytes"]), "warnings": res["warnings"],
        "elapsed": round(time.time() - t0, 1),
        "cmd": 'python tools\\share.py import --zip "%s"' % res["zip"],
    }


def api_share_inspect(payload: dict) -> dict:
    """看包信息：包里有什么、能不能导入这个库、有没有冲突。**全程只读。**

    这里刻意**不调用** `import_package(dry_run=True)`：那条路会先 `db.init_db()`
    写一下目标库（幂等，但仍是写）。看包是「只看不动」的动作，所以模型一致性
    与冲突都由本函数**只读地**判：前者比 `local_embedding_identity`，后者查
    `documents.content_hash`——与 `import_package` 真正那道闸同一判据。
    结构完整性交给 `inspect_package(deep=True)`（逐条 sha256 核对）。
    """
    zip_arg = str(payload.get("zip") or "").strip().strip('"').strip("'")
    if not zip_arg:
        return {"error": "请先填写分享包路径"}
    zp = Path(zip_arg).expanduser()
    if not zp.is_file():
        return {"error": "找不到分享包：%s（看板在本机运行，填本机完整路径即可）" % zp,
                "kind": "package"}
    try:
        info = share_mod.inspect_package(zp, deep=True)
    except share_mod.ShareError as e:
        return {"error": str(e), "kind": "package"}
    except Exception as e:                  # noqa: BLE001
        return {"error": "%s: %s" % (type(e).__name__, e), "kind": "package"}
    try:
        tgt = _share_target(str(payload.get("subject") or ""))
    except subjects_mod.SubjectError as e:
        return {"error": str(e), "kind": "subject"}
    man = info.get("manifest") or {}
    src = man.get("source") or {}
    emb = man.get("embedding") or {}
    counts = man.get("counts") or {}
    doc = info.get("doc") or {}
    entries = _share_zip_entries(zp)
    dbp = Path(tgt["db_path"])
    out = {
        "ok": True, "zip": str(zp), "bytes": int(info["bytes"]),
        "format": man.get("format"), "format_version": man.get("format_version"),
        "created_at": man.get("created_at"),
        "exported_by": man.get("exported_by") or "", "note": man.get("note") or "",
        "source": {"subject": src.get("subject"), "doc_id": src.get("doc_id"),
                   "title": src.get("title"), "kind": src.get("kind"),
                   "path": src.get("path")},
        "title": doc.get("title") or src.get("title"),
        "content_hash": doc.get("content_hash"), "file_name": doc.get("file_name"),
        "embedding": {"model": emb.get("model"), "dim": emb.get("dim")},
        "counts": counts,
        # chunks.jsonl 的**实际行数**（含识图伪块）。manifest.counts.chunks 是
        # 导出方的声明值，两者不是同一个数——界面上要显示的是这个实测值。
        "chunks_n": int((info.get("counts") or {}).get("total") or 0),
        "embeddings_n": (info.get("embeddings") or {}).get("total"),
        "knowledge": info.get("knowledge") or [],
        "includes": info.get("includes") or {},
        "n_entries": info.get("n_entries"), "entries": entries[:12],
        "entry_total": len(entries),
        "target": {"slug": tgt["slug"], "db": str(dbp), "db_exists": dbp.is_file(),
                   "raw": str(tgt["raw_dir"])},
        "warnings": info.get("warnings") or [],
        "importable": True, "reason": "", "reason_kind": "",
        "conflict": None, "local_embedding": None,
        "est_seconds": max(2, int(round(int(counts.get("chunks") or 0) / 300.0)) + 1),
    }
    if not dbp.is_file():
        out["db_note"] = "目标库还没建好，第一次导入会自动建库"
        return out
    conn = db.connect(dbp)
    try:
        lm, ld = share_mod.local_embedding_identity(conn)
        out["local_embedding"] = {"model": lm, "dim": ld}
        try:
            pm, pd = str(emb.get("model") or ""), int(emb.get("dim") or 0)
        except (TypeError, ValueError):
            pm, pd = "", 0
        if (pm, pd) != (lm, ld):
            out["importable"] = False
            out["reason_kind"] = "model"
            out["reason"] = (
                "模型不一致：包里的向量用的是 %s（dim=%d），你当前库用的是 %s（dim=%d），"
                "导入会被拒绝——**不会**自动重算（重算要调用嵌入模型、要花钱）。\n"
                "两条出路：① 让导出方用 %s（dim=%d）重新导出；"
                "② 让导出方勾选「包含原课件文件」重导一次，你在本机重新入库"
                "（用你自己的本地嵌入模型，不产生接口费用）。"
                % (pm, pd, lm, ld, lm, ld))
        ch = doc.get("content_hash")
        if ch:
            hit = conn.execute("SELECT id,title,path FROM documents WHERE content_hash=? "
                               "ORDER BY id LIMIT 1", (ch,)).fetchone()
            if hit is not None:
                out["conflict"] = {"doc_id": int(hit["id"]), "title": hit["title"],
                                   "path": hit["path"]}
    finally:
        conn.close()
    return out


def api_share_import(payload: dict) -> dict:
    """把一个分享包导进目标学科库。**零模型调用、零费用**（C-0079 保证）。

    冲突三选一（卡面要求）：skip（默认，不动本库已有的那份）/ duplicate
    （再导一份副本，同 content_hash 会出现两行，用于对比来源）/ overwrite
    （**先全量校验新包，通过了才删掉本库那一份**，然后导入）。
    覆盖的这个顺序不能反：反了就是一个坏包先把用户手里的资料删掉再报错。
    """
    zip_arg = str(payload.get("zip") or "").strip().strip('"').strip("'")
    if not zip_arg:
        return {"error": "请先填写分享包路径"}
    zp = Path(zip_arg).expanduser()
    if not zp.is_file():
        return {"error": "找不到分享包：%s" % zp, "kind": "package"}
    on_conflict = str(payload.get("on_conflict") or "skip")
    if on_conflict not in ("skip", "duplicate", "overwrite"):
        return {"error": "未知的冲突处理方式：%s" % on_conflict}
    try:
        tgt = _share_target(str(payload.get("subject") or ""))
    except subjects_mod.SubjectError as e:
        return {"error": str(e), "kind": "subject"}
    _share_prog_reset()
    t0 = time.time()
    removed = None
    try:
        # 写库的长任务与单份入库串行（同一把 `_INGEST_LOCK`），不占 `_lock`
        with _INGEST_LOCK:
            if on_conflict == "overwrite" and Path(tgt["db_path"]).is_file():
                # 先证明这个包是完好的（含向量模型那道闸）——**校验在前，删除在后**。
                # 反了的话，一个坏包会先把用户手里的资料删掉再报错。
                dry = share_mod.import_package(
                    str(zp), db_path=tgt["db_path"], log_dir=tgt["log_dir"],
                    raw_dir=tgt["raw_dir"], root=tgt["root"], dry_run=True)
                hit = dry.get("conflict")
                if hit:
                    conn = db.connect(tgt["db_path"])
                    try:
                        # ★ 删**所有**同 content_hash 的记录，不只是第一条。
                        #   实测踩到：库里因以前的「另存一份」存了两份同一课件时，
                        #   只删一条 ⇒ 紧接着的导入又撞上另一条 ⇒ 返回 skipped，
                        #   用户明明选了"覆盖"，实际什么都没覆盖。
                        ch = conn.execute("SELECT content_hash FROM documents WHERE id=?",
                                          (int(hit["doc_id"]),)).fetchone()["content_hash"]
                        ids = [int(r["id"]) for r in conn.execute(
                            "SELECT id FROM documents WHERE content_hash=? ORDER BY id",
                            (ch,))]
                        removed = {"deleted_doc_ids": [], "chunks_removed": 0}
                        for did in ids:
                            one = api_delete_doc(conn, did)
                            removed["deleted_doc_ids"].append(
                                int(one["deleted_doc_id"]))
                            removed["chunks_removed"] += int(one["chunks_removed"])
                    finally:
                        conn.close()
    if plan_id <= 0 or round_ <= 0:
        return {"ok": False, "error": "缺少 plan_id / round"}
    return study.deck_mark(conn, plan_id, round_, state)


# ---------------- HTTP ----------------
# ================================================================ 多学科（卡 C-0039）
#
# 学科 = 一套**完全独立**的知识库（raw / index/study.db / notes / logs）。
# 默认学科就是项目根那套既有目录（零迁移）；新建的落在 `subjects/<slug>/`。
# 切换靠 `core/subjects.py` 重绑 `config.RAW_DIR/.../LOG_DIR` 实现——
# 全项目读的都是 config 的属性，所以切完立即生效，**不需要重启看板**。
#
# 这里只负责三件事：暴露 API、切库前拦住长任务、切库后清进程内缓存。

def _subject_running() -> str:
    """有长任务在跑时**不许切库**；返回正在跑的任务名（空串=空闲）。

    入库/整理都是几十分钟级的长任务，启动时就已经按**当时那个库**定好了
    路径与连接。跑到一半换库，轻则产物落到别的学科，重则两个学科的数据
    互相污染——这比"切不了"严重得多，所以这里宁可拒绝。
    """
    try:
        if progress_mod.snapshot().get("active"):
            return "入库"
    except Exception:  # noqa: BLE001（状态查询失败不该挡住功能，按空闲处理）
        pass
    try:
        if pool_mod.is_running():
            return "批量入库"
    except Exception:  # noqa: BLE001
        pass
    try:
        if kp_build_mod.is_running():
            return "知识点整理"
    except Exception:  # noqa: BLE001
        pass
    try:
        if kp_batch_mod.is_running():
            return "批量整理"
    except Exception:  # noqa: BLE001
        pass
    return ""


def _reset_subject_caches() -> dict:
    """切库后清掉**进程内**缓存，并返回各项清了多少条（写进响应，便于核对）。

    清单与理由（都是"上一個库的内容"）：
    - `_KNOWLEDGE_CACHE`：知识点 JSON 目录扫描结果。它的 key 里带目录签名，
      理论上换了目录自然 miss，但**旧条目会一直占着内存**，且同名人肉核对时
      容易看着旧数据以为是新库的，所以直接清。
    - `_LKP_CACHE`：末级知识点总结目录扫描结果，同上。
    - `_SLIDE_CACHE`：课件页图 `{页号: 文件名}` 目录扫描结果，key 是 deck 目录，
      换库后目录也换了；同样清掉释放内存。
    - `_KP_OPT_CACHE`：`/api/kp-build/options` 的 20 秒 TTL 缓存。它缓存的是
      **可整理课件清单 + 预估条数/花费**，是纯当前库数据，**必须**清——
      留着它，切库后第一次点「一键整理」会看到上一个库的清单。
    - `_code_mtime`/`_CODE_STAMP`（代码指纹）与库无关，**不清**。
    - `core.embed._engine`（嵌入模型单例）**绝不清**：跨学科共享模型是
      设计目标，切库就该零加载开销。
    """
    n = {"knowledge": 0, "lkp": 0, "slide": 0, "kp_opt": 0}
    with _KNOWLEDGE_LOCK:
        n["knowledge"] = len(_KNOWLEDGE_CACHE)
        _KNOWLEDGE_CACHE.clear()
    with _LKP_LOCK:
        n["lkp"] = len(_LKP_CACHE)
        _LKP_CACHE.clear()
    with _SLIDE_LOCK:
        n["slide"] = len(_SLIDE_CACHE)
        _SLIDE_CACHE.clear()
    if _KP_OPT_CACHE.get("data") is not None:
        n["kp_opt"] = 1
