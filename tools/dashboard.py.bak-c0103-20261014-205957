                   "pages": "写页图", "remove": "清理本库旧记录"}


def _share_prog_reset() -> None:
    _SHARE_PROG.update({"active": True, "stage": "准备中", "done": 0, "total": 0,
                        "error": "", "started": time.time(), "finished": 0.0})


def _share_prog(stage: str, done: int, total: int) -> None:
    """交给 `core/share` 当 progress 回调。

    **绝不能抛异常**：这个回调是在写 zip / 写库的主循环里被调的，它一炸，
    整次导出（或导入）就跟着崩——进度条的价值远小于交付本身。
    """
    try:
        _SHARE_PROG.update({"stage": _SHARE_STAGE_CN.get(stage, stage or ""),
                            "done": int(done), "total": int(total)})
    except Exception:                       # noqa: BLE001
        pass


def _share_prog_done(err: str = "") -> None:
    _SHARE_PROG.update({"active": False, "error": err or "",
                        "finished": time.time()})


def api_share_progress() -> dict:
    """进度快照：只读一个进程内字典，不碰数据库、不进任何锁。"""
    d = dict(_SHARE_PROG)
    if d.get("started"):
        d["elapsed"] = round(max(0.0, (d.get("finished") or time.time())
                                 - d["started"]), 1)
    return d


def _share_target(slug: str = "") -> dict:
    """把「目标学科」解析成 `core/share` 要的那几条路径。

    `slug` 为空（或就是当前学科）→ 用 config 现值，与顶栏显示的库一致；
    否则走 `subjects.paths_of`——它按目录**现算**，既不切库、也不改任何全局
    状态，所以「导入到别的学科」不会把用户正在用的那个库换掉。
    """
    root = Path(config.ROOT)
    if not slug or slug == subjects_mod.current():
        cur = subjects_mod.current_paths()
        return {"slug": subjects_mod.current(), "root": root,
                "db_path": cur["DB_PATH"], "log_dir": cur["LOG_DIR"],
                "raw_dir": cur["RAW_DIR"]}
    p = subjects_mod.paths_of(slug)
    return {"slug": slug, "root": root, "db_path": p["DB_PATH"],
            "log_dir": p["LOG_DIR"], "raw_dir": p["RAW_DIR"]}


def _share_source_file(tgt: dict, doc: dict) -> Path | None:
    """课件在本机的源文件（回退规则与 `share.export_doc` 逐字一致）。"""
    src = Path(str(doc.get("abs_path") or ""))
    if src.is_file():
        return src
    alt = Path(tgt["root"]) / str(doc.get("path") or "")
    return alt if alt.is_file() else None


def _share_page_files(tgt: dict, doc: dict) -> list[Path]:
    """识图页图：`logs/figure_desc/<源文件名 stem>/slide_*.png`。

    目录名由**源库**的文件名 stem 决定——这条规则与 `core/share.export_doc`
    必须一致，否则「预估体积」会数出另一批文件，与真正打进包的页图对不上。
    """
    src = _share_source_file(tgt, doc)
    stem = src.name if src is not None else Path(str(doc.get("path") or "")).name
    pdir = Path(tgt["log_dir"]) / "figure_desc" / share_mod.safe_dirname(Path(stem).stem)
    if not pdir.is_dir():
        return []
    return sorted(pdir.glob("slide_*.png"))


def _share_zip_entries(zip_path: Path) -> list[dict]:
    """包里每个条目的字节数（只读 zip 中央目录，不解压、不吃内存）。"""
    out: list[dict] = []
    try:
        with zipfile.ZipFile(zip_path) as zf:
            for i in zf.infolist():
                out.append({"name": i.filename, "bytes": int(i.compress_size),
                            "raw_bytes": int(i.file_size)})
    except (OSError, zipfile.BadZipFile):
        return []
    return sorted(out, key=lambda d: -d["bytes"])


def api_share_packages() -> dict:
    """列出 `share\\` 里已有的包——「选一个包」比手打路径可靠。"""
    d = Path(config.ROOT) / share_mod.SHARE_DIRNAME
    out: list[dict] = []
    if d.is_dir():
        for f in sorted(d.glob("*.zip")):
            try:
                st = f.stat()
            except OSError:
                continue
            out.append({"name": f.name, "path": str(f), "bytes": st.st_size,
                        "mtime": st.st_mtime})
    return {"ok": True, "dir": str(d), "packages": out}


