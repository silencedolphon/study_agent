    """
    try:
        did = int(doc_id or 0)
    except (TypeError, ValueError):
        return {"ok": False, "error": "doc_id 必须是整数"}
    if did <= 0:
        return {"ok": False, "error": "缺少 doc_id（要预习哪一份教材）"}
    if chapter is None or str(chapter).strip() == "":
        return {"need_confirm": True, "n_deleted": 0, "deleted": [], "not_found": [],
                "error": "清除不可逆（产物与备份都会被删，必须重新整理才能重建）；"
                         "确认后带上 confirm=true 再来"}
    raw = payload.get("doc_ids")
    if raw is None and payload.get("doc_id") is not None:
