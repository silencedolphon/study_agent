    if isinstance(raw, (str, int)):
        raw = [raw]
    if not isinstance(raw, (list, tuple)) or not raw:
        return {"error": "请至少勾选一份课件（doc_ids 不能为空）", "n_deleted": 0}
    if len(raw) > _KP_CLEAR_MAX_DOCS:
        return {"error": "一次最多清除 %d 份" % _KP_CLEAR_MAX_DOCS, "n_deleted": 0}
    doc_ids: list[int] = []
    rejected: list[dict] = []
    for x in raw:
        try:
            n = int(str(x).strip())
        except (TypeError, ValueError):
            rejected.append({"value": x, "reason": "不是整数"})
            continue
        if n <= 0:
            rejected.append({"value": x, "reason": "必须是正整数（合法的 doc_id）"})
            continue
        if n not in doc_ids:
            doc_ids.append(n)
    if rejected:
        return {"error": "有 %d 项不是合法的 doc_id，已整批拒绝（一个文件都没删）"
                         % len(rejected),
                "rejected": rejected, "n_deleted": 0}
