            # 并发上限、失败隔离、进度分离都在 `core/kp_batch.py` 里。
            if u.path == "/api/kp-build/batch":
                config.activate("kp")          # 卡 C-0059：按这条管线的配置跑
                return self._json(api_kp_build_batch_start(payload))
            if u.path == "/api/kp-build/batch/cancel":
                return self._json(api_kp_build_batch_cancel(payload))
            # 清除整理产物（卡 C-0050）：人拍板的"清除"功能。**刻意不占
            # `_lock`**——入库可能正占着锁跑几十分钟，占锁就等于"点了没反应"；
            # 它只删本学科产物目录下的产物与备份（见 `api_kp_clear` 的说明）。
            if u.path == "/api/kp-build/clear":
                return self._json(api_kp_clear(payload))
            # 批量入库（卡 C-0037）：**刻意不占 `_lock`**——N 份并发要跑
            # 几十分钟到几小时，占着库锁会把整个看板（连进度查询都进不来）
            # 一起卡死。并发上限、每任务独立写库连接、失败隔离都在
            # `core/pipeline_pool.py` 里；同时只允许一个批次在跑。
            if u.path == "/api/ingest/batch/plan":
                with _lock:
                    # 预估算的是"待处理几份、要识图几页"——只读，用只读连接
                    # （卡 C-0041）：否则入库正忙时点「开始批量入库」，光是弹
                    # 确认框这一步就会卡在 worker 的写锁上。
                    conn = _conn(readonly=True)
                    try:
                        return self._json(api_ingest_batch_plan(payload, conn))
                    finally:
                        conn.close()
            if u.path == "/api/ingest/batch":
                config.activate("ingest")      # 卡 C-0059：按这条管线的配置跑
                return self._json(api_ingest_batch_start(payload))
            if u.path == "/api/ingest/batch/retry":
                return self._json(api_ingest_batch_retry(payload))
            # 取消批量入库（卡 C-0041）：与 `/api/kp-build/batch/cancel` 并列，
            # **刻意不占 `_lock`、不碰库**——取消必须在入库正忙、写锁被 worker
            # 占着时也能立刻进来。它只改执行器内存里那几个状态字段
            # （`core/pipeline_pool.py::cancel`）。
            if u.path == "/api/ingest/batch/cancel":
                return self._json(api_ingest_batch_cancel(payload))
            # 入库耗时较长，单独串行（卡 C-0041：用 `_INGEST_LOCK` 而**不是**
            # `_lock`）——`_lock` 里排着全部只读接口，占着它就等于入库期间
            # 整站不可用。理由与两道安全保证见文件上方 `_INGEST_LOCK` 的说明。
            if u.path == "/api/ingest":
                config.activate("ingest")      # 卡 C-0059：识图/结构分析按这条管线的配置
                with _INGEST_LOCK:
                    return self._json(api_ingest(
                        paths=payload.get("paths") or None,
                        force=bool(payload.get("force")),
                        no_ocr=bool(payload.get("no_ocr")),
                        no_figures=bool(payload.get("no_figures"))))
            if u.path == "/api/cleanup":
                with _lock:
                    return self._json(api_cleanup(
                        dry_run=bool(payload.get("dry_run", True)),
                        include_notes=bool(payload.get("include_notes")),
                        include_mistakes=bool(payload.get("include_mistakes"))))
            if u.path == "/api/import":
                # 大文件通道：直接按本机路径拷贝，不经过 HTTP 传输。
                # 用户实测 645MB 目录走浏览器上传会 fail to fetch，
                # 而看板就在本机，没必要把文件从磁盘传一遍再写回磁盘。
                with _lock:
                    return self._json(api_import_path(
                        payload.get("src", ""),
                        sub=payload.get("sub", "") or "",
                        recursive=bool(payload.get("recursive", True)),
                        dry_run=bool(payload.get("dry_run"))))
            # ===== 课件分享包（卡 C-0080）=====
            # 导出要压几十 MB 的 zip、导入要写几千行块与向量，两者都**不能占
            # `_lock`**（理由见文件上方 `_SHARE_LOCK` 那段说明）。串行由各自
            # 的锁负责：导出占 `_SHARE_LOCK`，导入占 `_INGEST_LOCK`
            # （与单份入库同一把——它们都是"写库的长任务"）。
def api_share_import(payload: dict) -> dict:
    """把一个分享包导进目标学科库。**零模型调用、零费用**（C-0079 保证）。

    冲突三选一（卡面要求）：skip（默认，不动本库已有的那份）/ duplicate
    （再导一份副本，同 content_hash 会出现两行，用于对比来源）/ overwrite
    （**先全量校验新包，通过了才删掉本库那一份**，然后导入）。
    覆盖的这个顺序不能反：反了就是一个坏包先把用户手里的资料删掉再报错。
    """
    zip_arg = str(payload.get("zip") or "").strip().strip('"').strip("'")
    if not zip_arg:
        return {"error": "请先填写分享包路径"}
    zp = Path(zip_arg).expanduser()
    if not zp.is_file():
        return {"error": "找不到分享包：%s" % zp, "kind": "package"}
    on_conflict = str(payload.get("on_conflict") or "skip")
    if on_conflict not in ("skip", "duplicate", "overwrite"):
        return {"error": "未知的冲突处理方式：%s" % on_conflict}
    try:
        tgt = _share_target(str(payload.get("subject") or ""))
    except subjects_mod.SubjectError as e:
        return {"error": str(e), "kind": "subject"}
    _share_prog_reset()
    t0 = time.time()
    removed = None
    try:
        # 写库的长任务与单份入库串行（同一把 `_INGEST_LOCK`），不占 `_lock`
        with _INGEST_LOCK:
            if on_conflict == "overwrite" and Path(tgt["db_path"]).is_file():
                # 先证明这个包是完好的（含向量模型那道闸）——**校验在前，删除在后**。
                # 反了的话，一个坏包会先把用户手里的资料删掉再报错。
                dry = share_mod.import_package(
                    str(zp), db_path=tgt["db_path"], log_dir=tgt["log_dir"],
                    raw_dir=tgt["raw_dir"], root=tgt["root"], dry_run=True)
                hit = dry.get("conflict")
                if hit:
                    conn = db.connect(tgt["db_path"])
                    try:
                        # ★ 删**所有**同 content_hash 的记录，不只是第一条。
                        #   实测踩到：库里因以前的「另存一份」存了两份同一课件时，
                        #   只删一条 ⇒ 紧接着的导入又撞上另一条 ⇒ 返回 skipped，
                        #   用户明明选了"覆盖"，实际什么都没覆盖。
                        ch = conn.execute("SELECT content_hash FROM documents WHERE id=?",
                                          (int(hit["doc_id"]),)).fetchone()["content_hash"]
                        ids = [int(r["id"]) for r in conn.execute(
                            "SELECT id FROM documents WHERE content_hash=? ORDER BY id",
                            (ch,))]
                        removed = {"deleted_doc_ids": [], "chunks_removed": 0}
                        for did in ids:
                            one = api_delete_doc(conn, did)
                            removed["deleted_doc_ids"].append(
                                int(one["deleted_doc_id"]))
                            removed["chunks_removed"] += int(one["chunks_removed"])
                    finally:
                        conn.close()
                    _share_prog("remove", 1, 1)
            res = share_mod.import_package(
                str(zp), db_path=tgt["db_path"], log_dir=tgt["log_dir"],
                raw_dir=tgt["raw_dir"], root=tgt["root"],
                duplicate=(on_conflict == "duplicate"), progress=_share_prog)
    except share_mod.ShareError as e:
        _share_prog_done(str(e))
        return {"error": str(e), "kind": "share", "overwritten": removed,
                "elapsed": round(time.time() - t0, 1)}
    except Exception as e:                  # noqa: BLE001
        msg = "%s: %s" % (type(e).__name__, e)
        _share_prog_done(msg)
        return {"error": "导入失败：" + msg, "overwritten": removed,
                "elapsed": round(time.time() - t0, 1)}
    _share_prog_done()
    took = round(time.time() - t0, 1)
    out = {"ok": True, "status": res.get("status"), "elapsed": took,
           "zip": res.get("zip"), "package_sha256": res.get("package_sha256"),
           "target": {"slug": tgt["slug"], "db": str(tgt["db_path"])},
           "overwritten": removed, "warnings": res.get("warnings") or [],
           "model_calls": int(res.get("model_calls") or 0),
           "cost_cny": float(res.get("cost_cny") or 0.0)}
    if res.get("status") == "skipped":
        out.update({"doc_id": res.get("doc_id"), "title": res.get("existing_title"),
                    "reason": res.get("reason"), "hint": res.get("hint")})
        return out
    out.update({"doc_id": res.get("doc_id"), "title": res.get("title"),
                "path": res.get("path"), "file": res.get("file"),
                "counts": res.get("counts"), "knowledge": res.get("knowledge"),
                "remap": res.get("remap"), "fts": res.get("fts"),
                "source": res.get("source")})
    return out


