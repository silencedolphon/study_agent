def _path_key(p: Path | str) -> str:
    """路径比较用的规范键（绝对 + 小写）。

    Windows 路径大小写不敏感，而"同一份文件"在不同入口里可能写成
    `G:\\study_agent\\raw\\教材\\a.pdf` 或 `g:\\Study_Agent\\RAW\\教材\\A.PDF`。
    比较前必须归一化，否则防覆盖会漏。
    """
    try:
        return str(Path(p).resolve()).lower()
    except OSError:
        return str(p).lower()


def _textbook_locked_map(conn) -> dict[str, dict]:
    """已由教材专线入库的文件：{路径键 -> 文档信息}。

    判据只有 `documents.extra.chunk_scheme == "textbook-v1"` 一条，
    **不看 `role`**：role 说的是"这份资料在教学里扮演什么角色"，
    而这里要认的是"这份资料的切块是哪条管线做出来的"——两件事。
    """
    out: dict[str, dict] = {}
    for r in conn.execute(
            "SELECT id, path, title, n_chunks, extra FROM documents").fetchall():
        try:
            extra = json.loads(r["extra"] or "{}")
        except (TypeError, ValueError):
            continue
        if not isinstance(extra, dict):
            continue
        if extra.get("chunk_scheme") != ingest_mod.TEXTBOOK_CHUNK_SCHEME:
            continue
        rel = str(r["path"] or "")
        if not rel:
            continue
        p = Path(rel)
        if not p.is_absolute():
            p = Path(config.ROOT) / p
        out[_path_key(p)] = {
            "doc_id": int(r["id"]), "path": rel, "title": r["title"] or "",
            "n_chunks": int(r["n_chunks"] or 0),
        }
    return out


def _textbook_blocked_msg(items: list[dict], short: bool = False) -> str:
    """挡住教材专线产物时的提示（`short=True` 给逐条明细用）。"""
    if short:
        return ("教材专线产物：通用入库会用旧切块覆盖按章切块，已跳过"
                "（要重跑请走资料栏的「教材入库」）")
    names = "、".join(str(i.get("title") or i.get("path") or "?")
                     for i in items[:3])
    more = f" 等 {len(items)} 份" if len(items) > 3 else ""
    return f"{names}{more}：{TEXTBOOK_LOCKED_HINT}"


def _drop_textbook_locked(conn,
                          targets: list[Path]) -> tuple[list[Path], list[dict]]:
    """把教材专线产物从通用入库的目标里摘出去 -> (留下的, 被挡下的)。

    目录会被**展开成文件**再判：「入库全部待处理文件」给的正是 `raw\\`
    这一个目录，不展开就一条都认不出来——而那恰恰是方案文档点名的场景。
    """
    locked = _textbook_locked_map(conn)
    if not locked:
        return list(targets), []
    keep: list[Path] = []
    blocked: list[dict] = []
    seen: set[str] = set()
    for t in targets:
        for f in ingest_mod.iter_files([Path(t)]):
            key = _path_key(f)
            if key in seen:
                continue
            seen.add(key)
            info = locked.get(key)
            if info:
                blocked.append({**info, "abs": str(f)})
            else:
                keep.append(f)
    return keep, blocked


def _drop_textbook_locked_raw(conn,
                              rels: list[str]) -> tuple[list[str], list[dict]]:
    """同上，但输入是**批量入库**用的 `raw/` 相对路径（前端给的 `d.rel`）。"""
    locked = _textbook_locked_map(conn)
    if not locked:
        return list(rels), []
    keep: list[str] = []
    blocked: list[dict] = []
    for rel in rels:
        try:
            key = _path_key(_safe_raw_path(rel))
        except ValueError:
            keep.append(rel)      # 非法路径交给下游原样报错，不在这一层吞掉
            continue
        info = locked.get(key)
        if info:
            blocked.append({**info, "rel": rel})
        else:
            keep.append(rel)
    return keep, blocked


def _inside_dir(path: Path, parent: Path) -> bool:
    """`path` 是否就在 `parent` 目录里（含 parent 自身）。"""
    try:
        pp, qq = Path(path).resolve(), Path(parent).resolve()
    except OSError:
        return False
    return pp == qq or qq in pp.parents


_PAGE_REF_RE = re.compile(r"p\.(\d+)(?:\s*-\s*(\d+))?")


def _page_span(ref: str) -> tuple[int, int]:
    """`source_ref`（p.216-218 / p.17 / p.5 图）-> (起页, 止页)。"""
    m = _PAGE_REF_RE.search(ref or "")
    if not m:
        return 0, 0
    a = int(m.group(1))
    return a, int(m.group(2) or a)
