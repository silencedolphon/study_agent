        <button class="ghost" onclick="deleteDoc(${d.id}, ${JSON.stringify(d.path).replace(/"/g,'&quot;')},
          ${JSON.stringify(d.title||d.path).replace(/"/g,'&quot;')})"
          style="color:var(--bad);border-color:#4a1f1c">移除</button>
      </td>
    </tr>`;
  }).join('');

  const fileRows = rawFiles.map(f => {
    const st = STATE[f.state] || {label:f.state, cls:''};
    const acts = [];
    if (f.state === 'indexed') {
      acts.push(`<button class="ghost" onclick="reindex('${esc(f.rel)}', true)">重建</button>`);
      acts.push(`<button class="ghost" onclick="deleteDoc(${f.doc_id}, '${esc(f.rel)}', '${esc(f.name)}')"
        style="color:var(--bad);border-color:#4a1f1c">移除</button>`);
    } else if (f.supported) {
      acts.push(`<button class="ghost" onclick="reindex('${esc(f.rel)}')">入库</button>`);
    }
    acts.push(`<button class="ghost" onclick="renameRawFile(${f.doc_id || 'null'}, ${JSON.stringify(f.rel).replace(/"/g,'&quot;')}, ${JSON.stringify(f.name).replace(/"/g,'&quot;')})"
      title="改 raw 目录里这个文件的文件名${f.state === 'indexed' ? '（库里路径与页图目录会一起改）' : ''}">改名</button>`);
    acts.push(`<button class="ghost" onclick="deleteRaw('${esc(f.rel)}', ${f.doc_id || 'null'})"
      style="color:var(--bad);border-color:#4a1f1c">删文件</button>`);
    return `<tr>
      <td>${esc(f.name)}
        ${f.supported ? '' : '<span class="badge bad">格式不支持</span>'}
        <div class="small muted">${esc(f.rel)}</div></td>
      <td class="small">${fmtSize(f.size)}</td>
      <td><span class="badge ${st.cls}">${st.label}</span></td>
      <td class="small" style="white-space:nowrap">${acts.join(' ')}</td>
    </tr>`;
  }).join('');

  const orphanNote = orphans.length ? `
    <div class="card" style="margin-top:14px">
      <h2>索引中有、但 raw 里已找不到的文件 · ${orphans.length} 个</h2>
      <div class="sub" style="margin-bottom:10px">
        这些是手工把源文件移走或改名后留下的记录。移除后相关切块会一并删除。
      </div>
      <table><tbody>${orphans.map(o => `<tr>
        <td>${esc(o.path)}</td>
        <td class="small">${o.n_chunks} 块</td>
        <td><button class="ghost" onclick="deleteDoc(${o.id}, '${esc(o.path)}', '${esc(o.path)}')"
          style="color:var(--bad);border-color:#4a1f1c">移除索引</button></td>
      </tr>`).join('')}</tbody></table>
    </div>` : '';

  $('#view').innerHTML = `
    ${docsRes.stale ? `<div class="card" style="border-color:#7a5a1e;background:#2a2113">
      <b>${esc(docsRes.stale)}</b>
    </div>` : ''}
    <div class="card">
      <div class="row" id="docs-tabs">${tabBar}</div>
      <div class="sub" style="margin-top:8px">
        两个子页签各自只列本库的文件与已入库文档。<b>进哪个库由文件的目录决定</b>：
        <kbd>raw\\药理题库\\</kbd>（试题）、<kbd>raw\\学习笔记\\</kbd>（资料笔记）进辅库，
        其余进主库。
      </div>
    </div>
    <div class="card" style="margin-top:14px">
      <h2>添加资料</h2>

      <div class="sub" style="margin:10px 0 6px">
        <b>方式一：从本机路径导入</b>（推荐，尤其适合大文件或整个文件夹）
      </div>
      <div class="row">
        <!-- 卡 C-0074：占位符原来写的是作者本机的绝对路径（含开发者用户名）。
             这一栏是给**拿到 exe 的外部用户**看的，写别人的用户名既没用、
             又是把开发者痕迹印在了界面上。改成中性示例。 -->
        <input id="im-src" placeholder="粘贴本机路径，如 D:\\我的课件\\第一讲.pdf"
          style="flex:1;min-width:260px">
        <input id="im-sub" list="folder-list" placeholder="放到 raw\\ 下的子文件夹（可留空）"
          style="width:210px">
        <button class="act" id="im-go">导入</button>
        <datalist id="folder-list">
          ${folderOpts.map(f=>`<option value="${esc(f)}">`).join('')}
        </datalist>
      </div>
      <div class="sub" style="margin-top:6px">
        看板在本机运行，可以直接读磁盘——不走 HTTP，<b>没有大小限制、不吃内存</b>，
        几百 MB 的 PDF 或几十个文件一次导入都没问题。
      </div>

      <!-- 卡 C-0083：拖拽入库。刻意紧贴「方式一」——两者都是"把文件放进
           raw\\"，只是一个粘路径、一个拖文件。也刻意**不占**「方式N」编号：
           下面 C-0080 的分享包仍是「方式二」，那一节一个字都不动。 -->
      <div class="sub" style="margin:14px 0 6px">
        <b>拖拽入库</b>——把文件（可一次多个）直接拖进下面的框里松手
      </div>
      <div class="dz" id="dz">
        <div class="dz-hint" id="dz-hint">
          把文件拖到这里松手 → 上传进 <kbd>raw\\</kbd><br>
          <span class="small">放到哪个子文件夹由上面「方式一」那一栏决定
            （留空＝raw\\ 根目录）</span>
        </div>
        <div class="dz-foot">
          <label><input type="checkbox" id="dz-auto">
            上传后立即入库（<b>要花识图钱</b>，默认关）</label>
        </div>
        <div class="dz-bar-wrap"><div class="dz-bar" id="dz-bar"></div></div>
        <div class="dz-foot">
          <span id="dz-state">等待文件…</span><span id="dz-pct"></span>
        </div>
        <div id="dz-log"></div>
      </div>
      <div class="sub" style="margin-top:6px">
        拖拽走的是浏览器上传（multipart），所以<b>单个几百 MB 的文件可能被浏览器
        自己掐断</b>（实测 645MB 会 fail to fetch，服务端根本没收到）——
        那种文件请走上面的「方式一」。拖进来的文件<b>只放进 raw\\，
        不会自动入库</b>：入库要识图（约 25 秒/页且按页计费），
        勾选与提交仍由下面的「批量入库」决定，与「方式一」逐字同义。
      </div>

      <!-- 卡 C-0089：教材入库的**独立入口**。人的原话是「在资料栏专门开一个
           按钮来负责教材入库」，所以这一节自成一段，与「方式一 / 拖拽」
           并列——它不只是"把文件放进 raw\"，而是一条龙跑完整条教材专线：
           拷进 raw\教材\ → 本地免费 OCR → 按章切块 → 入库。
           刻意不占「方式N」编号：方式一是路径导入、方式二是分享包，都不是它。
           位置按要求落在拖拽说明之后、旧文案之前，上面两段一个字都没动。 -->
      <div class="sub" style="margin-top:16px;border-top:1px solid var(--line);padding-top:12px">
        <b>教材入库（专线）</b>——<b>教材只从这里进</b>，别用下面的「入库全部待处理文件」
      </div>
      <div class="row" style="margin-top:8px">
        <input id="tb-src"
          placeholder="教材文件或文件夹的本机路径，如 D:\\教材\\药理学 第6版.pdf"
          style="flex:1;min-width:260px">
        <button class="act" id="tb-go" onclick="tbIngest()">选择教材并入库</button>
      </div>
      <div class="row" style="margin-top:8px">
        <label class="small muted"><input type="checkbox" id="tb-force">
          内容未变也重跑（会重建块的 id，引用它的知识点出处会失效）</label>
      </div>
      <div class="sub" style="margin-top:6px">
        <b>一条龙</b>，不问第二遍：文件先拷进 <kbd>raw\\教材\\</kbd>，再用
        <b>本地 OCR 识图</b>（免费、不调视觉模型、约 2~16 秒/页），然后
        <b>按章切块</b>入库（章内仍按 700/1100 字切，只保证不跨章）。
        这是<b>长任务、串行</b>的：几百页的教材要跑一两个小时，期间可以离开这一页。<br>
        入库后这份资料会被打上 <b>chunk_scheme=textbook-v1</b> 标记，
        「入库全部待处理文件」与批量入库遇到它会<b>跳过</b>——
        不会用旧切块把按章切块覆盖掉。<br>
        跑完这里会列出<b>识别到的章（章号 + 章名 + 页范围）与块数变化</b>，
        供你事后核对；章识别失败（少于 3 章）会如实标成"降级"，不假装成功。
      </div>
      <div id="tb-log"></div>

      <div class="sub" style="margin-top:14px">
        这种方式只是把文件放进 <kbd>raw\\</kbd>，<b>不会自动入库</b>——
        方便你先确认放在哪里。之后点下面的「入库」才会解析并建立索引。
        也可以直接用资源管理器把文件拷进 <kbd>${esc(raw.raw_dir)}</kbd>，然后点刷新。
      </div>
      <div class="row" style="margin-top:12px">
        <button class="act" onclick="reindex(null)">入库全部待处理文件</button>
        <button class="ghost" onclick="reindex(null, true)">全部强制重建</button>
        <button class="ghost" onclick="openCleanup()">清理无出处的记录</button>
        <button class="ghost" onclick="go('docs')">刷新列表</button>
        ${pending ? `<span class="badge warn">${pending} 个待入库</span>`
          : `<span class="badge ok">${c.unsupported ? '可入库的都已入库' : '全部已入库'}</span>${
              c.unsupported ? `<span class="badge bad">${c.unsupported} 个格式不支持</span>` : ''}`}
      </div>
      <div class="sub" style="margin-top:8px">
        「入库全部待处理文件」<b>两个库一起入</b>：一份资料进哪个库由它所在的<b>目录</b>决定，
        不由此按钮决定，所以两个子页签下都显示它。
      </div>
      <div class="sub" style="margin-top:8px">
        删掉资料后，以它为出处的知识点会失去支撑。删文档时已自动清理这类孤儿记录；
        若之前留下的历史孤儿还在，点「清理无出处的记录」一并收拾。
      </div>

      <!-- 方式二：导入分享包（卡 C-0080）。刻意放在卡片末尾：不动上面任何一段
           既有布局与文案，只往下接一节。 -->
      <div class="sub" style="margin-top:16px;border-top:1px solid var(--line);padding-top:12px">
        <b>方式二：导入分享包（.zip）</b>——别人用「导出」键打出来的课件包，
        里面<b>已经带着切块、向量与知识点总结</b>：导入后立刻能检索、能问答，
        <b>不调用任何模型、不花一分钱接口费</b>。
      </div>
      <div class="row" style="margin-top:8px">
        <input id="sh-zip" placeholder="分享包完整路径，如 D:\\下载\\第一讲-share.zip"
          style="flex:1;min-width:260px">
        <button class="act" id="sh-open">看包信息并导入</button>
// 资料页的两个子页签（卡 C-0021，方案 §7.2）：教材+课件 = 主库（main），
// 试题+资料笔记 = 辅库（aux）。
//
// 它是**资料页内部的二级状态**，不是主导航——VIEWS 仍是 8 项，不新增条目。
// 状态只存在内存里（方案 §7.3 选 S1：现状本就没有任何 URL 状态，加 hash 路由
// 要同步 20+ 处 go() 调用，属独立需求）。刷新回默认，与现状"刷新回问答页"一致。
let DOCS_TAB = 'main';
const DOCS_TABS = { main:'教材与课件', aux:'题库与笔记' };
// 已入库列表**始终**显示库徽章：在 main 页签里要能一眼看出有没有混进试题，
// 所以即使在 aux 页签（那里每行都是辅库）也不省略。
const CORPUS_BADGE = { main:{label:'主库', cls:'ok'}, aux:{label:'辅库', cls:'warn'} };

function docsTab(k){
  if (!DOCS_TABS[k] || k === DOCS_TAB) return;
  DOCS_TAB = k;
  go('docs');          // 复用主导航的渲染：切页签后进度条恢复等逻辑一并保留
}

const STATE = {
  new:       {label:'未入库', cls:'warn'},
  changed:   {label:'内容有变', cls:'warn'},
  indexed:   {label:'已入库', cls:'ok'},
};

async function viewDocs(){
  const [docsRes, rawRes] = await Promise.all([api('/api/docs'), api('/api/raw')]);
  const raw = rawRes;

  // 按当前子页签过滤：两个库的文件与已入库文档互不混显。
  // corpus 由**文件路径**决定（core/db.py 的 classify_corpus），不由文件名决定。
  const filesOf = k => raw.files.filter(f => (f.corpus||'main') === k);
  // 「待入库」= 本库里还没入库、且格式支持的文件。
  // 页签按钮的角标与下面卡片的角标**共用这一个函数**，两处数字必然相等，
  // 也等于列表里「未入库且支持」的行数。
  const pendingOf = k => filesOf(k).filter(f => f.state !== 'indexed' && f.supported).length;

  const documents = docsRes.documents.filter(d => (d.corpus||'main') === DOCS_TAB);
  const rawFiles  = filesOf(DOCS_TAB);
  const orphans   = (raw.orphans||[]).filter(o => (o.corpus||'main') === DOCS_TAB);
  // 计数取**本库**那一份（后端的 counts_by_corpus）。若这里仍用全量的 raw.counts，
  // 角标就会写"两个库加起来"的数，而列表只有当前库的行——正是方案 §7.4 末尾
  // 点名的那个可见 bug（"4 个待入库"但列表只有 1 个）。
  const c = (raw.counts_by_corpus || {})[DOCS_TAB] || raw.counts;

  const pending = pendingOf(DOCS_TAB);
  // 批量入库（卡 C-0037）的候选：本库里**未入库且格式支持**的文件。
  // 与上面 pendingOf 用的是同一个判据，所以角标数字与可勾选的行数必然相等。
  const pendingFiles = rawFiles.filter(f => f.state !== 'indexed' && f.supported);

  // 二级页签栏：选中态复用既有的 .ghost.on 样式，不新增 CSS。
  //
  // 卡 C-0097②（方案 §2.2 第 7 条）：页签**原地保留**——它是主导航，收纳导航会让人
  // 迷路（方案 P4）；只把角标从「8 待入库」改成纯数字 `8` + tooltip，省掉三个字的重复。
  // 同一条里收下 D8：那段 75 字的「两个子页签各自只列本库的文件与已入库文档…」整段
  // 移出页面，只把"进哪个库由目录决定"这句规则挂到页签 tooltip 上（成段说明按方案
  // §3.1 口径归该页的「?」帮助弹窗，那是后续卡的事）。
  const tabHint = '进哪个库由文件的目录决定：raw\\药理题库\\、raw\\学习笔记\\ 进辅库，其余进主库';
  const tabBar = Object.entries(DOCS_TABS).map(([k, label]) => {
    const n = pendingOf(k);
    return `<button class="ghost ${k === DOCS_TAB ? 'on' : ''}"
      onclick="docsTab('${k}')" title="${tabHint}">${label}${
      n ? ` <span class="badge warn" title="${n} 个待入库">${n}</span>` : ''}</button>`;
  }).join(' ');

  // 「放到 raw\ 下的哪个子目录」的候选：本库真实存在的目录 + 本库的推荐目录。
  // 按当前子页签给候选，是为了让"路径决定库归属"这条规则在 UI 上可见；
  // 去重是因为推荐目录往往已经存在（如 raw\药理题库\）。
  const folderOpts = [...new Set([
    ...((raw.folders_by_corpus || {})[DOCS_TAB] || raw.folders || []).filter(Boolean),
    ...(DOCS_TAB === 'aux' ? ['药理题库', '学习笔记'] : ['教材', '课件']),
  ])];

  const rows = documents.map(d => {
    const cb = CORPUS_BADGE[d.corpus || 'main'] || CORPUS_BADGE.main;
    return `
    <tr>
      <td class="ds-td"><input type="checkbox" class="ds-cb" data-doc="${d.id}"
        title="勾选后可批量真删"></td>
      <td><a href="#" onclick="openDoc(${d.id});return false">${esc(d.title||d.path)}</a>
        <div class="small muted">${esc(d.path)}</div></td>
      <td><span class="badge">${esc(d.kind)}</span>
        <span class="badge ${d.role === 'textbook' ? 'ok' : ''}">${
          d.role === 'textbook' ? '教材' : '课件'}</span></td>
      <td><span class="badge ${cb.cls}">${cb.label}</span></td>
      <td class="small">${d.n_chunks}</td>
      <td class="small">${d.n_chars}</td>
      <td>${d.status==='ok'
        ? '<span class="badge ok">正常</span>'
        : `<span class="badge warn">${esc(d.status)}</span>`}</td>
      <td class="small muted">${fmtTime(d.indexed_at)}</td>
      <td class="small" style="white-space:nowrap">
        <button class="ghost" onclick="reindexOne(${d.id})"
          title="重建：按文件当前内容重新解析并覆盖索引（源文件改过之后用它）">重建</button>
        <button class="ghost" onclick="docsDocRowMenu(this)"
          data-id="${d.id}" data-title="${esc(d.title||d.path)}"
          data-title-cur="${esc(d.title||'')}" data-path="${esc(d.path)}"
          data-rel="${esc(d.rel||'')}"
          data-name="${esc((d.rel||'').split('/').pop()||'')}"
          title="这一行的其余操作：导出分享包 / 改标题 / 改名 / 移除">⋯</button>
      </td>
    </tr>`;
  }).join('');

  const fileRows = rawFiles.map(f => {
    const st = STATE[f.state] || {label:f.state, cls:''};
    // 卡 C-0098③（方案 §2.2 第 6 条）：raw 表与「已入库资料」表**同一套规则**——
    // 行内只留该行最高频的一个主操作（待入库＝「入库」，已入库＝「重建」）+ 行内「⋯」；
    // 改名 / 删文件 / 移除索引进菜单，两个不可逆项用危险色。同一页两套规则会让人
    // 困惑，所以这里的形状与上面的 rows 逐条对齐。
    const mainAct = f.state === 'indexed'
      ? `<button class="ghost" onclick="reindex('${esc(f.rel)}', true)"
          title="重建：按文件当前内容重新解析并覆盖索引（源文件改过之后用它）">重建</button>`
      : (f.supported
        ? `<button class="ghost" onclick="reindex('${esc(f.rel)}')"
            title="入库：把这份文件解析、识别图片、切块嵌入并写进索引">入库</button>`
        : '');
    return `<tr>
      <td>${esc(f.name)}
        ${f.supported ? '' : '<span class="badge bad">格式不支持</span>'}
        <div class="small muted">${esc(f.rel)}</div></td>
      <td class="small">${fmtSize(f.size)}</td>
      <td><span class="badge ${st.cls}">${st.label}</span></td>
      <td class="small" style="white-space:nowrap">${mainAct}
        <button class="ghost" onclick="docsFileRowMenu(this)"
          data-rel="${esc(f.rel)}" data-name="${esc(f.name)}"
          data-doc="${f.doc_id || ''}"
          data-indexed="${f.state === 'indexed' ? '1' : ''}"
        <div class="small muted">${esc(f.rel)}</div></td>
      <td class="small">${fmtSize(f.size)}</td>
      <td><span class="badge ${st.cls}">${st.label}</span></td>
      <td class="small" style="white-space:nowrap">${acts.join(' ')}</td>
    </tr>`;
  }).join('');

  // 孤儿记录（方案 §2.2 第 9 条）：位置不变，但**默认折叠成一行提示条**。
  // 它是异常态（平时 0 个），一旦出现要显眼——所以用 warn 色 + ⚠ + 数字，
  // 但不该平时占一整张卡的版面。用原生 <details>：不新增 CSS、不写 JS。
  // D13 那 40 字（「这些是手工把源文件移走或改名后留下的记录…」）按方案**保留**，
