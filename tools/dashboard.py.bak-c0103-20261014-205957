        for m in info["migrations"]:
            print(f"  迁移: {m}")
    print("  按 Ctrl+C 停止")
    if not args.no_open:
        threading.Timer(0.6, lambda: webbrowser.open(url)).start()
    # [重建] 原文件在 `print(f"学习看板已启动: {url}")` 之后被截断（恢复版只剩到这一行），
    # 且被截掉的那段**错位插进了上面的 HTML/JS 字符串中间**。
    # 以下按"看板必须能起、且 Ctrl+C 能干净退出"补全：
    # 端口占用 / 权限不足要给**人话**而不是 traceback（用户双击 .cmd，看不到栈）。
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        print("\n已停止")
    except OSError as e:
        print(f"\n端口 {args.port} 起不来：{e}", file=sys.stderr)
        print("  换个端口试试：--port 8757", file=sys.stderr)
        try:
