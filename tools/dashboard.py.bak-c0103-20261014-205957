    # 没有它的话，用户手工建的每个知识点都会在下次清理时消失。
    orphan_ids = [
        int(r["id"]) for r in conn.execute(
            """SELECT k.id FROM knowledge_points k
               WHERE COALESCE(k.had_sources, 0) = 1
                 AND NOT EXISTS (SELECT 1 FROM kp_sources s WHERE s.kp_id = k.id)"""
        )
    ]
    if expected_kp is not None:
        orphan_ids = [i for i in orphan_ids if i != int(expected_kp)]
