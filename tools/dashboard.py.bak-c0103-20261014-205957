def api_kp_textbook(doc_id: int, kp_id: str, limit: int = 0,
                    material_limit: int = 0, tb_doc_id: int = 0) -> dict:
    """知识点 → 自己的原料块原文 + 教材里对应的原文段落（卡 C-0093）。

    数据来源：
      · 知识点本身：`logs/knowledge/*.json`（看板自己的 `_lkp_index`，带进程内缓存）；
      · 原料块原文：`knowledge_points[].material[].chunk_id` → `chunks.text`；
      · 教材段落：当前学科库 `role='textbook'` 的 PDF，按其 `chunks` 做词项定位。

    任何"取不到"都不是错误（照旧 HTTP 200 + 明确说法）：没有这条知识点 →
    `status=no_kp`；当前库没有教材 → `status=no_textbook`；教材里没匹配上 →
    `status=no_match`。前端只要认 `status` 就能决定画什么。
    """
    conn = None
    try:
        conn = _conn(readonly=True)     # 只读：见 `_conn()` 的说明（卡 C-0041）
        idx = _lkp_index(doc_id)
        kp = (idx.get("by_id") or {}).get(str(kp_id or "").strip())
        return teach_mod.kp_textbook(
            conn, doc_id=doc_id, kp_id=kp_id, kp=kp, limit=limit,
            material_limit=material_limit, tb_doc_id=tb_doc_id)
    except Exception as e:  # noqa: BLE001 - 接口层兜底：坏产物不该变成 500 白屏
        return {"doc_id": int(doc_id or 0), "kp_id": str(kp_id or ""),
                "status": "error", "message": f"教材原文读取失败：{e}",
                "material": {"blocks": [], "n_material": 0, "n_returned": 0,
                             "limit": 0, "truncated": False},
                "textbook": {}}
    finally:
        if conn is not None:
            conn.close()


def api_teach_page(doc_id, page, dpi=0) -> dict:
    """教材某一页的 PNG（卡 C-0093，**零模型调用**）。

    安全全在 `core.teach.resolve_textbook_pdf()` 里（只放行教材类 PDF、
    路径必须落在资料库目录内、页码必须落在 1..总页数）。这里只负责把
    拒绝理由翻译成 HTTP 状态码——**不抛异常**，也不回 500 白屏。
    """
    conn = None
    try:
        conn = _conn(readonly=True)
        got = teach_mod.page_png(conn, doc_id, page, dpi=_int_arg(dpi))
        return {"ok": True, "code": 200, "png": got["png"], **{
            k: v for k, v in got.items() if k != "png"}}
    except teach_mod.TeachError as e:
        return {"ok": False, "code": int(e.code), "error": e.message}
    except Exception as e:  # noqa: BLE001 - 渲染失败也要给人话，不是堆栈
        return {"ok": False, "code": 500, "error": f"教材页渲染失败：{e}"}
    finally:
        if conn is not None:
            conn.close()


def api_mindmap(conn, doc_id: int = 0) -> dict:
    """课件思维导图（卡 C-0050：**数据源 = 整理产物**）。

    不带 doc_id：列页签能看的课件（库内文档 ∪ 有产物的文档），每份带产物状态。
    带了 doc_id：返回该课件的结构树（产物 `structure.root`）+ 知识点标记。

    ★ 三种"显示不了"的状态都**不是错误**（照旧 HTTP 200 + 明确文案，见
    `_ARTIFACT_MESSAGE`）：`none` 还没整理过 / `legacy` 旧格式（人拍板：保留
    文件、页签不显示）/ `incomplete` 上次整理中断。前端 `api()` 见到 `error`
    字段会抛异常，那样用户看到的是"出错"，而真相是"这份还没整理"。

    ★ 兼容字段：`has_outline` 保留为 `has_structure` 的**同义别名**（老脚本读它
    不会 KeyError）；它的语义已从"有入库结构缓存"变成"有可展示的整理结构树"，
    真正的判据看 `artifact_state`。
    """
    if doc_id <= 0:
        items = _artifact_doc_list(conn)
        return {"documents": items, "n": len(items), "data_source": "artifact"}
    art = _artifact_load(doc_id)
    row = conn.execute(
        "SELECT id, title, kind, path, n_chunks, status FROM documents WHERE id=?",
        (doc_id,),
    ).fetchone()
    doc = dict(row) if row else {}
    meta = art["meta"] if isinstance(art.get("meta"), dict) else {}
    sm = art.get("summary") or {}
    state = str(art.get("state") or _ARTIFACT_NONE)
    ok = state == _ARTIFACT_V2_STATE
    idx = _lkp_index(doc_id)
    out = {
        "doc_id": doc_id,
        "title": doc.get("title") or ("文档 %d" % doc_id),
        "kind": doc.get("kind") or "",
        "in_library": row is not None,
        "data_source": "artifact",
        "artifact_state": state,
        "artifact_source": str(art.get("source") or art.get("name") or ""),
        "artifact_message": "" if ok else _ARTIFACT_MESSAGE.get(state, ""),
        "has_structure": ok,
        "has_outline": ok,          # 兼容别名，见 docstring
        "pipeline_version": str(sm.get("pipeline_version") or ""),
        "lkp_available": bool(idx.get("by_id")),
        "lkp_total": len(idx.get("by_id") or {}),
        "lkp_source": str(idx.get("source") or ""),
        "lkp_source_card": str(sm.get("source_card") or meta.get("source_card") or ""),
    }
    if not ok:
        # 没有可展示的结构：**如实说清**是哪一种"没有"，并给出下一步。
        out.update({
            "tree": [], "n_pages": 0, "n_nodes": 0,
            "message": out["artifact_message"],
            "model": "", "created_at": None, "generated_at": "", "cost_cny": 0.0,
            "lkp_ready": 0, "lkp_pending": 0, "lkp_leaf_nodes": 0,
            "lkp_multi_nodes": 0, "lkp_parent_pages": 0, "lkp_stats": {},
            "lkp_excluded_pages": [], "lkp_excluded_reason": "",
        })
        return out
    tree, stats = _artifact_tree(art["doc"], doc_id)
    out.update({
        "model": str(sm.get("model") or ""),
        "created_at": sm.get("created_at"),
        "generated_at": str(sm.get("generated_at") or ""),
        "cost_cny": float(sm.get("cost_cny") or 0.0),
        "n_pages": int(sm.get("n_pages") or 0),
        "n_nodes": _n_nodes(tree),
        "tree": tree,
        "message": "",
        # 末级知识点：ready = 已有总结（点得开），pending = 挂上了但正文待生成。
        # ⚠ 卡 C-0046 的两个口径在这里**仍然分开**，别当分子分母：
        #   lkp_total = 产物的知识点**条数**（by_id 的键数）
        return "empty", ("该课件的名词解释产物里一个名词都没有（筛选模式 %s）："
                         "这份课件可能确实没有值得考名词解释的术语。"
                         % (str((own_meta.get("terms_filter") or {}).get("mode") or "—")))
    state = str(art.get("state") or _ARTIFACT_NONE)
    if state == _ARTIFACT_NONE:
        return "stale", ("该课件还没有整理过知识点；名词解释是**独立功能**"
                         "（`tools/terms_build.py --doc <id>`），生成之后就会显示在这里。")
    if state == _ARTIFACT_INCOMPLETE:
        return "incomplete", ("这份课件的产物不完整（可能上次整理中断）；"
                              "重新整理一次就会有知识点，名词解释另用 `tools/terms_build.py` 生成。")
    if state == _ARTIFACT_LEGACY:
        return "legacy", ("这份课件的产物是旧格式（%s），页签读不出来；"
                          "重新整理一次就会有知识点。" % (ver or "无版本号"))
    if ver in _KP_TERMS_IN_OWN_FILE:
        # v4 起产物不再带 terms：这一栏去读独立产物，读到没有就说清怎么生成
        return "empty", ("该课件还没生成名词解释。卡 C-0058 起名词解释是**独立功能**"
                         "（`tools/terms_build.py --doc <id>`），产物是 "
                         "`logs/knowledge/<doc_id>-名词解释.json`；生成后这里就有内容。")
    return "empty", ("该课件暂无名词解释：这份产物（%s）是名词解释功能上线前"
            pl = _terms_payload(art, did)
            item = dict(d)
            item.update({"n_terms": pl["n_terms"], "terms_state": pl["terms_state"],
                         "terms_source": pl["terms_source"],
                         "pipeline_version": pl["pipeline_version"]})
            items.append(item)
        return {"documents": items, "n": len(items), "data_source": "artifact"}
    art = _artifact_load(doc_id)
    row = None
    try:
        row = conn.execute("SELECT id, title FROM documents WHERE id=?",
                           (doc_id,)).fetchone()
    except sqlite3.Error:
        row = None
    out = {"doc_id": doc_id,
           "title": (str(dict(row).get("title") or "") if row else "")
                    or ("文档 %d" % doc_id),
           "in_library": row is not None,
           "artifact_state": str(art.get("state") or _ARTIFACT_NONE),
           "n_kps": int((art.get("summary") or {}).get("n_kps") or 0)}
    out.update(_terms_payload(art, doc_id))
    return out


# ---------------- 一键整理知识点（卡 C-0035，只读库 + 只写 logs/knowledge） ----------------
#
# 人要求：在「知识点」页签点一个按钮，选一份课件就能把知识点整理出来，
# **不再需要开 dsh 会话跑脚本**（以前都是大管家开卡、施工会话跑 py）。
#
# 管线本身在 `core/kp_build.py`，命令行 `tools/kp_build.py` 走的是**同一份实现**；
# 这里只做三件事：列可选课件 + 预估、启动后台线程、报进度。
#
# ⚠ **写库禁止**：整理只产出 `logs/knowledge/<doc_id>-末级知识点总结.json`，
#   不碰 `knowledge_points` / `kp_sources` / `reviews` / `mistakes` / `kp_edges`
#   任何一张表（真库对这五张表仍是全 0 行）。
# ⚠ 启动接口**不进 `_lock`**：整理要跑几分钟到几十分钟（每条一次模型调用），
#   占着库锁会把整个看板卡死——入库那条路是靠"请求挂很久 + 轮询进度"扛的，
#   这里开后台线程，请求立刻返回，进度走 `/api/kp-build/progress`。
#   并发保护在 `kp_build.start_background()`（`is_running()`）：同时只允许一个。
_KP_OPT_CACHE: dict = {"sig": None, "t": 0.0, "data": None}
_KP_OPT_TTL = 20.0   # 秒：列课件要读 40 份 outline + 真库块，别每次点击都重算


def _terms_own_file(doc_id: int) -> tuple[list[dict], dict]:
    """**独立名词解释产物**（卡 C-0058）：`logs/knowledge/<doc_id>-名词解释.json`。

    返回 `(terms, meta)`；文件不在 / 坏了 / 没有 `terms` → `([], {})`。
    路径从 `kp_build` 取（`terms_out_file`），不在这里另抄一份目录口径。
    只读、不调模型、不写任何东西——与 `_artifact_load()` 同一套容错风格。
    """
    try:
        p = Path(kp_build_mod.terms_out_file(int(doc_id)))
    except Exception:  # noqa: BLE001  （路径都给不出来时只当没有，不报错）
        return [], {}
    if not p.is_file():
        return [], {}
    try:
        raw = json.loads(p.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return [], {}
    if not isinstance(raw, dict):
        return [], {}
    ts = raw.get("terms")
    meta = raw.get("meta") if isinstance(raw.get("meta"), dict) else {}
    return ([t for t in ts if isinstance(t, dict)] if isinstance(ts, list) else []), meta


def _terms_state(art: dict, terms: list[dict], own_meta: dict | None = None) -> tuple[str, str]:
    """名词解释的状态 + 一句"为什么没有 / 下一步做什么"的人话。

    `ok` 有名词（独立产物或旧产物的 `terms` 都算）/
    `empty` 这一版产物本来就没有 `terms` 这一节（`C-0058-v4` 起，或 C-0051 之前的旧产物）/
    `legacy` 旧格式 / `incomplete` 整理中断 / `stale` 还没整理过。
    后四种都**不是错误**（照 `_ARTIFACT_MESSAGE` 的风格：页签不能看起来像坏了）。
    """
    ver = str((art.get("meta") or {}).get("pipeline_version") or "")
    if terms:
        return "ok", ""
    own_meta = own_meta or {}
    if own_meta:
        # 独立产物在、却一个名词都没有：那是这份课件确实挑不出考点名词（提炼/筛选都可能为空）
        return "empty", ("该课件的名词解释产物里一个名词都没有（筛选模式 %s）："
                         "这份课件可能确实没有值得考名词解释的术语。"
                         % (str((own_meta.get("terms_filter") or {}).get("mode") or "—")))
    state = str(art.get("state") or _ARTIFACT_NONE)
    if state == _ARTIFACT_NONE:
        return "stale", ("该课件还没有整理过知识点；名词解释是**独立功能**"
                         "（`tools/terms_build.py --doc <id>`），生成之后就会显示在这里。")
    if state == _ARTIFACT_INCOMPLETE:
        return "incomplete", ("这份课件的产物不完整（可能上次整理中断）；"
                              "重新整理一次就会有知识点，名词解释另用 `tools/terms_build.py` 生成。")
    if state == _ARTIFACT_LEGACY:
        return "legacy", ("这份课件的产物是旧格式（%s），页签读不出来；"
                          "重新整理一次就会有知识点。" % (ver or "无版本号"))
    if ver in _KP_TERMS_IN_OWN_FILE:
        # v4 起产物不再带 terms：这一栏去读独立产物，读到没有就说清怎么生成
        return "empty", ("该课件还没生成名词解释。卡 C-0058 起名词解释是**独立功能**"
                         "（`tools/terms_build.py --doc <id>`），产物是 "
                         "`logs/knowledge/<doc_id>-名词解释.json`；生成后这里就有内容。")
    return "empty", ("该课件暂无名词解释：这份产物（%s）是名词解释功能上线前"
                     "整理的，没有这一节；重新整理一次就会出现。" % (ver or "—"))


def _terms_payload(art: dict, doc_id: int = 0) -> dict:
    """一份产物的名词解释（两个入口共用；字段口径只在这里写一次）。

    卡 C-0058 起取值顺序：**独立产物优先 → 知识点产物顶层 `terms` 回落**。
    `terms_source` 如实写明这一次是从哪儿读到的（`own_file` / `kp_artifact` / 空）。
    """
    terms, own_meta = _terms_own_file(doc_id) if doc_id else ([], {})
    source = "own_file" if terms else ""
    if not terms:
        terms = _terms_of(art)
        source = "kp_artifact" if terms else ""
    state, msg = _terms_state(art, terms, own_meta)
    out = {"terms_state": state, "message": msg, "n_terms": len(terms),
           "terms_source": source,
           "pipeline_version": str((art.get("meta") or {}).get("pipeline_version") or ""),
           "terms_pipeline_version": str(own_meta.get("pipeline_version") or ""),
           "terms_generated_at": str(own_meta.get("generated_at") or ""),
           "terms": []}
    if state != "ok":
        return out
    for t in terms:
        row = {k: t.get(k) for k in _TERMS_FIELDS}
        # 一律给**前端直接可用**的形态：缺字段给空串 / 0 / 空表，前端不必再判空
        for k in ("term", "en", "en_source", "def", "first_kp_id", "first_kp_name"):
            row[k] = str(row.get(k) or "")
        row["kp_ids"] = [str(x) for x in (row.get("kp_ids") or [])]
        for k in ("first_page", "n_occurrences"):
            try:
                row[k] = int(row.get(k) or 0)
            except (TypeError, ValueError):
                row[k] = 0
        if row["term"]:
            out["terms"].append(row)
    out["n_terms"] = len(out["terms"])
    return out


def api_terms(conn, doc_id: int = 0) -> dict:
    """名词解释栏（卡 C-0053；卡 C-0058 起数据源是**独立产物优先**）。

    不带 `doc_id` 列课件清单，带了就给这一份的名词。
    只读产物，**不调模型、不写库**。"没有名词"的几种情形都照旧 HTTP 200 +
    `terms_state` + 一句人话（`message`）——前端据此给空态，不是报错。
    """
    if doc_id <= 0:
        items = []
        for d in _artifact_doc_list(conn):
            try:
                did = int(d["doc_id"])
            except (TypeError, ValueError):
                continue
            art = _artifact_load(did)
            pl = _terms_payload(art, did)
            item = dict(d)
            item.update({"n_terms": pl["n_terms"], "terms_state": pl["terms_state"],
                         "terms_source": pl["terms_source"],
                         "pipeline_version": pl["pipeline_version"]})
            items.append(item)
        return {"documents": items, "n": len(items), "data_source": "artifact"}
    try:
        did = int(payload.get("doc_id") or 0)
    except (TypeError, ValueError):
        return {"error": "doc_id 必须是整数"}
    if did <= 0:
        return {"error": "缺少 doc_id"}
    if kp_build_mod.is_running():
        return {"error": "已有一个整理任务在跑；同一时间只允许一个，请等它结束"}
    # 与批量整理（卡 C-0038）互斥：两边可能落到**同一份产物**上，
    # 同时写会把对方的条目覆盖掉。哪边先起，哪边占坑。
    if kp_batch_mod.is_running():
        return {"error": "有一个批量整理任务在跑；等它结束（或取消）后再做单份整理"}
    est = kp_build_mod.estimate(did)
    if not est.get("ok"):
        return {"error": est.get("error") or "该文档不可整理"}
    force = bool(payload.get("force"))
    try:
        max_cost = float(payload.get("max_cost") or 0.8)
    except (TypeError, ValueError):
        max_cost = 0.8

    out = Path(est["out_path"])
    prev = kp_build_mod.prev_info(did)
    # 覆盖保护：会被整份重写时才备份（旧版产物续不了跑、或人显式勾了"重新生成"）。
    # 本版产物且能续跑 → 不备份（续跑本来就不会丢已有条目）。
    backup = ""
    if prev["exists"] and (force or not prev["resumable"]):
        bak = out.with_name(out.name + ".bak-" + time.strftime("%Y%m%d-%H%M%S"))
        try:
            shutil.copy2(out, bak)
            backup = str(bak)
        except OSError as e:
            return {"error": f"备份旧产物失败，为不覆盖它已中止：{e}"}

    rep = kp_build_mod.start_background(did, max_cost=max_cost, force=force,
                                        out_path=str(out))
    if not rep.get("started"):
        return {"error": rep.get("error") or "启动失败"}
    return {
        "started": True,
        "doc_id": did,
        "title": est.get("title") or "",
                parts.append((p.name, st.st_mtime_ns, st.st_size))
        except OSError:
            continue
    return tuple(parts)


def api_kp_build_options(conn) -> dict:
    """可整理的课件清单 + **预估**（条数与成本），只读，不调模型。

    预估口径与 CLI `--dry-run` 完全一样（都来自 `kp_build.estimate()`）：
    `kp_min`~`kp_max` 是"全合并"到"不合并"的区间，`est_cost_cny` 是**上界**
    （按每页一条算）。真实花费只会更少——合并掉的页不会单独产生一次调用。
    """
    global _KP_OPT_CACHE
    sig = _kp_options_sig()
    now = time.time()
    if (_KP_OPT_CACHE["sig"] == sig and _KP_OPT_CACHE["data"] is not None
            and now - _KP_OPT_CACHE["t"] < _KP_OPT_TTL):
        data = dict(_KP_OPT_CACHE["data"])
        data["cached"] = True
        data["running"] = kp_build_mod.is_running()
        return data

    docs = {r["id"]: dict(r) for r in conn.execute(
        "SELECT id, title, kind, corpus, n_chunks FROM documents").fetchall()}
    items = []
    for p in sorted(_outline_dir().glob("*.json")):
        if not p.stem.isdigit():
            continue
        did = int(p.stem)
        try:
            est = kp_build_mod.estimate(did, outline_path=p)
        except Exception as e:  # noqa: BLE001
            items.append({"doc_id": did, "title": f"文档 {did}", "ok": False,
                          "error": f"{type(e).__name__}: {e}"})
            continue
        if not est.get("ok"):
            continue
        prev = kp_build_mod.prev_info(did)
        d = docs.get(did) or {}
        # 「跳过已完成」的判定**只有一处实现**（`kp_batch.done_state`）：
        # 看板只负责把它显示出来，判定规则不许在这里再抄一遍（抄了就会漂）。
        ok_done, done_note = kp_batch_mod.done_state(
            {"n_pages": est["n_pages"], "n_leaf_pages": est["n_leaf_pages"]}, prev)
        items.append({
