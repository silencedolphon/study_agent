# 人要求：「在"知识点"页签添加批量整理知识点的功能：可选择知识库中的多个课件整理知识点。
# 同样尝试多个管线同时跑以提高整理效率」。
# ---------------- 预习总结（卡 C-0094：**独立管线**，默认关闭） ----------------
#
# 人的原话（2026-10-14）：「增加一个预习模块，选择章节后将那一章节拆成更加细的知识点……
# 之后再开一个新的大模型对该章节做预习总结……该功能默认关闭，有选项可以打开。」
#
# 与「整理知识点」的关系：**两条完全独立的管线**（模型/密钥/强度各一份），
# 但两者都会长期占用模型调用，所以**互斥**（哪边先起，哪边占坑）。
#
# ⚠ 三个接口都**不进 `_lock`**：预习是后台线程跑的，进锁会把整个看板（含进度轮询）
#   一起堵死——入库/整理那条路早就踩过这个坑（见 do_GET 里进度必须在锁前的注释）。
# ⚠ 写库禁止：只写 `logs/knowledge/<doc_id>-预习总结.json`，五张表仍然一行都不碰。
def api_preview_options(conn, doc_id: int = 0) -> dict:
    """预习面板的清单：可预习的资料 + 选中资料的**章**（每章带节数与产物状态）。

    只读、**零模型调用**。章节来自 `chunks.heading_path`（入库结构），
    节数来自卡 C-0092 的《章节细目》正则产物。
    """
    rows = conn.execute("SELECT id, title, kind, corpus, n_chunks FROM documents "
                        "ORDER BY id").fetchall()
    docs = [{"doc_id": int(r["id"]), "title": r["title"] or ("文档 %d" % int(r["id"])),
             "kind": r["kind"] or "", "corpus": r["corpus"] or "",
             "n_chunks": int(r["n_chunks"] or 0)} for r in rows]
    st = preview_mod.enabled_state()
    out: dict = {
        "enabled": st["enabled"], "switch": st["switch"], "hint": st["hint"],
        "running": preview_mod.is_running(),
        "progress": preview_mod.progress_snapshot(),
        "model": preview_mod.model_name(), "thinking": preview_mod.thinking_on(),
        "reasoning_effort": preview_mod.effort(),
        "suffix": preview_mod.PREVIEW_SUFFIX,
        "preview_version": preview_mod.PREVIEW_VERSION,
        "docs": docs, "doc_id": int(doc_id or 0), "chapters": [],
        "est_calls_per_chapter": 1,
        "cost_rule": "**整章 1 次调用**；节级细拆走卡 C-0092 的正则产物（0 次调用）",
        "sections_artifact": {}, "prev": {},
    }
    if int(doc_id or 0) <= 0:
        return out
    rep = preview_mod.list_chapters(int(doc_id))
    if not rep.get("ok"):
        out["error"] = rep.get("error") or "列不出章节"
        return out
    prev = preview_mod.prev_info_preview(int(doc_id))
    out.update({
        "title": rep.get("title") or "", "book": rep.get("book") or "",
        "n_chapters": rep.get("n_chapters") or 0,
        "chapters": rep.get("chapters") or [],
        "chapter_source": rep.get("chapter_source") or "",
        "sections_artifact": rep.get("sections_artifact") or {},
        "prev": prev,
        "out_path": prev.get("path") or "",
        # 产物**按 doc_id 命名**（卡面口径）：同一份资料同时只保留**最近一章**，
        # 换章时管线会自动把上一章备份成 `.bak-<时间戳>`（`meta.prev_backup`）。
        "artifact_note": ("产物固定为 <logs/knowledge>/%d%s ——同一份资料的预习总结"
                          "**一次只保留最近一章**；换章预习时上一章会自动备份成 "
                          "`.bak-<时间戳>`（旧产物不会丢）。"
                          % (int(doc_id), preview_mod.PREVIEW_SUFFIX)),
    })
    if prev.get("exists"):
        for c in out["chapters"]:
            c["has_preview"] = (int(c.get("no") or 0) == int(prev.get("chapter_no") or 0))
    return out


