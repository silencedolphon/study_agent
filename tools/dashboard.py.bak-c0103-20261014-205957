async function docDelGo(ids, withFile){
  if (DS.busy) return;
  const what = withFile
    ? `⚠ 不可逆：这 ${ids.length} 份资料的 raw\\ 原文件、切块与向量、知识点出处、\n` +
      `整理产物（含备份）都会被永久删除，无法撤销。`
    : `这 ${ids.length} 份资料会从库里消失（切块、向量、知识点出处、整理产物一并删掉），\n` +
      `但 raw\\ 里的原文件保留，之后还能重新入库。`;
  const ok = window.confirm(
    `批量删除 ${ids.length} 份资料：${ids.join(', ')}\n\n` + what + '\n\n确定继续？');
  if (!ok) return;
  closeModal();
  DS.busy = true;
  const btn = $('#ds-del');
  if (btn){ btn.disabled = true; btn.textContent = '删除中…'; }
  try {
    const r = await api('/api/docs/delete', {method:'POST',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify({doc_ids: ids, delete_file: withFile,
                            purge_orphans: true, confirm: true})});
    if (r.need_confirm) return toast('后端要求二次确认（未删除任何东西）');
    if (r.error) return toast('删除被拒绝：' + r.error);
    const g = r.purged || {};
    let msg = `已删除 ${r.n_deleted} 份（${r.chunks_removed || 0} 块、`
            + `${r.artifacts_n || 0} 个产物文件`;
    if (r.files_removed) msg += `、${r.files_removed} 个原文件`;
    if (g.deleted_kps) msg += `，清理 ${g.deleted_kps} 个孤儿知识点`;
    msg += '）';
    if ((r.not_in_library || []).length) msg += `；${r.not_in_library.length} 份本来就不在库（只清了产物）`;
    if ((r.artifact_errors || []).length) msg += `；${r.artifact_errors.length} 个产物文件删除失败（见日志）`;
    toast(msg);
    if ((r.artifact_errors || []).length) console.warn('批量删除产物失败明细', r.artifact_errors);
    go('docs');
  } catch(e){
    toast('删除失败：' + e.message);
  } finally {
    DS.busy = false;
    const b2 = $('#ds-del');
    if (b2){ b2.disabled = false; b2.textContent = '批量删除选中…'; }
  }
}

