# JSON（知识点 + 每条的块原文），本看板**只读消费**——不入库、不写文件、
# 不碰数据库。将来正式入库（`knowledge_points` / `kp_sources`）是另一件事，
# 设计见 `cards/C-0028/知识点构建方案（三级粒度）.md` §5。
#
# ⚠ 它和 `/api/kp`（库内知识点的增删改查，走数据库那套）**完全不是一回事**，
#   所以新接口刻意叫 `/api/mindmap/kp`，不跟既有路径撞名。
_KNOWLEDGE_DIR_ENV = "KB_KNOWLEDGE_DIR"
_KNOWLEDGE_LOCK = threading.Lock()
# 进程内缓存：{目录签名: {doc_id: {...}}}。签名里带 mtime+size，文件一改就重解析。
# 只留最近几份：正常使用目录是固定的，留多份只是为了环境变量来回切时不至于每次重读。
_KNOWLEDGE_CACHE: dict = {}
_KNOWLEDGE_CACHE_MAX = 4


def _knowledge_dir() -> Path:
    """知识点 JSON 所在目录；`KB_KNOWLEDGE_DIR` 可覆盖（与 KB_RAW/KB_NOTES 同一惯例）。

    ⚠ 卡 C-0039：兜底值取 `config.LOG_DIR`（切库会变），且**切库时会把
    `KB_KNOWLEDGE_DIR` 一起清掉**（见 `core/subjects._bind`）——那个环境变量是
    "全局单库"时代的覆盖开关，留着它会让新学科的知识点写到固定目录里去。
    """
    """
    return Path(os.environ.get(
        _KNOWLEDGE_DIR_ENV,
        str(Path(config.LOG_DIR) / "knowledge"))).expanduser()


def _kp_load_dir() -> dict:
    """扫知识点目录，建 {doc_id: {"meta":…, "by_id":…, "by_name":…, "source":…}}。

    **静默降级**（照 `_read_outline()` 的容错风格）：目录不在、文件坏、字段缺，
    一律当作"没有知识点"返回 {}。知识点是锦上添花，绝不能因为它坏了让导图、
    整个 /api/mindmap 打不出图——那才是真的坏。

    `by_name` 的值是**列表**：同名可能有多条（跨父级），挂载时只有唯一命中才挂。
    """
    d = _knowledge_dir()
    try:
        files = sorted(p for p in d.glob("*.json") if p.is_file())
    except OSError:
        return {}
    sig_parts = []
    for p in files:
        try:
            st = p.stat()
        except OSError:
            continue
        sig_parts.append((p.name, st.st_mtime_ns, st.st_size))
    sig = (str(d), tuple(sig_parts))
    with _KNOWLEDGE_LOCK:
        hit = _KNOWLEDGE_CACHE.get(sig)
    if hit is not None:
        return hit

    out: dict[int, dict] = {}
    for p in files:
        try:
            raw = json.loads(p.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            continue
        if not isinstance(raw, dict):
            continue
        kps = raw.get("knowledge_points")
        if not isinstance(kps, list):
            continue
        meta = raw.get("meta") if isinstance(raw.get("meta"), dict) else {}
        main_id = (meta.get("main_doc") or {}).get("id") if isinstance(
            meta.get("main_doc"), dict) else None
        for kp in kps:
            if not isinstance(kp, dict):
                continue
            kid = str(kp.get("id") or "").strip()
            if not kid:
                continue
            try:
                did = int(kp.get("doc_id"))
            except (TypeError, ValueError):
                try:
                    did = int(main_id)
                except (TypeError, ValueError):
                except (TypeError, ValueError):
                    did = 0
            if did <= 0:
                continue
            doc = out.setdefault(did, {"meta": meta, "source": p.name,
                                       "by_id": {}, "by_name": {}})
            doc["by_id"][kid] = kp
            nm = str(kp.get("name") or "").strip()
            if nm:
                doc["by_name"].setdefault(nm, []).append(kp)

    with _KNOWLEDGE_LOCK:
        if len(_KNOWLEDGE_CACHE) >= _KNOWLEDGE_CACHE_MAX:
            _KNOWLEDGE_CACHE.clear()
        _KNOWLEDGE_CACHE[sig] = out
    return out


def _kp_index(doc_id: int) -> dict:
    """某文档的知识点索引；没有就是 {}（调用方按"没有知识点"处理）。"""
    try:
        return _kp_load_dir().get(int(doc_id)) or {}
    except (TypeError, ValueError):
        return {}


