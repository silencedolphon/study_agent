def api_share_estimate(payload: dict) -> dict:
    """导出前的体积预估（**只读**，一个字节都不写）。

    为什么需要：勾上「带原课件」「带识图页图」能让包从 1 MB 涨到几十 MB，
    用户在按下导出之前就该看到代价。口径是**未压缩字节**，再按 deflate 的
    经验压缩比给一个区间——**不假装精确**：文本 jsonl 能压到两三成，
    png 与原课件基本压不动，所以区间给得宽，并如实标注是预估。
    """
    doc_id = int(payload.get("doc_id") or 0)
    try:
        tgt = _share_target("")
    except subjects_mod.SubjectError as e:
        return {"error": str(e)}
    if not Path(tgt["db_path"]).is_file():
        return {"error": "当前库还没有建好（%s 不存在）" % tgt["db_path"]}
    conn = db.connect(tgt["db_path"])
    try:
        doc = conn.execute("SELECT * FROM documents WHERE id=?", (doc_id,)).fetchone()
        if doc is None:
            return {"error": "库里没有 id=%d 的课件（可能已被移除）" % doc_id}
        row = dict(doc)
        n_chunk = conn.execute(
            "SELECT COUNT(*) n, COALESCE(SUM(LENGTH(CAST(text AS BLOB))),0) b"
            " FROM chunks WHERE doc_id=?", (doc_id,)).fetchone()
        n_emb = conn.execute(
            "SELECT COUNT(*) n, COALESCE(SUM(LENGTH(e.vec)),0) b FROM chunks c "
            "JOIN embeddings e ON e.chunk_id=c.id WHERE c.doc_id=?", (doc_id,)).fetchone()
        n_fig = conn.execute(
            "SELECT COUNT(*) n, COALESCE(SUM(LENGTH(COALESCE(description,''))"
            "+LENGTH(COALESCE(thinking,''))),0) b FROM figure_desc WHERE doc_id=?",
            (doc_id,)).fetchone()
    finally:
        conn.close()

    know: list[dict] = []
    for suffix in share_mod.KNOW_SUFFIXES:
        kf = Path(tgt["log_dir"]) / "knowledge" / ("%d%s" % (doc_id, suffix))
        if kf.is_file():
            know.append({"name": kf.name, "bytes": kf.stat().st_size})
    pages = _share_page_files(tgt, row)
    src = _share_source_file(tgt, row)
    orig_b = src.stat().st_size if src is not None else 0
    pages_b = sum(f.stat().st_size for f in pages)
    # 向量以 base64 存进包（`core/share.py::_iter_embedding_lines`），膨胀 4/3
    emb_b64 = (int(n_emb["b"]) + 2) // 3 * 4
    parts = {"chunks": int(n_chunk["b"]), "embeddings": emb_b64,
             "figure_desc": int(n_fig["b"]), "knowledge": sum(k["bytes"] for k in know),
             "original": orig_b, "pages": pages_b}
    comp = (parts["chunks"] + parts["embeddings"] + parts["figure_desc"]
            + parts["knowledge"] + 20 * 1024)

    def est(extra: int) -> list[int]:
        return [int(comp * 0.20) + extra + 4096, int(comp * 0.38) + extra + 16384]

    return {
        "ok": True, "doc_id": doc_id, "title": row.get("title") or row.get("path"),
        "kind": row.get("kind"), "n_chunks": int(n_chunk["n"]),
        "n_embeddings": int(n_emb["n"]), "n_figures": int(n_fig["n"]),
        "n_pages": len(pages), "has_original": src is not None,
        "original_name": src.name if src is not None else "",
        "parts": parts, "knowledge_files": know,
        "raw_base": comp, "raw_with_original": comp + orig_b,
        "raw_with_pages": comp + pages_b, "raw_with_both": comp + orig_b + pages_b,
        "est_base": est(0), "est_with_original": est(orig_b),
        "est_with_pages": est(pages_b), "est_with_both": est(orig_b + pages_b),
        "note": "预估口径：未压缩字节 × deflate 经验压缩比（文本约两三成，"
                "原文件与页图几乎压不动），所以给的是区间",
    }


def api_share_export(payload: dict) -> dict:
    """导出当前库的一份课件为分享包（「按键」→ 落成本机 zip）。

    包默认落在 `share\\`（与 `tools/share.py export` 同一默认值），
    文件名 `\\<标题>-share.zip`：同名重复导出**覆盖**，不与 CLI 抢命名规则。
    """
    doc_id = int(payload.get("doc_id") or 0)
    with_original = bool(payload.get("with_original"))
    with_pages = bool(payload.get("with_pages"))
    note = str(payload.get("note") or "")[:200]
    try:
        tgt = _share_target("")            # 导出按钮只出现在**当前库**的行上
    except subjects_mod.SubjectError as e:
        return {"error": str(e)}
    _share_prog_reset()
    t0 = time.time()
    try:
        with _SHARE_LOCK:
            res = share_mod.export_doc(
                doc_id, None, db_path=tgt["db_path"], log_dir=tgt["log_dir"],
                raw_dir=tgt["raw_dir"], root=tgt["root"],
                with_original=with_original, with_pages=with_pages,
                exported_by=str(payload.get("by") or ""), note=note,
                progress=_share_prog)
    except share_mod.ShareError as e:
        _share_prog_done(str(e))
        return {"error": str(e), "kind": "share",
                "elapsed": round(time.time() - t0, 1)}
    except Exception as e:                  # noqa: BLE001（磁盘满/权限等也要给人话）
        msg = "导出失败：%s: %s" % (type(e).__name__, e)
        _share_prog_done(msg)
        return {"error": msg, "elapsed": round(time.time() - t0, 1)}
    _share_prog_done()
    z = Path(res["zip"])
    return {
        "ok": True, "zip": res["zip"], "dir": str(z.parent), "name": z.name,
        "bytes": int(res["bytes"]), "counts": res["counts"],
        "includes": res["includes"], "embedding": res["embedding"],
        "n_pages": int(res["n_pages"]), "original_bytes": int(res["original_bytes"]),
        "pages_bytes": int(res["pages_bytes"]), "warnings": res["warnings"],
        "elapsed": round(time.time() - t0, 1),
        "cmd": 'python tools\\share.py import --zip "%s"' % res["zip"],
    }


