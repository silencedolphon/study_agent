            for c in ("main", "aux")
        },
        "files": files,
        "orphans": orphans,
        # counts 保持全量（既有消费者口径不变）；子页签的角标必须用
        # counts_by_corpus 里本库的那一份，否则会出现"3 个待入库"但列表 1 个
        # 的错位（方案 §7.4 末尾点名的可见 bug）。
        "counts": _counts(files),
        "counts_by_corpus": {
            c: _counts([f for f in files if f["corpus"] == c])
            for c in ("main", "aux")
        },
    }


def _safe_filename(name: str) -> str:
    """清洗文件名，避免路径穿越与非法字符。"""
    name = Path(name.replace("\\", "/")).name
    name = re.sub(r'[<>:"|?*\x00-\x1f]', "_", name).strip(" .")
    return name or "unnamed"


def _parse_multipart_stream(handler, fields: dict[str, str], dest_resolver
                            ) -> list[dict]:
    """流式解析 multipart/form-data，文件直接落盘，不把整个请求读进内存。

    为什么自己写而不是用标准库：
    - `email` 方案需要先把整个请求体读成 bytes，多文件批量上传会把内存撑爆
      （用户那个 645MB 的目录正是这种情况）。
    - `cgi.FieldStorage` 本来最合适，但 **Python 3.13 已把 cgi 模块整体移除**，
      本机正是 3.13，import 直接失败。

    所以这里按 multipart 的格式逐行读取：文件内容边收边写盘，
    内存占用只与单行长度有关，与文件大小无关。

    dest_resolver 是一个无参函数，返回文件应写入的目录。
    它在**遇到第一个文件时**才被调用——此时排在文件之前的普通字段
    （例如 folder）已经写进 fields 了，所以能拿到正确的目标目录。
        line = read_line()
        if not line:
            raise ValueError("请求体里找不到 multipart 分界")
        if line.rstrip(b"\r\n") == delim:
            break

    while True:
        # ---- 解析这部分的首部 ----
        headers: dict[str, str] = {}
        while True:
            line = read_line()
            if not line:
                return saved
            if line in (b"\r\n", b"\n"):
                break
            if b":" in line:
                k, _, v = line.decode("latin-1").partition(":")
                headers[k.strip().lower()] = v.strip()

        disp = headers.get("content-disposition", "")
        fn = None
        fm = re.search(r'filename="([^"]*)"', disp)
        if fm:
            fn = fm.group(1)
        nm = re.search(r'name="([^"]*)"', disp)
        field_name = nm.group(1) if nm else ""
        # 文件名可能是 UTF-8 的（浏览器会按 RFC 5987 或直接发 UTF-8 字节）
        if fn:
            try:
                fn = fn.encode("latin-1").decode("utf-8")
            except (UnicodeEncodeError, UnicodeDecodeError):
                pass

        if fn is None:
            # ---- 普通字段：整段读出来即可（体积很小） ----
            buf = bytearray()
            while True:
                line = read_line()
                if not line:
                    break
                stripped = line.rstrip(b"\r\n")
                if stripped == delim or stripped == end_mark:
                    break
                buf += line
            fields[field_name] = buf.decode("utf-8", errors="replace").rstrip("\r\n")
            if stripped == end_mark:
                return saved
            continue

        # ---- 文件部分：边收边写盘 ----
        target_dir = dest_resolver()
        target_dir.mkdir(parents=True, exist_ok=True)
        clean = _safe_filename(fn)
        dest = target_dir / clean
        if dest.exists():
            stem, suf = dest.stem, dest.suffix
            for i in range(1, 10000):
                cand = dest_dir / f"{stem}_{i}{suf}"
                if not cand.exists():
                    dest = cand
                    break
            else:
                dest = dest_dir / f"{stem}_{uuid.uuid4().hex[:8]}{suf}"

        written = 0
        with open(dest, "wb") as out:
                dest = target_dir / f"{stem}_{uuid.uuid4().hex[:8]}{suf}"

        written = 0
        with open(dest, "wb") as out:
            prev_pos = 0
            while True:
                line = read_line()
                if not line:
                    break
                stripped = line.rstrip(b"\r\n")
                if stripped == delim or stripped == end_mark:
                    # 回退上一行末尾的换行：那是分界行的一部分，不属于文件内容
                    out.truncate(prev_pos)
                    written = prev_pos
                    break
                prev_pos = out.tell()
                out.write(line)
                written = out.tell()

        saved.append({
            "name": dest.name,
            "rel": _rel_to_raw(dest),
            "size": written,
            "kind": extract.detect_kind(dest),
            "renamed": dest.name != clean,
        })
def api_upload(handler) -> dict:
    """接收浏览器上传，写入 raw/。不自动入库——先让用户确认放进哪里。

    本函数已无 UI 入口（C-0001 移除了资料页的「浏览器上传」入口），
    保留仅为兼容可能的直接调用；如需彻底移除请连路由一并评估。

    注意这只是"小批量"通道。几百 MB 的文件请走 api_import_path。
    """
    # 目录要先确定才能边收边落盘，所以先取 folder 字段。
    # cgi 是按顺序解析的，folder 可能排在文件之后，
    # 这里先落到 raw 根目录下的临时名，收到 folder 后再不会移动——
    # 因此约定前端把 folder 放在文件之前发送。
    length = int(handler.headers.get("Content-Length") or 0)
    if length <= 0:
        raise ValueError("请求体为空")
    if length > MAX_UPLOAD_BYTES:
        raise ValueError(
            f"上传体积过大：{length / 1048576:.0f} MB，HTTP 上传上限 "
            f"{MAX_UPLOAD_BYTES // 1048576} MB。\n"
            f"请改用「从本机路径导入」——看板在本机运行，"
            f"可以直接读取磁盘上的文件夹，没有大小限制。"
        )
    # 目标目录在遇到文件时才解析：那时 folder 字段已经读出来了
    folder_box: dict[str, str] = {}

    def resolve_dir() -> Path:
        sub = _safe_filename(folder_box.get("folder", "") or "")
        if sub in (".", ".."):
            sub = ""
        return Path(config.RAW_DIR) / sub if sub else Path(config.RAW_DIR)
        hit = indexed.get(rel)
        if hit:
            info["doc_id"] = hit["id"]
            info["n_chunks"] = hit["n_chunks"]
            # 用内容哈希判断是否被改过，与 ingest 的判重口径一致
            try:
                same = db.sha256_file(f) == hit["content_hash"]
            except OSError:
                same = False
            info["state"] = "indexed" if same else "changed"
        files.append(info)

    # 反向：库里登记了但文件已不在 raw/ 的（例如被手工移走）
    on_disk = {f["rel"] for f in files}
    orphans = [
        {**v, "rel": k, "corpus": _corpus_of(k)}
        for k, v in indexed.items() if k not in on_disk
    ]
    return {
        "raw_dir": str(raw_root),
        "folders": sorted({str(Path(f["rel"]).parent.as_posix())
                           for f in files if "/" in f["rel"]}),
        # 按库拆开的目录候选：资料页的子页签据此只给出本库的目录，
        # 避免在「题库与笔记」页签里推荐一个会把文件判成主库的目录。
        "folders_by_corpus": {
            c: sorted({str(Path(f["rel"]).parent.as_posix())
                       for f in files if f["corpus"] == c and "/" in f["rel"]})
            for c in ("main", "aux")
        },
        "files": files,
    # 因此约定前端把 folder 放在文件之前发送。
    length = int(handler.headers.get("Content-Length") or 0)
    if length <= 0:
        raise ValueError("请求体为空")
    if length > MAX_UPLOAD_BYTES:
        raise ValueError(
            f"上传体积过大：{length / 1048576:.0f} MB，HTTP 上传上限 "
            f"{MAX_UPLOAD_BYTES // 1048576} MB。\n"
            f"请改用「从本机路径导入」——看板在本机运行，"
            f"可以直接读取磁盘上的文件夹，没有大小限制。"
        )
    # 目标目录在遇到文件时才解析：那时 folder 字段已经读出来了
    folder_box: dict[str, str] = {}

    def resolve_dir() -> Path:
        # 与 api_import_path 的写法**逐字同义**：留空 → 落到 raw\ 根目录。
        #
        # 卡 C-0083 修：这里原来无论填没填都过一遍 `_safe_filename`，而它把
        # 空串变成 "unnamed"（对文件名是合理的兜底，对目录不是）——于是
        # "不填子文件夹"的上传会掉进 `raw\unnamed\`，与「方式一」的位置不一致。
        want = (folder_box.get("folder", "") or "").strip()
        sub = _safe_filename(want) if want else ""
        if sub in (".", ".."):
            sub = ""
        return Path(config.RAW_DIR) / sub if sub else Path(config.RAW_DIR)

    saved = _parse_multipart_stream(handler, folder_box, resolve_dir)
    if not saved:
        raise ValueError("没有收到文件")
    return {"saved": saved, "dir": str(resolve_dir())}


def api_import_path(src: str, sub: str = "", recursive: bool = True,
                    dry_run: bool = False) -> dict:
    """从本机路径导入文件到 raw/。

    这是大文件的正确通道：看板跑在本机，不需要把文件通过 HTTP 传一遍。
    直接读磁盘 -> 拷进 raw/，没有大小限制、不吃内存、也不需要浏览器参与。

    dry_run 只列出将要导入什么，便于先确认。
    """
    if not src or not src.strip():
        raise ValueError("请填写本机路径")
    p = Path(src.strip().strip('"').strip("'"))
    if not p.exists():
        raise ValueError(f"路径不存在: {p}")

    sub_clean = _safe_filename(sub) if sub else ""
    if sub_clean in (".", ".."):
        sub_clean = ""
    dest_dir = Path(config.RAW_DIR) / sub_clean if sub_clean else Path(config.RAW_DIR)

    files: list[Path] = []
    if p.is_file():
        files = [p]
    else:
        it = p.rglob("*") if recursive else p.glob("*")
        files = sorted(f for f in it if f.is_file()
                       and not f.name.startswith(("~$", "."))
                       and f.suffix != ".part")

    planned = []
    total_bytes = 0
    for f in files:
        kind = extract.detect_kind(f)
        try:
            size = f.stat().st_size
        except OSError:
            continue
        total_bytes += size
        planned.append({
            "name": f.name,
            "size": size,
            "kind": kind,
            "supported": kind not in ("unknown", "legacy"),
        })

    if dry_run:
        return {"dry_run": True, "source": str(p), "dest": str(dest_dir),
                "count": len(planned), "total_bytes": total_bytes,
                "files": planned}

    dest_dir.mkdir(parents=True, exist_ok=True)
    copied, skipped, renamed = 0, 0, 0
    errors: list[str] = []
    for f in files:
        try:
            dest = dest_dir / _safe_filename(f.name)
            if dest.exists():
                stem, suf = dest.stem, dest.suffix
                found = None
                for i in range(1, 10000):
                    cand = dest_dir / f"{stem}_{i}{suf}"
                    if not cand.exists():
                        found = cand
                        break
                if found is None:
                    skipped += 1
                    continue
                dest = found
                renamed += 1
            shutil.copy2(str(f), str(dest))
            copied += 1
        except OSError as e:
            errors.append(f"{f.name}: {e}")
    return {
        "source": str(p),
        "dest": str(dest_dir),
        "copied": copied,
        "renamed": renamed,
        "skipped": skipped,
        "errors": errors[:20],
        "total_bytes": total_bytes,
    }


# ---------------- 批量入库（卡 C-0037）----------------
#
# 并发执行器在 `core/pipeline_pool.py`（线程池 + 每任务独立写库连接 + per-task
# 进度表）。这里只做三件事：**预估**（只读，可以占 `_lock`）、**提交**（长跑，
# 不占锁）、**重试失败项**。业务逻辑一行都不重复实现。


def api_ingest_batch_plan(payload: dict, conn) -> dict:
    """批量入库的预估：待处理几份、要识图几页、大概花多少钱。

    只读文件元信息与库里的登记信息，不调模型，所以可以在确认框里实时算一次。
    """
    paths = payload.get("paths") or []
    if not paths:
        return {"error": "没有选择文件"}
    # ★ 防旧逻辑覆盖（卡 C-0089）：教材专线产物**不进并发池**，先摘出去，
    # 保证"确认框里说有 N 份"与"实际提交 N 份"是同一个口径。
    paths, tb_blocked = _drop_textbook_locked_raw(conn, paths)
    if not paths:
        return {"error": _textbook_blocked_msg(tb_blocked),
                "textbook_locked": tb_blocked}
    nf = payload.get("no_figures")
    out = pool_mod.plan_files(
        paths,
        force=bool(payload.get("force")),
        with_figures=(None if nf is None else not bool(nf)),
        workers=payload.get("workers"),
        conn=conn,
    )
    if tb_blocked:
        out["textbook_locked"] = tb_blocked
    return out


def api_ingest_batch_start(payload: dict) -> dict:
    """提交一批入库任务，**立刻返回**（真正跑在后台线程池里）。"""
    # ★ 批量入库**必须**先过代码新鲜度这道闸（卡 C-0040）。
    #
    # 看板是常驻进程、Python 不会重载已导入的模块（见本文件开头 `_CODE_STAMP`
    # 那段说明）。单份入库 `api_ingest` 早就带 `stale_notice()` 提示了，
    # 而批量入口一直没有 —— 于是"看板跑的是旧代码"在**批量路径上是静默的**。
    # 实测代价：卡 C-0040 的修复落在 0:48~2:15，而 8756 看板是 0:30:45 启动的，
                "stale": True}
    paths = payload.get("paths") or []
    if not paths:
        return {"error": "没有选择文件"}
    nf = payload.get("no_figures")
    return pool_mod.submit_batch(
        paths,
        force=bool(payload.get("force")),
        with_ocr=not bool(payload.get("no_ocr")),
        with_figures=(None if nf is None else not bool(nf)),
        workers=payload.get("workers"),
    )


def api_ingest_batch_retry(payload: dict) -> dict:
    """把上一批里失败的几份重新提交为新批次。"""
    notice = stale_notice()          # 同上：重投同样是"跑一整批"
    if notice:
        return {"error": notice + "（重试已拒绝，避免用旧逻辑空跑）",
                "stale": True}
    bid = str(payload.get("batch_id") or "")
    if not bid:
        return {"error": "缺少 batch_id"}
    return pool_mod.retry_failed(bid, workers=payload.get("workers"))


def api_ingest_batch_cancel(payload: dict) -> dict:
    """取消批量入库（卡 C-0041）：未开始的份作废，正在跑的份跑完当前文件。

    与 `/api/kp-build/batch/cancel`（卡 C-0038）**同一个风格**：这里一行业务
    逻辑都不重复实现，直接调执行器的 `cancel()`，语义全在
    `core/pipeline_pool.py::cancel` 里：

      - `pending` → `cancelled`，且不会再启动（`_run_one` 开头还要挡一道）；
      - 正在跑的份**不硬杀**（手里有未提交的写事务与写了一半的文档，
        硬杀只会留半条记录，钱也退不回来），跑完当前这一份再收尾；
      - **幂等**：重复取消、取消不存在的批次都不抛异常（第二次 `cancelled=0`）。

    `batch_id` 可以省略 —— 省略就是"当前批次"（与 `/progress`、`snapshot()`
    同口径）。返回 `{"batch_id","cancelled","pending","running","found",
    "already_cancelled","finished","total","note"}`，前端拿 `cancelled`
    （本次作废的份数）与 `note` 直接提示用户。

    ★ 这个入口**不能占 `_lock`、也不能碰库**：它必须在入库正忙、写锁被 worker
    占着的时候也能立刻进来。否则就回到本卡要修的那个坑——"想停却停不下来"，
    2026-09-22 深夜用户只能杀看板进程来止损。路由里因此与
    `/api/kp-build/batch/cancel` 并列放在写路径之外（见 `do_POST`）。
    """
    return pool_mod.cancel(str(payload.get("batch_id") or "") or None)


def api_ingest(paths: list[str] | None = None, force: bool = False,
               no_ocr: bool = False, no_figures: bool = False,
               db_path: Path | str | None = None) -> dict:
    """把 raw/ 下的文件入库（走 `ingest_paths`，与命令行同一条管线）。

    ⚠ **这是唯一会持续很久的操作，可能远超一次 HTTP 请求的合理时长。**
    两个耗时来源：
    - 嵌入是 CPU 计算（几十个文件几分钟）
    - **整页识图要逐页调视觉模型**，实测约 25 秒/页；
      一份 78 页的 PDF 导出件因此要 30 分钟以上

    所以 `no_figures=True` 是必要逃生口：只想把文字快速入库时关掉识图。
    批量入库仍建议走命令行 `tools/reimport_all.py`——它按资料提交、
    逐份打印进度，中断可续。

    Web 层在锁内串行执行，避免并发写库。
    db_path 只供测试注入，正常调用留空即用配置里的库。
    """
    conn = db.connect(db_path)
    db.init_db(conn)
    try:
        if paths:
            targets = [_safe_raw_path(p) for p in paths]
        else:
            targets = [Path(config.RAW_DIR)]
        missing = [str(t) for t in targets if not t.exists()]
        if missing:
            return {"error": f"路径不存在: {missing}"}
        rep = ingest_mod.ingest_paths(conn, targets, force=force,
                                      with_ocr=not no_ocr, verbose=False,
                                      with_figures=not no_figures)
        notice = stale_notice()
        summary = rep.summary()
        if notice:
            summary = f"{notice}\n{summary}"
        return {
            "summary": summary,
            "stale": bool(notice),
            "added": rep.added, "updated": rep.updated, "skipped": rep.skipped,
            "failed": rep.failed, "needs_ocr": rep.needs_ocr,
            "unsupported": rep.unsupported, "chunks": rep.chunks,
            "details": [d for d in rep.details if d["status"] != "skipped"][:50],
        }
def api_ingest(paths: list[str] | None = None, force: bool = False,
